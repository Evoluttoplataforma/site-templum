# Cloudflare — headers de cache e segurança.
# (Sem CSP restritiva: o tracking-kit carrega scripts externos.)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Assets com hash no nome → cache longo e imutável
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Assets da página-experiência /os/ (imagens e vídeos gerados). Nome estável e
# conteúdo que não muda → cache imutável. A regra /assets/* acima NÃO cobre
# /os/assets/*: o casamento do _headers é por prefixo de caminho.
/os/assets/*
  Cache-Control: public, max-age=31536000, immutable
