---
// LP da atualização SASSMAQ 4.0.
// A página /consultoria/sassmaq/ e a LP de campanha sassmaq-lp permanecem como estão.
import LpBase from "../../layouts/LpBase.astro";
import Testimonials from "../../components/Testimonials.astro";
import DepoimentosTexto from "../../components/DepoimentosTexto.astro";
import ClientLogos from "../../components/ClientLogos.astro";
import LeadForm from "../../components/LeadForm.astro";
import { normas } from "../../data/normas.js";
import d from "../../data/consultoria/sassmaq.js";

const slug = "sassmaq";
const norma = normas.find((n) => n.slug === slug) || {};
const c = norma.color || "var(--orange)";
const heroGarantia = d.hero.garantia || d.garantiaPadrao;
const formTitulo = "Descubra se sua transportadora está preparada para a SASSMAQ 4.0";
const formSub = "Solicite um diagnóstico com um especialista da Templum e entenda os principais gaps que sua empresa precisa resolver para se adequar às novas exigências.";
const formCta = "Quero meu diagnóstico SASSMAQ 4.0";
const ctaCurto = "Quero meu diagnóstico";
const oferta = [
  "Entenda quais mudanças impactam sua operação",
  "Identifique os principais gaps",
  "Saiba como estruturar sua adequação",
  "Tire suas dúvidas com um especialista",
];

const mudancas = [
  { icon: "solar:planet-bold", t: "ESG", d: "Critérios mais claros de avaliação." },
  { icon: "solar:shield-warning-bold", t: "Segurança de processo", d: "Mais atenção aos controles que evitam acidentes na operação." },
  { icon: "solar:lock-keyhole-bold", t: "Proteção patrimonial", d: "Reforço dos controles de proteção patrimonial." },
  { icon: "solar:users-group-rounded-bold", t: "Terceiros e agregados", d: "Novos critérios para terceiros e transportadores agregados." },
  { icon: "solar:map-point-bold", t: "Auditorias presenciais", d: "Auditorias presenciais passam a fazer parte da avaliação." },
  { icon: "solar:calendar-bold", t: "Ciclo trienal", d: "Novo ciclo de três anos, com auditorias de manutenção." },
  { icon: "solar:document-text-bold", t: "Questionário rodoviário", d: "Aproximadamente 576 questões no modal rodoviário." },
  { icon: "solar:verified-check-bold", t: "Evidências", d: "Mais rigor na comprovação de licenças, controles e evidências." },
];

const faq = [
  { q: "Quando a SASSMAQ 4.0 entra em vigor?", a: "A 4ª edição foi lançada em setembro de 2026. O período de transição vai até 11 de março de 2027. A partir de 12 de março de 2027, novas certificações, manutenções e extensões de escopo deverão seguir a SASSMAQ 4.0." },
  { q: "O que mudou na 4ª edição?", a: "A nova edição vai além de uma atualização de documentos. Entre as mudanças estão critérios mais claros de ESG, mais atenção à segurança de processo, reforço da proteção patrimonial, novos critérios para terceiros e transportadores agregados, auditorias presenciais, ciclo trienal com auditorias de manutenção, aproximadamente 576 questões no questionário do modal rodoviário e mais rigor na comprovação de licenças, controles e evidências." },
  { q: "Empresas que já têm SASSMAQ precisam se adequar?", a: "Sim. Manutenções e extensões de escopo a partir de 12 de março de 2027 seguem a 4ª edição. Esperar a auditoria se aproximar reduz o tempo para corrigir processos, reunir evidências e adequar a operação." },
  { q: "A Templum atende quem busca a primeira certificação?", a: "Sim. O acompanhamento vale para a primeira certificação e para quem já é certificado e precisa se preparar para a próxima auditoria." },
  { q: "Quem deve implementar o SASSMAQ?", a: "Transportadoras, operadores logísticos, frotas, armazenagem e empresas que movimentam produtos químicos, a granel ou fracionados." },
  { q: "O SASSMAQ é obrigatório?", a: "É exigido por grande parte das indústrias químicas para contratar transportadores. Na prática, é um passaporte para o setor." },
  { q: "Como a Templum conduz a adequação?", a: "Avaliamos os requisitos aplicáveis, identificamos os gaps e estruturamos um plano de implementação claro. Especialistas conduzem a adequação e o Templum OS organiza a jornada da operação até a auditoria." },
  { q: "A certificação tem garantia?", a: "Ao concluir todas as etapas da consultoria e ainda assim não obter a certificação, devolvemos 200% do valor investido. A condição está em contrato." },
];

const SITE = (Astro.site?.href || "https://templum.com.br/").replace(/\/$/, "");
const pageSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Consultoria SASSMAQ 4.0",
    serviceType: "Adequação à 4ª edição do SASSMAQ",
    description: "Consultoria para transportadoras e operadores logísticos se prepararem para a SASSMAQ 4.0, com especialistas e o Templum OS.",
    category: norma.categoria,
    provider: { "@id": `${SITE}/#organization` },
    areaServed: { "@type": "Country", name: "Brasil" },
    url: `${SITE}/consultoria/sassmaq-4-0`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Certificações", item: `${SITE}/consultoria` },
      { "@type": "ListItem", position: 3, name: "SASSMAQ 4.0", item: `${SITE}/consultoria/sassmaq-4-0` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<LpBase
  title="Sua transportadora está preparada para a certificação SASSMAQ 4.0?"
  description="Consultoria para identificar os gaps, adequar a operação e chegar à auditoria. A transição da SASSMAQ 4.0 vai até 11 de março de 2027."
  noindex={false}
  formAnchor="#form"
  headerAnchorDesktop="#contato"
  headerCta={ctaCurto}
  schemas={pageSchemas}
>
  <div class="cs-page" style={`--accent:${c}`}>
    <section class="cs-hero">
      <div class="cs-hero-bg" aria-hidden="true"></div>
      <div class="container xl cs-hero-grid">
        <div class="cs-hero-text">
          <span class="tag-pill tag-pill--glow">SASSMAQ 4.0</span>
          <h1 class="cs-title">Sua transportadora está preparada para a certificação <span class="cs-hl">SASSMAQ 4.0</span>?</h1>
          <p class="cs-sub">Consultoria para identificar os gaps, adequar a operação e chegar à auditoria com especialistas. A transição vai até 11 de março de 2027.</p>
          <a href="#form" class="btn btn--primary btn--block cs-hero-cta">{ctaCurto} <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          <a href="#mudancas" class="cs-ver-metodo">Ver o que mudou <iconify-icon icon="solar:arrow-down-linear"></iconify-icon></a>
        </div>
        <div class="cs-hero-form" id="form">
          <LeadForm norma={norma.nome} titulo={formTitulo} sub={formSub} cta={formCta} obrigado="/consultoria/sassmaq-obrigado" />
        </div>
      </div>
    </section>

    <section id="prazo" class="section">
      <div class="container xl">
        <div class="section-header">
          <span class="tag-pill">Prazo de transição</span>
          <h2>O prazo de transição já está <em class="accent">correndo</em></h2>
          <p>A SASSMAQ 4.0 foi lançada em setembro de 2026 e o período de transição vai até 11 de março de 2027.</p>
        </div>
        <div class="cs-dates">
          <article class="cs-date">
            <span class="cs-date-k">Lançamento</span>
            <strong>Setembro de 2026</strong>
            <p>Publicação da 4ª edição.</p>
          </article>
          <article class="cs-date">
            <span class="cs-date-k">Transição</span>
            <strong>Até 11 de março de 2027</strong>
            <p>Janela para adequar processos, evidências e a operação.</p>
          </article>
          <article class="cs-date cs-date--mark">
            <span class="cs-date-k">Nova regra</span>
            <strong>A partir de 12 de março de 2027</strong>
            <p>Novas certificações, manutenções e extensões de escopo seguem a 4ª edição.</p>
          </article>
        </div>
        <p class="cs-prazo-note">Esperar a auditoria se aproximar pode deixar pouco tempo para corrigir processos, reunir evidências e adequar a operação.</p>
        <a href="#form" class="btn btn--primary btn--lg">{ctaCurto} <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
      </div>
    </section>

    <section id="mudancas" class="section section--cream">
      <div class="container xl">
        <div class="section-header">
          <span class="tag-pill">4ª edição</span>
          <h2>O que mudou com a <em class="accent">SASSMAQ&nbsp;4.0</em>?</h2>
          <p>A nova edição vai além de uma atualização de documentos.</p>
        </div>
        <div class="cs-mudancas">
          {mudancas.map((m) => (
            <article class="cs-mudanca reveal">
              <span class="cs-mudanca-ico"><iconify-icon icon={m.icon}></iconify-icon></span>
              <h3>{m.t}</h3>
              <p>{m.d}</p>
            </article>
          ))}
        </div>
        <p class="cs-mudancas-close">Sua empresa precisa saber exatamente o que já atende e o que ainda precisa adequar.</p>
      </div>
    </section>

    <section id="diagnostico" class="section">
      <div class="container md cs-oferta">
        <span class="tag-pill">Diagnóstico</span>
        <h2>{formTitulo}</h2>
        <p>{formSub}</p>
        <ul class="check-list cs-oferta-list">
          {oferta.map((item) => (
            <li class="check-item"><span class="check-circle"><iconify-icon icon="solar:check-read-linear"></iconify-icon></span>{item}</li>
          ))}
        </ul>
        <a href="#form" class="btn btn--primary btn--lg">{ctaCurto} <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
      </div>
    </section>

    <section id="jeito" class="section section--cream cs-nova">
      <div class="container xl">
        <div class="section-header">
          <span class="tag-pill">Como a Templum resolve</span>
          <h2>Especialistas e o Templum OS na adequação da <em class="accent">SASSMAQ</em></h2>
          <p>Especialistas experientes. Templum OS. Uma central de inteligência trabalhando junto com sua transportadora.</p>
        </div>
        <p class="cs-nova-lead">Na Templum, sua transportadora não recebe apenas a orientação de um consultor. Você conta com <strong>especialistas conduzindo a adequação à SASSMAQ</strong> e com o <strong>Templum OS organizando e orientando a jornada da operação</strong>, com inteligência para ajudar a equipe a avançar em cada etapa: frota, motoristas, terceiros e evidências.</p>
        <img
          class="cs-nova-img"
          src="/assets/img/templum-os-notebook.webp"
          alt="Templum OS no notebook e no celular, a central que organiza a jornada da consultoria"
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <p class="cs-nova-compare-lead">Não é apenas consultoria. É uma nova forma de preparar a transportadora para a SASSMAQ.</p>
        <div class="cs-nova-table-wrap">
          <table class="cs-nova-table">
            <thead>
              <tr>
                <th scope="col">Jeito tradicional</th>
                <th scope="col">Com a Templum</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Orientações concentradas no consultor</td>
                <td>Especialistas e o Templum OS acompanhando a adequação da operação</td>
              </tr>
              <tr>
                <td>Requisitos, evidências e checklists espalhados em planilhas, pastas e reuniões</td>
                <td>Uma central de inteligência que organiza a jornada e mostra o que a equipe precisa fazer</td>
              </tr>
              <tr>
                <td>A operação precisa transformar a orientação em execução sozinha</td>
                <td>Agentes especializados ajudam a estruturar controles, evidências e o plano até a auditoria</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="cs-nova-close">Menos tempo procurando como atender cada requisito. Mais clareza para adequar a operação antes da auditoria.</p>
        <a href="#form" class="btn btn--primary btn--lg">{ctaCurto} <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
      </div>
    </section>

    <section class="section">
      <div class="container xl">
        <div class="split">
          <div class="split-text">
            <span class="tag-pill">Garantia de 200%</span>
            <h2 class="h1">Certificação ou o <em class="accent">dobro</em> do dinheiro de volta</h2>
            <p class="paragraph">{heroGarantia}</p>
            <a href="#contato" class="btn btn--primary btn--lg">{ctaCurto} <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
          </div>
          <div class="split-img reveal"><img src="/assets/img/garantia-200.webp" alt="Selo de garantia de 200% da Templum" width="640" height="658" loading="lazy" decoding="async" /></div>
        </div>
      </div>
    </section>

    <section class="section section--cream">
      <div class="container xl">
        <div class="section-header"><span class="tag-pill">Empresas fortalecidas pela Templum</span><h2>Resultados que <em class="accent">comprovam</em></h2></div>
        <div class="numbers-grid cs-stats">
          {d.stats.map((s) => <div class="number-card reveal"><div class="value"><em>{s.num}</em></div><div class="label">{s.label}</div></div>)}
        </div>
      </div>
    </section>

    <ClientLogos dark={true} titulo="Empresas que certificaram a SASSMAQ com a Templum" />

    <Testimonials nota="4,9" ctaTexto={ctaCurto} ctaHref="#contato" />

    <DepoimentosTexto />

    <section class="section section--cream">
      <div class="container md">
        <div class="section-header"><span class="tag-pill">Tire suas dúvidas</span><h2>A SASSMAQ 4.0 em detalhes</h2><p>Prazos, mudanças e como a adequação acontece na operação.</p></div>
        <div class="faq-list">
          {faq.map((f) => <details class="faq-item"><summary class="faq-question">{f.q}<span class="faq-arrow">+</span></summary><div class="faq-answer">{f.a}</div></details>)}
        </div>
      </div>
    </section>

    <section id="contato" class="cs-form section--navy">
      <div class="container lg cs-form-grid">
        <div class="cs-form-pitch">
          <span class="tag-pill tag-pill--glow">Diagnóstico</span>
          <h2>Descubra se sua transportadora está preparada para a <em class="accent">SASSMAQ 4.0</em></h2>
          <p>{formSub}</p>
          <ul class="check-list">
            {oferta.map((item) => (
              <li class="check-item"><span class="check-circle"><iconify-icon icon="solar:check-read-linear"></iconify-icon></span>{item}</li>
            ))}
          </ul>
        </div>
        <LeadForm norma={norma.nome} titulo={formTitulo} sub={formSub} cta={formCta} obrigado="/consultoria/sassmaq-obrigado" />
      </div>
    </section>
  </div>
</LpBase>

<style>
  .cs-page { --accent-lt: color-mix(in srgb, var(--accent) 58%, #ffffff); }

  .cs-page .cs-cover,
  .cs-page .cs-form,
  .cs-page .cs-gaps,
  .cs-page .section--navy { background: color-mix(in srgb, var(--accent) 22%, #0f1216); }
  .cs-page .cs-hero { background: linear-gradient(120deg, color-mix(in srgb, var(--accent) 42%, #0c0e12) 0%, color-mix(in srgb, var(--accent) 20%, #0c0e12) 48%, #0c0e12 100%); }

  .cs-page .section:not(.section--navy) .accent { color: var(--accent); font-style: italic; }
  .cs-page .section:not(.section--navy) .tag-pill { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .cs-page .section:not(.section--navy) .number-card .value em { color: var(--accent); }
  .cs-page .section:not(.section--navy) .step-card .step-num { background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }
  .cs-page .section:not(.section--navy) .check-circle { background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }
  .cs-page .section:not(.section--navy) .faq-question:hover { color: var(--accent); }
  .cs-page .section:not(.section--navy) .faq-item[open] .faq-question .faq-arrow { color: var(--accent); }
  .cs-page .section:not(.section--navy) .cs-pq-item iconify-icon { color: var(--accent); }

  .cs-hero { position: relative; background: var(--navy); color: var(--cream); overflow: hidden; padding: clamp(48px, 6vw, 80px) 0; }
  .cs-hero-bg { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(720px 460px at 12% 0%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 60%), radial-gradient(560px 380px at 100% 100%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%); }
  .cs-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .cs-hero-text { max-width: 640px; }
  .cs-hero .tag-pill { margin-bottom: 20px; }
  .cs-title { font-size: clamp(30px, 3.8vw, 48px); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; color: var(--cream); text-wrap: balance; }
  .cs-hl { color: var(--accent-lt); }
  .cs-sub { font-size: clamp(17px, 1.8vw, 20px); font-weight: 500; color: rgba(255,244,221,0.92); margin-top: 18px; max-width: 560px; line-height: 1.45; }
  .cs-hero-note { font-size: 15.5px; color: rgba(255,244,221,0.72); margin-top: 14px; max-width: 540px; line-height: 1.55; }
  .cs-guarantee { display: flex; align-items: flex-start; gap: 9px; margin-top: 16px; font-size: 13.5px; color: rgba(255,244,221,0.62); max-width: 540px; line-height: 1.5; }
  .cs-guarantee iconify-icon { color: var(--accent-lt); font-size: 19px; flex-shrink: 0; margin-top: 1px; }
  .cs-chips { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 22px; padding-top: 18px; border-top: 1px solid rgba(255,244,221,0.14); }
  .cs-chip { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: rgba(255,244,221,0.82); }
  .cs-chip iconify-icon { color: var(--accent-lt); font-size: 18px; }
  .cs-hero-form { align-self: start; scroll-margin-top: 80px; }
  .cs-hero-cta { display: none; }
  .cs-ver-metodo { display: inline-flex; align-items: center; gap: 7px; margin-top: 22px; font-size: 14px; font-weight: 600; color: rgba(255,244,221,0.55); text-decoration: none; transition: color .2s; }
  .cs-ver-metodo:hover { color: var(--accent-lt); }

  .cs-oferta { text-align: center; }
  .cs-oferta h2 { font-size: clamp(28px, 3.4vw, 42px); font-weight: 800; letter-spacing: -0.025em; line-height: 1.15; text-wrap: balance; margin: 14px 0 16px; }
  .cs-oferta > p { max-width: 680px; margin: 0 auto 22px; font-size: 17px; line-height: 1.6; color: var(--text-mid); }
  .cs-oferta-list { max-width: 560px; margin: 0 auto 28px; text-align: left; }

  .cs-dates { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 8px; text-align: left; }
  .cs-date { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-20); padding: 26px 24px; }
  .cs-date--mark { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--surface)); }
  .cs-date-k { display: block; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
  .cs-date strong { display: block; font-size: 20px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.25; margin-bottom: 8px; }
  .cs-date p { font-size: 14.5px; color: var(--text-mid); line-height: 1.5; }
  .cs-prazo-note { max-width: 720px; margin: 28px auto 22px; font-size: 17px; line-height: 1.55; color: var(--text-mid); }
  #prazo { text-align: center; }
  #prazo .section-header { margin-bottom: 28px; }

  .cs-mudancas { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; text-align: left; }
  .cs-mudanca { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-20); padding: 22px 20px; }
  .cs-mudanca-ico { width: 48px; height: 48px; border-radius: var(--r-12); display: grid; place-items: center; font-size: 24px; color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); margin-bottom: 14px; }
  .cs-mudanca h3 { font-size: 16px; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 6px; }
  .cs-mudanca p { font-size: 14px; color: var(--text-mid); line-height: 1.5; }
  .cs-mudancas-close { max-width: 640px; margin: 28px auto 0; font-size: 18px; font-weight: 700; line-height: 1.45; text-wrap: balance; }
  #mudancas { text-align: center; scroll-margin-top: 88px; }

  .cs-nova { text-align: center; scroll-margin-top: 88px; }
  .cs-nova .section-header h2 { text-wrap: balance; }
  .cs-nova-lead { max-width: 760px; margin: 0 auto 28px; font-size: 17px; line-height: 1.65; color: var(--text-mid); }
  .cs-nova-lead strong { color: var(--text); font-weight: 700; }
  .cs-nova-img { display: block; width: 100%; max-width: 980px; height: auto; margin: 0 auto 40px; }
  .cs-nova-compare-lead { max-width: 720px; margin: 0 auto 22px; font-size: clamp(20px, 2.4vw, 26px); font-weight: 800; line-height: 1.3; letter-spacing: -0.02em; text-wrap: balance; }
  .cs-nova-table-wrap { max-width: 860px; margin: 0 auto 36px; overflow-x: auto; text-align: left; }
  .cs-nova-table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-20); overflow: hidden; box-shadow: var(--shadow-card); }
  .cs-nova-table th,
  .cs-nova-table td { width: 50%; padding: 16px 22px; font-size: 15px; line-height: 1.45; vertical-align: top; }
  .cs-nova-table thead th { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 1px solid var(--border); }
  .cs-nova-table thead th:first-child { color: var(--text-mid); background: var(--bg); }
