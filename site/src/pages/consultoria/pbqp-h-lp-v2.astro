const passos = [
  {
    t: "Conversa com um especialista e proposta sob medida:",
    d: "entendemos a sua operação e apresentamos a proposta com o escopo certo para a sua empresa.",
  },
  {
    t: "Documentos elaborados para a implementação:",
    d: "Nunca delegamos para você o que deve ser feito por nós. Elaboramos todos os documentos, alinhados à sua operação, para você implementar com rapidez, segurança e sem retrabalho.",
