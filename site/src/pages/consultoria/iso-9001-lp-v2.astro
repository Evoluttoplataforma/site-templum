  <script is:inline>
    (function () {
      var dlg = document.getElementById("lp-form-modal");
      if (!dlg) return;
      document.querySelectorAll("[data-abre-form]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          if (typeof dlg.showModal === "function" && !dlg.open) dlg.showModal();
          document.body.classList.add("v2-modal-on");
          if (window.tplFormEvento) {
            var norma = dlg.querySelector('input[name="norma"]');
            window.tplFormEvento({ evento: "form_visivel", norma: norma ? norma.value : "ISO 9001" });
          }
          var primeiro = dlg.querySelector('input:not([type="hidden"])');
          if (primeiro) primeiro.focus();
        });
      });
      dlg.querySelectorAll("[data-fecha-form]").forEach(function (btn) {
        btn.addEventListener("click", function () { dlg.close(); });
      });
      dlg.addEventListener("close", function () {
        document.body.classList.remove("v2-modal-on");
      });
      dlg.addEventListener("click", function (e) {
        if (e.target === dlg) dlg.close();
      });
      var menuBtn = document.querySelector("[data-menu]");
      var menuPanel = document.querySelector("[data-menu-panel]");
      function fechaMenu() {
        if (!menuPanel || !menuBtn) return;
        menuPanel.hidden = true;
        menuBtn.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      }
      if (menuBtn && menuPanel) {
        menuBtn.addEventListener("click", function () {
          menuPanel.hidden = false;
          menuBtn.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
        });
        menuPanel.querySelectorAll("[data-menu-close], a").forEach(function (el) {
          el.addEventListener("click", fechaMenu);
        });
      }
      document.querySelectorAll("[data-yt]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var id = btn.getAttribute("data-yt");
          if (!id) return;
          var frame = document.createElement("iframe");
          frame.src = "https://www.youtube-nocookie.com/embed/" + id + "?autoplay=1";
          frame.title = btn.getAttribute("aria-label") || "Depoimento";
          frame.width = "480";
          frame.height = "360";
          frame.allow = "autoplay; encrypted-media";
          frame.setAttribute("allowfullscreen", "");
          btn.replaceWith(frame);
        });
      });
      var vids = document.querySelectorAll("video[data-motion]");
      if (!("IntersectionObserver" in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var v = entry.target;
          v.play().catch(function () {});
          io.unobserve(v);
        });
      }, { rootMargin: "120px" });
      vids.forEach(function (v) { io.observe(v); });
    })();
  </script>
