---
// Página estática da LP de Google Ads. O HTML fica em src/lp para não
// colidir com os assets em public/consultoria/iso-27001-lp-v3/.
import html from "../../lp/iso-27001-lp-v3.html?raw";
import SaidaPesquisa from "../../components/SaidaPesquisa.astro";

const doc = html.replace(/^\uFEFF?\s*<!doctype html>\s*/i, "");
const cut = doc.lastIndexOf("</body>");
const before = cut === -1 ? doc : doc.slice(0, cut);
const after = cut === -1 ? "" : doc.slice(cut);
---
<Fragment set:html={before} />
<SaidaPesquisa norma="ISO 27001" oferta="proposta" />
<Fragment set:html={after} />
