---
import Base from "../../layouts/Base.astro";
import ClientLogos from "../../components/ClientLogos.astro";
import LeadForm from "../../components/LeadForm.astro";

const motivos = [
  { icon: "solar:wad-of-money-bold", t: "Capacidade de contratação real", d: "O GERIC mede a confiança que a Caixa deposita na sua empresa com base no faturamento — não depende só de patrimônio ou de garantia adicional." },
  { icon: "solar:case-round-bold", t: "Menos obra parada esperando venda", d: "Com o GERIC e o PBQP-H em dia, sua construtora acessa capital de giro pra próxima obra sem depender só do recurso da atual." },
  { icon: "solar:document-add-bold", t: "Abre porta pra licitação também", d: "O PBQP-H — pré-requisito do GERIC — costuma ser exigido em editais públicos de infraestrutura, não só em financiamento privado." },
];
const matriz = [
  { t: "Evolução de obra", d: "Quanto já foi investido e construído de fato — o que a Caixa consegue medir e comprovar." },
  { t: "Vendas financiadas", d: "O valor que entrou via financiamento direto e caiu na conta gerida pelo banco durante a obra." },
  { t: "PJ (linha de crédito)", d: "A linha de crédito pessoa jurídica, multiplicada por um fator de até dez vezes — porque mede sua capacidade de pagar o juro da obra, não o crédito em si." },
];
const passos = [
  { t: "Diagnóstico", d: "Avaliamos o faturamento dos últimos três anos fiscais e estimamos o teto de GERIC realista pra sua empresa." },
  { t: "PBQP-H em paralelo", d: "Conduzimos a certificação PBQP-H, pré-requisito da Caixa, enquanto o GERIC avança — pra chegar com os dois prontos." },
  { t: "Assessoria fiscal e contábil", d: "Organizamos a documentação e, se necessário, alinhamos com seu contador notas explicativas pra margens fora do padrão do setor." },
  { t: "Negociação direta com a Caixa", d: "Acompanhamos o trâmite junto à agência e à superintendência até a aprovação — sem promessa de resultado que não podemos garantir." },
];
const requisitos = [
  "Faturamento anual dentro da referência que a Caixa considera pra análise de crédito",
  "CNAE compatível: engenharia, arquitetura, construção ou incorporação",
  "Regularidade fiscal e contábil, com declarações em dia",
  "PBQP-H no nível adequado (pré-requisito da Caixa)",
  "Relacionamento bancário ativo com a Caixa — conta PF ou PJ já ajuda no trâmite",
];
---

<Base
  title="GERIC Caixa — Homologação de construtoras para financiamento | Templum"
  description="Entenda como a Caixa calcula o GERIC da sua construtora, quanto de crédito você pode acessar e como a Templum conduz o processo do diagnóstico à aprovação — sem promessa irreal."
>
  <!-- HERO (escuro, com formulário — GERIC não tem página LP separada) -->
  <section class="gr-hero" id="form">
    <div class="gr-hero-bg" aria-hidden="true"></div>
    <div class="container xl gr-hero-grid">
      <div class="gr-hero-text">
        <span class="tag-pill tag-pill--glow">GERIC · Caixa Econômica</span>
        <h1 class="gr-title">Descubra quanto sua construtora pode captar no <span class="gr-hl">GERIC da Caixa</span></h1>
        <p class="gr-sub">O GERIC é o limite de crédito que a Caixa dá pra sua construtora com base no histórico fiscal e contábil — não é dinheiro parado, é capacidade de contratar financiamento pra suas obras. A Templum analisa sua empresa, organiza a documentação e conduz o trâmite direto com a Caixa.</p>
        <div class="gr-chips">
          {["Baseado no seu faturamento", "Mais rápido que o PBQP-H", "+30 anos de método"].map((ch) => (
            <span class="gr-chip"><iconify-icon icon="solar:check-circle-bold"></iconify-icon>{ch}</span>
          ))}
        </div>
        <a href="/consultoria/pbqp-h/" class="gr-ver-pbqph">Ver PBQP-H <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
      </div>
      <div class="gr-hero-form">
        <LeadForm
          norma="GERIC"
          titulo="Descubra seu limite de GERIC"
          sub="Preencha o formulário e um especialista da Templum entra em contato."
          cta="Quero meu diagnóstico"
          faturamento={true}
          labelEmpresa="Nome da construtora"
        />
      </div>
    </div>
  </section>

  <!-- O QUE É -->
  <section class="section section--cream">
    <div class="container md gr-intro">
      <span class="tag-pill">O que é o GERIC</span>
      <h2>Um limite de crédito que mede <em class="accent">confiança</em>, não dinheiro em caixa</h2>
      <p>O GERIC é calculado pela Caixa com base na média ponderada do faturamento dos últimos três anos fiscais — o ano mais recente pesa mais que os dois anteriores somados. Ele define até quanto a Caixa confia na sua empresa pra contratar um empreendimento. Ter o limite aprovado é o primeiro passo; quanto do crédito é efetivamente liberado pra obra depende de outros fatores, que explicamos abaixo.</p>
    </div>
  </section>

  <!-- MATRIZ DE CONJUGAÇÃO -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="tag-pill">Como o crédito é liberado</span>
        <h2>A matriz de conjugação: as <em class="accent">três variáveis</em> que decidem o valor</h2>
        <p>Quando o empreendimento é contratado, a Caixa assume a gestão do custo da obra. A partir daí, o dinheiro é liberado aos poucos, seguindo três variáveis conhecidas no mercado como matriz de conjugação.</p>
      </div>
      <div class="gr-grid">
        {matriz.map((m, i) => (
          <div class="eco-card">
            <span class="gr-ico">{i + 1}</span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- POR QUE HOMOLOGAR -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="tag-pill">Por que homologar</span>
        <h2>O que a sua construtora tem a <em class="accent">ganhar</em></h2>
      </div>
      <div class="gr-grid">
        {motivos.map((m) => (
          <div class="eco-card">
            <span class="gr-ico"><iconify-icon icon={m.icon}></iconify-icon></span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO A TEMPLUM AJUDA -->
  <section class="section section--cream">
    <div class="container xl">
      <div class="section-header">
        <span class="tag-pill">Como a Templum ajuda</span>
        <h2>Diagnóstico sério, sem <em class="accent">promessa irreal</em></h2>
        <p>Conduzimos cada etapa com base no que o seu faturamento comprova — não prometemos aprovação que não podemos garantir.</p>
      </div>
      <div class="step-grid">
        {passos.map((p, i) => (
          <div class="step-card reveal"><span class="step-num">{String(i + 1).padStart(2, "0")}</span><h3>{p.t}</h3><p>{p.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- REQUISITOS -->
  <section class="section section--navy">
    <div class="container lg">
      <div class="section-header">
        <span class="tag-pill tag-pill--glow">Requisitos</span>
        <h2>O que é preciso para <em class="accent">se habilitar</em></h2>
      </div>
      <ul class="check-list gr-req">
        {requisitos.map((r) => (
          <li class="check-item"><span class="check-circle"><iconify-icon icon="solar:check-read-linear"></iconify-icon></span>{r}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ALERTA LOCAÇÃO DE GERIC -->
  <section class="section section--cream">
    <div class="container md gr-intro">
      <span class="tag-pill">Um alerta antes de contratar</span>
      <h2>Cuidado com quem oferece <em class="accent">"locação de GERIC"</em></h2>
      <p>Existe no mercado a prática de "alugar" a capacidade de GERIC de outra empresa pra fechar um empreendimento — um atalho que pode custar entre 6% e 10% do valor da obra e compromete a integridade da sua relação com o banco. A Templum trabalha só pelo caminho da qualificação real da sua empresa: análise técnica do seu próprio histórico fiscal e contábil, sem interferência manual no sistema da Caixa.</p>
    </div>
  </section>

  <ClientLogos dark={false} titulo="Construtoras que crescem com a Templum" />

  <!-- CTA -->
  <section class="cta-band">
    <div class="container md">
      <h2>Pronto para construir com o <em>apoio da Caixa</em>?</h2>
      <p>Fale com um especialista e descubra o caminho mais curto até a homologação no GERIC.</p>
      <a href="#form" class="btn btn--dark btn--lg">Falar com um especialista <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></a>
    </div>
  </section>
</Base>

<style>
  .gr-hero { position: relative; background: var(--navy); color: var(--cream); overflow: hidden; padding: clamp(48px, 6vw, 80px) 0; }
  .gr-hero-bg { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(720px 460px at 12% 0%, rgba(255,89,37,0.30), transparent 60%), radial-gradient(560px 380px at 100% 100%, rgba(255,89,37,0.16), transparent 60%); }
  .gr-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .gr-hero-text { max-width: 600px; }
  .gr-hero .tag-pill { margin-bottom: 20px; }
  .gr-title { font-size: clamp(32px, 4.4vw, 54px); font-weight: 800; line-height: 1.07; letter-spacing: -0.03em; color: var(--cream); }
  .gr-hl { color: color-mix(in srgb, var(--orange) 58%, #ffffff); }
  .gr-sub { font-size: 17px; color: rgba(255,244,221,0.82); margin-top: 18px; max-width: 520px; line-height: 1.6; }
  .gr-chips { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 26px; padding-top: 22px; border-top: 1px solid rgba(255,244,221,0.14); }
  .gr-chip { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: rgba(255,244,221,0.82); }
  .gr-chip iconify-icon { color: color-mix(in srgb, var(--orange) 58%, #ffffff); font-size: 18px; }
  .gr-hero-form { align-self: start; }
  .gr-ver-pbqph { display: inline-flex; align-items: center; gap: 7px; margin-top: 22px; font-size: 14px; font-weight: 600; color: rgba(255,244,221,0.55); text-decoration: none; transition: color .2s; }
  .gr-ver-pbqph:hover { color: color-mix(in srgb, var(--orange) 58%, #ffffff); }
  @media (max-width: 900px) { .gr-hero-grid { grid-template-columns: 1fr; } }

  .gr-intro { text-align: center; }
  .gr-intro .tag-pill { margin: 0 auto 16px; }
  .gr-intro h2 { font-size: clamp(26px, 3.4vw, 40px); font-weight: 800; letter-spacing: -0.025em; }
  .gr-intro p { font-size: 16.5px; color: var(--text-mid); line-height: 1.65; margin-top: 16px; }

  .gr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 44px; }
  @media (max-width: 880px) { .gr-grid { grid-template-columns: 1fr; } }
  .gr-ico { width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; font-size: 22px; font-weight: 800; color: var(--orange); background: rgba(255,89,37,0.10); margin-bottom: 16px; }

  .gr-req { max-width: 760px; margin: 40px auto 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 32px; }
  .gr-req .check-item { color: var(--cream); }
  @media (max-width: 700px) { .gr-req { grid-template-columns: 1fr; } }
</style>
