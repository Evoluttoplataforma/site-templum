    (function () {
      var root = document.querySelector(".i27");
      if (!root) return;
      var burger = root.querySelector("[data-i27-menu]");
      var drawer = root.querySelector("[data-i27-drawer]");
      var closer = root.querySelector("[data-i27-close]");
      function setOpen(open) {
        if (!drawer || !burger) return;
        drawer.hidden = !open;
        burger.setAttribute("aria-expanded", open ? "true" : "false");
        document.body.classList.toggle("i27-lock", open);
      }
      if (burger) burger.addEventListener("click", function () { setOpen(drawer.hidden); });
      if (closer) closer.addEventListener("click", function () { setOpen(false); });
      if (drawer) {
        drawer.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () { setOpen(false); });
        });
      }
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") setOpen(false);
      });

      var links = root.querySelectorAll(".i27-nav a");
      var map = [];
      links.forEach(function (a) {
        var id = (a.getAttribute("href") || "").slice(1);
        var el = id && document.getElementById(id);
        if (el) map.push({ a: a, el: el });
      });
      if (!map.length || !("IntersectionObserver" in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          map.forEach(function (item) {
            item.a.classList.toggle("is-on", item.el === entry.target);
          });
        });
      }, { rootMargin: "-30% 0px -55% 0px", threshold: 0 });
      map.forEach(function (item) { io.observe(item.el); });
    })();
  </script>
