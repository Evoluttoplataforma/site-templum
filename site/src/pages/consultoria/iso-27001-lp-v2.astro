---
import LpBase from "../../layouts/LpBase.astro";
import { experimentoH1 } from "../../data/h1-experimentos.js";

// Layout visual da LP mkt /iso-9001/variant-a/, com o texto da consultoria ISO 27001.
// O sorteio tpl_h1_iso27001v2_r01 vale só nesta página.
// A LP dos anúncios (/consultoria/iso-27001-lp/) segue na rodada tpl_h1_iso27001_r01.
// O formulário usa os mesmos campos do funil (cargo e mensagem) para a proposta chegar no CRM.

const h1 = experimentoH1("iso27001v2");
const cta = "Solicite uma proposta";
const norma = "ISO 27001";

const passos = [
  { href: "#escopo", n: "01", t: "Escopo alinhado à sua necessidade." },
  { href: "#investimento", n: "02", t: "Responsabilidades e investimento definidos." },
  { href: "#acompanhamento", n: "03", t: "Projeto organizado no Templum OS." },
  { href: "#especialistas", n: "04", t: "Especialistas acompanhando sua equipe." },
];

const papeis = [
  "Aprovo ou participo da aprovação",
  "Lidero a implementação",
  "Apoio a avaliação técnica",
  "Outro",
];

const motivos = [
  "Exigência de cliente",
  "Homologação ou renovação de contrato",
  "Iniciativa da empresa",
  "Implementação já iniciada",
  "Outra necessidade",
];
---

<LpBase
  title="Consultoria para certificação ISO 27001 | Templum"
  description="Implemente a ISO 27001 com escopo claro e apoio especializado. Prepare sua empresa para a auditoria e para as exigências de segurança dos seus clientes."
  hideChrome={true}
  h1Experimento={h1}
>
  <link slot="head" rel="preload" as="image" href="/assets/lp/iso27001-v2/hero.webp" type="image/webp" fetchpriority="high" />

  <div class="i27">
    <header class="i27-bar">
      <div class="i27-bar-in">
        <a class="i27-logo" href="/consultoria/iso-27001-lp-v2/" aria-label="Templum Consultoria">
          <img src="/assets/lp/iso9001-v2/logo-templum.svg" alt="Templum" width="120" height="32" />
        </a>
        <nav class="i27-nav" aria-label="Seções" data-i27-nav>
          <a href="#incluido">O que está incluído</a>
          <a href="#como-funciona">Como funciona</a>
          <a href="#acompanhamento">Acompanhamento</a>
        </nav>
        <a class="i27-cta i27-cta--sm" href="#proposta">
          <span class="i27-cta-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="i27-cta-label">{cta}</span>
        </a>
        <button type="button" class="i27-burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="i27-menu" data-i27-menu>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </header>

    <div class="i27-drawer" id="i27-menu" data-i27-drawer hidden>
      <div class="i27-drawer-head">
        <img src="/assets/lp/iso9001-v2/logo-templum.svg" alt="" width="120" height="32" />
        <button type="button" class="i27-burger" data-i27-close aria-label="Fechar menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <nav aria-label="Seções">
        <a href="#incluido">O que está incluído</a>
        <a href="#como-funciona">Como funciona</a>
        <a href="#acompanhamento">Acompanhamento</a>
      </nav>
      <a class="i27-cta i27-cta--block" href="#proposta">
        <span class="i27-cta-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span class="i27-cta-label">{cta}</span>
      </a>
    </div>

    <section class="i27-hero">
      <div class="i27-wrap i27-hero-grid">
        <div class="i27-hero-copy">
          <p class="i27-kicker">Consultoria para certificação ISO&nbsp;27001</p>
          <h1 id="tpl-h1">Seus clientes exigem a <span>ISO 27001</span>? Prepare sua empresa para atender.</h1>
          <script is:inline>
            if (window.tplH1Aplicar) window.tplH1Aplicar();
          </script>
          <p class="i27-sub">Prepare sua empresa para a auditoria e para as exigências de segurança dos seus clientes.</p>
          <ul class="i27-checks">
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Consultor especialista para orientar sua equipe durante a implementação.</li>
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Documentação prevista no projeto e acompanhamento pelo Templum OS.</li>
          </ul>
          <div class="i27-hero-actions">
            <a class="i27-cta" href="#proposta">
              <span class="i27-cta-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="i27-cta-label">{cta}</span>
            </a>
            <p class="i27-note">Entenda o escopo, o investimento e os próximos passos para sua empresa.</p>
          </div>
        </div>

        <div class="i27-hero-visual">
          <div class="i27-photo">
            <img
              src="/assets/lp/iso27001-v2/hero.webp"
              alt="Profissional com tablet diante de uma sala de servidores, com um escudo de cadeado ao lado."
              width="819"
              height="675"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <aside class="i27-float">
            <span class="i27-float-ico" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v6c0 4.5-2.8 7.4-7 9-4.2-1.6-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.7"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <p><strong>100% online</strong>Acompanhamento pelo Templum OS.</p>
          </aside>
        </div>
      </div>
    </section>

    <section class="i27-sec" aria-labelledby="i27-autoridade">
      <div class="i27-wrap">
        <h2 id="i27-autoridade">Experiência em sistemas de gestão para apoiar sua implementação.</h2>
        <div class="i27-stats">
          <article class="i27-stat">
            <p class="i27-stat-n"><em>+8 mil</em></p>
            <p>Empresas fortalecidas em diferentes sistemas de gestão.</p>
          </article>
          <article class="i27-stat i27-stat--orange">
            <p class="i27-stat-n"><em>100% online</em></p>
            <p>Consultoria com acompanhamento pelo Templum OS.</p>
          </article>
          <article class="i27-stat i27-stat--navy">
            <p class="i27-stat-n"><em>+30 anos</em></p>
            <p>De experiência em consultoria e sistemas de gestão.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="i27-sec i27-sec--tight" id="incluido">
      <div class="i27-wrap">
        <p class="i27-kicker">Implementação da ISO&nbsp;27001</p>
        <h2>Da exigência do cliente a um plano de implementação.</h2>
        <p class="i27-lede">Defina o que precisa ser feito, quem participa e como preparar sua empresa para a auditoria.</p>
        <nav class="i27-jumps" id="como-funciona" aria-label="Etapas da implementação">
          {passos.map((p) => (
            <a href={p.href}>
              <span>{p.n}</span>
              {p.t}
            </a>
          ))}
        </nav>
      </div>
    </section>

    <section class="i27-block" id="escopo">
      <div class="i27-wrap i27-split">
        <div>
          <p class="i27-kicker">01 · Escopo</p>
          <h2>Comece pelo escopo que sua empresa precisa certificar.</h2>
          <p>Seu cliente exige a ISO&nbsp;27001 para contratar, renovar ou homologar sua empresa? O primeiro passo é entender o requisito e delimitar os serviços, processos e operações envolvidos.</p>
          <ul class="i27-checks">
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Apresente a exigência recebida e confirme com o comprador o que ele aceita como comprovação.</li>
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Avalie os controles, as políticas e os registros que sua empresa já possui.</li>
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Identifique as lacunas para planejar a implementação.</li>
          </ul>
          <a class="i27-cta" href="#proposta"><span class="i27-cta-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="i27-cta-label">{cta}</span></a>
        </div>
        <ol class="i27-panel">
          <li><span>1</span><div><strong>Exigência recebida</strong><p>O que o comprador aceita como comprovação.</p></div></li>
          <li><span>2</span><div><strong>O que já existe</strong><p>Controles, políticas e registros atuais.</p></div></li>
          <li><span>3</span><div><strong>Lacunas</strong><p>O que falta para planejar a implementação.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="i27-block i27-block--cream" id="investimento">
      <div class="i27-wrap i27-split i27-split--flip">
        <div>
          <p class="i27-kicker">02 · Execução</p>
          <h2>Saiba o que será feito e quem executa cada atividade.</h2>
          <p>Avalie a contratação com clareza sobre entregas, participação da equipe e possíveis adequações técnicas. Essas definições ajudam a planejar o investimento e a execução.</p>
          <ul class="i27-checks">
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Documentos previstos no escopo elaborados pela consultoria, com informações e validações da sua equipe.</li>
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Responsabilidades distribuídas entre consultoria, áreas internas e fornecedores técnicos.</li>
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Custos de consultoria, certificadora e eventuais ferramentas avaliados separadamente.</li>
          </ul>
          <a class="i27-cta" href="#proposta"><span class="i27-cta-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="i27-cta-label">{cta}</span></a>
        </div>
        <ul class="i27-panel i27-panel--split">
          <li><strong>Consultoria</strong><p>Documentos previstos no escopo, com validação da equipe.</p></li>
          <li><strong>Áreas internas</strong><p>Informações da operação e responsáveis pelo projeto.</p></li>
          <li><strong>Fornecedores técnicos</strong><p>Adequações que ficam fora da consultoria.</p></li>
        </ul>
      </div>
    </section>

    <section class="i27-block" id="acompanhamento">
      <div class="i27-wrap i27-split">
        <div>
          <p class="i27-kicker">03 · Plataforma</p>
          <h2>Acompanhe a implementação pelo Templum OS.</h2>
          <p>Organize atividades, documentos e responsabilidades em um ambiente de acompanhamento do projeto, com orientação da consultoria.</p>
          <ul class="i27-checks">
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Consulte as atividades e acompanhe as pendências da implementação.</li>
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Organize a documentação e as evidências do sistema de gestão.</li>
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Dê visibilidade ao andamento para os responsáveis pelo projeto.</li>
          </ul>
          <a class="i27-cta" href="#proposta"><span class="i27-cta-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="i27-cta-label">{cta}</span></a>
        </div>
        <div class="i27-os" aria-hidden="true">
          <div class="i27-os-top"><span>Templum OS</span><em>Projeto</em></div>
          <ul>
            <li><i></i>Atividades da implementação</li>
            <li><i></i>Documentação e evidências</li>
            <li><i></i>Pendências do projeto</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="i27-block i27-block--cream" id="especialistas">
      <div class="i27-wrap i27-split i27-split--flip">
        <div>
          <p class="i27-kicker">04 · Especialistas</p>
          <h2>Sua equipe participa com orientação em cada etapa.</h2>
          <p>Conte com especialistas para esclarecer dúvidas e conduzir os próximos passos. Envolva quem aprova o investimento e quem será responsável pela implementação.</p>
          <ul class="i27-checks">
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Orientação para conectar os requisitos da norma à realidade da operação.</li>
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Checkpoints para acompanhar entregas e identificar ajustes necessários.</li>
            <li><span class="i27-check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 12 9" fill="none"><path d="M1 4.2L4.2 7.4L11 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>Preparação dos documentos e das evidências para a auditoria de certificação.</li>
          </ul>
          <a class="i27-cta" href="#proposta"><span class="i27-cta-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="i27-cta-label">{cta}</span></a>
          <p class="i27-close">Converse sobre sua necessidade, apresente o contexto da empresa e avalie o projeto com os responsáveis técnicos e pela decisão.</p>
        </div>
        <ol class="i27-panel">
          <li><span>1</span><div><strong>Quem decide</strong><p>Aprova o investimento e o escopo.</p></div></li>
          <li><span>2</span><div><strong>Quem implementa</strong><p>Participa das etapas com a consultoria.</p></div></li>
          <li><span>3</span><div><strong>Auditoria</strong><p>Documentos e evidências preparados.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="i27-case" id="case">
      <div class="i27-wrap">
        <p class="i27-kicker">Case ISO 27001:2022</p>
        <h2>A BB Tecnologia e Serviços, do Banco do Brasil, certificou a <em>ISO 27001</em> sem não conformidade.</h2>
        <p class="i27-lede">A empresa de tecnologia do Banco do Brasil implementou a norma com a Templum e chegou à auditoria de certificação com este resultado.</p>
        <div class="i27-results" aria-label="Resultado da auditoria de certificação">
          <article>
            <p class="i27-stat-n"><em>00</em></p>
            <p>Não conformidade maior</p>
          </article>
          <article>
            <p class="i27-stat-n"><em>00</em></p>
            <p>Não conformidade menor</p>
          </article>
          <article>
            <p class="i27-stat-n"><em>03</em></p>
            <p>Oportunidades de melhoria</p>
          </article>
        </div>
        <p class="i27-case-note">Nenhuma não conformidade maior. Nenhuma menor. Três observações. A Templum implementou e preparou a empresa. A avaliação e o certificado ficam com o organismo certificador.</p>
        <a class="i27-cta" href="#proposta"><span class="i27-cta-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="i27-cta-label">{cta}</span></a>
      </div>
    </section>

    <section class="i27-cover">
      <div class="i27-wrap i27-split">
        <div>
          <p class="i27-kicker">Estrutura preparada para operar em escala</p>
          <h2>Consultoria 100% online, com atuação em mais de 800 cidades no Brasil, Portugal e África.</h2>
          <p>O mesmo acompanhamento vale para a ISO 27001. A equipe entra no projeto de onde a empresa estiver, pelo Templum OS.</p>
          <a class="i27-cta" href="#proposta"><span class="i27-cta-arrow" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 12H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="i27-cta-label">{cta}</span></a>
        </div>
        <img src="/assets/lp/pbqph-v2/mapa.webp" alt="Mais de 8 mil contratos da Templum no Brasil, Moçambique, Portugal e Angola." width="674" height="566" loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="i27-formsec" id="proposta">
      <div class="i27-wrap i27-form-wrap">
        <p class="i27-kicker">Proposta</p>
        <h2>Solicite sua proposta de consultoria ISO&nbsp;27001.</h2>
        <p class="i27-lede">Conte o que sua empresa precisa para conversarmos sobre escopo, implementação e investimento.</p>
        <form class="form i27-form" data-trk-event="lead" novalidate data-obrigado="/consultoria/iso-27001-obrigado">
          <input type="hidden" name="norma" value={norma} />
          <div class="form-row">
            <div class="field">
              <label for="i27-nome">Nome completo</label>
              <input class="input" id="i27-nome" name="nome" autocomplete="name" placeholder="Seu nome" required />
            </div>
            <div class="field">
              <label for="i27-email">E-mail corporativo</label>
              <input class="input" id="i27-email" type="email" name="email" autocomplete="email" placeholder="voce@empresa.com" required />
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="i27-tel">WhatsApp</label>
              <input class="input" id="i27-tel" type="tel" inputmode="numeric" name="telefone" autocomplete="tel" placeholder="(00) 00000-0000" required />
            </div>
            <div class="field">
              <label for="i27-empresa">Nome da empresa</label>
              <input class="input" id="i27-empresa" name="empresa" autocomplete="organization" placeholder="Razão social ou nome fantasia" required />
            </div>
          </div>
          <div class="field">
            <label for="i27-papel">Seu papel no projeto</label>
            <select class="select" id="i27-papel" name="cargo" required>
              <option value="">Selecione</option>
              {papeis.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="i27-motivo">O que motivou sua busca pela ISO&nbsp;27001?</label>
            <select class="select" id="i27-motivo" name="mensagem" required>
              <option value="">Selecione</option>
              {motivos.map((m) => <option value={m}>{m}</option>)}
            </select>
          </div>
