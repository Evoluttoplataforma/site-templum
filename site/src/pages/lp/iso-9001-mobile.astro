        if (next) next.addEventListener("click", function () { ir(Math.min(total - 1, atual + 1)); });
        track.addEventListener("keydown", function (e) {
          if (e.key === "ArrowRight") { e.preventDefault(); ir(Math.min(total - 1, atual + 1)); }
          if (e.key === "ArrowLeft") { e.preventDefault(); ir(Math.max(0, atual - 1)); }
        });

        // Curtir: botão ou toque duplo no slide, como no Instagram.
        var like = post.querySelector("[data-ig-like]");
        function curtir(forcar) {
