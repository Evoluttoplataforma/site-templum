---
import LpBase from "../../layouts/LpBase.astro";

// LP de anúncio do Google Ads (campanha só celular) para dono de empresa que busca ISO 9001.
// Formato de perfil do Instagram, com a Dani como rosto: destaques no topo e 5 carrosséis
// que respondem as dúvidas da busca (dinheiro, custo, prazo, cases, método).
// Conversão: todo botão de WhatsApp abre antes uma gaveta com o formulário (nome, e-mail,
// empresa, cargo, telefone). O envio usa o handler padrão do LpBase (/api/lead → INBOUND),
// e a página de obrigado dispara a conversão e abre o WhatsApp com a frase do carrossel.
// Cada slide visto vira evento no GA4 e tag no Clarity, para medir onde a pessoa para.

const norma = "ISO 9001";
const cargos = ["Dono(a) ou sócio(a)", "Diretor(a)", "Gerente", "Coordenador(a) ou analista", "Outro"];
const linhaGeral = "Olá! Vim pela página da ISO 9001 e quero conversar sobre a certificação da minha empresa.";

const posts = [
  {
    id: "dinheiro",
    destaque: "Dinheiro",
    icone: "solar:dollar-minimalistic-bold",
    legenda: "A pergunta que todo dono faz antes de investir. Deslize para ver de onde vem o retorno.",
    linha: "Olá! Vim pela página da ISO 9001 e quero entender quanto ela pode render na minha empresa.",
    slides: [
      { tipo: "capa", kicker: "ISO 9001", titulo: "A ISO 9001 traz mais <em>dinheiro</em> pra minha empresa?", texto: "Deslize para o lado →" },
      { tipo: "claro", titulo: "Traz. E não é pelo quadro na parede.", texto: "O dinheiro vem de três lugares: <strong>novos contratos</strong>, <strong>menos desperdício</strong> e uma <strong>operação que não depende de você</strong>." },
      { tipo: "claro", numero: "1", titulo: "Portas que hoje estão fechadas", texto: "Indústrias, grandes empresas e órgãos públicos pedem a ISO 9001 para cadastrar fornecedor. Sem ela, sua empresa nem entra na concorrência." },
      { tipo: "navy", destaque: "+1 milhão", titulo: "de empresas certificadas no mundo", texto: "É a norma de gestão mais usada do planeta. Seu concorrente pode já ter, e usar isso para ganhar o cliente que seria seu." },
      { tipo: "claro", numero: "2", titulo: "Menos dinheiro jogado fora", texto: "Processo sem padrão repete erro. Retrabalho, devolução e desconto para cliente insatisfeito saem direto da sua margem." },
      { tipo: "claro", numero: "3", titulo: "Uma empresa que anda sem você", texto: "Quando tudo passa pelo dono, a empresa cresce até onde ele aguenta. A ISO deixa o caminho escrito e a equipe segue sozinha." },
      { tipo: "laranja", destaque: "R$ 3,3 bi", titulo: "em ganhos gerados para clientes Templum", texto: "Quer saber quanto a ISO 9001 pode render na sua empresa?", cta: "Calcular comigo no WhatsApp" },
    ],
  },
  {
    id: "custo",
    destaque: "Custo",
    icone: "solar:tag-price-bold",
    legenda: "Sem rodeio: o valor, do que ele depende e o que está incluso.",
    linha: "Olá! Vim pela página da ISO 9001 e quero saber o valor para a minha empresa.",
    slides: [
      { tipo: "capa", kicker: "ISO 9001", titulo: "Quanto <em>custa</em> a ISO 9001?", texto: "A resposta direta está no próximo slide →" },
      { tipo: "laranja", kicker: "Investimento", antes: "A partir de", destaque: "R$ 2.500", titulo: "por mês", texto: "Sem limite de horas de consultoria e sem taxa escondida." },
      { tipo: "claro", titulo: "O valor final depende de 4 coisas", lista: ["Tamanho da equipe", "Quantas unidades a empresa tem", "Quantos processos entram no escopo", "O quanto a gestão já está organizada"] },
      { tipo: "claro", titulo: "O que está incluso", lista: ["Consultoria do diagnóstico até a auditoria", "Documentos elaborados pela Templum", "Templum OS: plataforma com agentes de IA", "Preparação para a auditoria"] },
      { tipo: "claro", titulo: "O que fica por fora", texto: "A taxa do organismo certificador. É ele quem audita e emite o certificado, e por regra precisa ser independente de quem implementa. A gente ajuda você a escolher." },
      { tipo: "navy", destaque: "200%", titulo: "de garantia", texto: "Se a sua empresa cumprir todas as etapas do método e não certificar, devolvemos o dobro do que você pagou." },
      { tipo: "laranja", titulo: "Quer o valor exato para a sua empresa?", texto: "Me conta o tamanho da sua operação e eu te passo a proposta.", cta: "Pedir meu valor no WhatsApp" },
    ],
  },
  {
    id: "prazo",
    destaque: "Prazo",
    icone: "solar:clock-circle-bold",
    legenda: "Seu cliente deu prazo? Veja quanto tempo leva e o que acelera.",
    linha: "Olá! Vim pela página da ISO 9001. Tenho prazo para certificar e quero saber se dá tempo.",
    slides: [
      { tipo: "capa", kicker: "ISO 9001", titulo: "Em quanto <em>tempo</em> eu tenho a ISO 9001?", texto: "Deslize para o lado →" },
      { tipo: "laranja", kicker: "Prazo", antes: "A partir de", destaque: "6 meses", texto: "Do primeiro dia de projeto até a auditoria de certificação." },
      { tipo: "claro", titulo: "O caminho até o certificado", etapas: ["Diagnóstico da operação", "Implementação dos processos", "Acompanhamento e ajustes", "Auditoria de certificação"] },
      { tipo: "claro", titulo: "O que acelera", lista: ["Uma pessoa da equipe responsável pelo projeto", "Documentos validados sem demora", "Auditoria agendada cedo com o certificador"] },
      { tipo: "claro", titulo: "O que atrasa", lista: ["Projeto sem dono dentro da empresa", "Validação parada esperando o chefe", "Mudança grande no meio do caminho"] },
      { tipo: "navy", kicker: "Hora boa para começar", titulo: "A ISO 9001:2026 saiu em setembro", texto: "Quem começa agora já certifica na versão nova e não precisa migrar depois." },
      { tipo: "laranja", titulo: "Seu cliente deu um prazo?", texto: "Me fala a data e eu te digo se dá tempo.", cta: "Ver meu prazo no WhatsApp" },
    ],
  },
  {
    id: "cases",
    destaque: "Cases",
    icone: "solar:star-bold",
    legenda: "Quem já passou pela certificação com a Templum conta como foi.",
    linha: "Olá! Vim pela página da ISO 9001, vi os cases e quero fazer o mesmo na minha empresa.",
    slides: [
      { tipo: "capa", kicker: "Clientes Templum", titulo: "Quem já <em>certificou</em> com a gente", texto: "Nota 4,9 em 204 avaliações no Google · deslize →" },
      { tipo: "depoimento", nome: "Daniel Okubo", empresa: "Manpowergroup", cor: "#7CB342", texto: "Conquistamos dentro do prazo de 1 ano 5 certificações ISOs (9001, 14001, 45001, 27001 e 27701) com a parceria da Templum. Esse prazo curto só foi possível através da excelente metodologia e consultores da Templum." },
      { tipo: "depoimento", nome: "Juliana Ribeiro", empresa: "ISO 9001 e ISO 14001", cor: "#1E5BB8", texto: "A experiência com a consultoria Templum foi extremamente positiva. A equipe demonstrou profissionalismo, competência técnica e comprometimento em todas as etapas da implementação das normas ISO 9001 e ISO 14001." },
      { tipo: "depoimento", nome: "Qualidade Transportes Esmeralda", empresa: "Cliente Templum", cor: "#8D6E63", texto: "Gratidão à Templum pela parceria e suporte durante nossa certificação! A plataforma é prática, completa e facilitou muito todo o processo. Um agradecimento especial à consultora Nathalia, sua ajuda fez toda a diferença nessa conquista!" },
      { tipo: "depoimento", nome: "Cintia da Silva Fernandes Revoredo", empresa: "Cliente Templum", cor: "#2E7D6F", texto: "Excelente plataforma Templum, é prática, completa e facilita muito todo o processo de certificação. Obrigada pela parceria e suporte durante nossa certificação! São ótimos profissionais." },
      { tipo: "depoimento", nome: "Victtor Sansao", empresa: "Cliente Templum", cor: "#7B1FA2", texto: "O formato gamificado e didático que a Templum criou para as certificações ISO é incrível. As atividades tornam-se mais fáceis e flexíveis para aplicar. Estamos muito satisfeitos com a aplicação e consultoria." },
      { tipo: "logos", titulo: "Algumas empresas que confiam na Templum" },
      { tipo: "laranja", destaque: "+30 anos", titulo: "levando empresas à certificação", texto: "A próxima pode ser a sua.", cta: "Quero ser o próximo case" },
    ],
  },
  {
    id: "metodo",
    destaque: "Método",
    icone: "solar:checklist-minimalistic-bold",
    legenda: "Como a Templum leva sua empresa até o certificado sem parar a operação.",
    linha: "Olá! Vim pela página da ISO 9001 e quero entender como funciona o método da Templum.",
    slides: [
      { tipo: "capa", kicker: "Metodologia Templum", titulo: "Como a gente leva sua empresa até o <em>certificado</em>", texto: "4 etapas · deslize →" },
      { tipo: "claro", numero: "1", titulo: "Diagnóstico inicial", texto: "A conversa parte da sua operação real: porte, unidades, processos e maturidade. O cronograma nasce disso." },
      { tipo: "claro", numero: "2", titulo: "Implementação orientada", texto: "A Templum elabora os documentos alinhados ao seu jeito de trabalhar. Sua equipe valida e aplica, no ritmo da empresa." },
      { tipo: "claro", numero: "3", titulo: "Acompanhamento", texto: "Consultores acompanham cada checkpoint. A dúvida entra no chat e a operação segue." },
      { tipo: "navy", kicker: "Templum OS", titulo: "Sua equipe não para", texto: "Uma plataforma com agentes de IA ajuda a criar, organizar e encontrar tudo da implementação. Nada de planilha perdida." },
      { tipo: "claro", numero: "4", titulo: "Preparação para auditoria", texto: "Requisitos, evidências e pendências organizados antes da auditoria. Com garantia de 200% em contrato." },
      { tipo: "laranja", titulo: "Quer ver o método aplicado na sua empresa?", texto: "Te mostro em uma conversa rápida.", cta: "Conversar no WhatsApp" },
    ],
  },
];

const logos = Array.from({ length: 12 }, (_, i) => `/assets/clientes/cliente-${i + 1}.svg`);
---

<LpBase
  title="Certificação ISO 9001 a partir de R$ 2.500/mês | Templum"
  description="Quanto custa, quanto tempo leva e quanto a ISO 9001 rende para a sua empresa. Consultoria Templum com garantia de 200%. Fale no WhatsApp."
  hideChrome={true}
>
  <div class="ig">
    <header class="ig-top">
      <img src="/assets/logo/templum.png" alt="Templum Consultoria" width="389" height="129" class="ig-logo" />
      <button
        class="ig-top-wpp"
        type="button"
        data-ig-lead="topo"
        data-linha={linhaGeral}
        data-abre-form
        data-cta-pos="menu"
        aria-label="Falar no WhatsApp"
      ><iconify-icon icon="solar:chat-round-dots-bold" aria-hidden="true"></iconify-icon></button>
    </header>

    <section class="ig-perfil">
      <div class="ig-perfil-row">
        <span class="ig-avatar ig-avatar--lg">
          <img src="/assets/img/lp-iso-9001-mobile/dani-192.jpg" alt="Daniela, sócia da Templum" width="192" height="192" fetchpriority="high" />
        </span>
        <ul class="ig-stats">
          <li><strong>+2.000</strong><span>clientes</span></li>
          <li><strong>200%</strong><span>garantia</span></li>
          <li><strong>4,9 ★</strong><span>204 no Google</span></li>
        </ul>
      </div>
      <h1 class="ig-nome">Dani · Templum Consultoria</h1>
      <p class="ig-cargo">Sócia · Certificação ISO 9001</p>
      <p class="ig-bio">
        🧡 Apaixonada por qualidade<br />
        🏆 Maior especialista em normas ISO do Brasil<br />
        ⏳ 16 anos de experiência<br />
        ✅ Mais de 2.000 empresas certificadas
      </p>
      <div class="ig-acoes">
        <button
          class="ig-btn ig-btn--primario"
          type="button"
          data-ig-lead="perfil"
          data-linha={linhaGeral}
          data-abre-form
          data-cta-pos="topo"
        ><iconify-icon icon="ic:baseline-whatsapp" aria-hidden="true"></iconify-icon>WhatsApp</button>
        <a class="ig-btn" href="#post-custo" data-ig-ir="custo">Ver valores</a>
      </div>
    </section>

    <nav class="ig-destaques" aria-label="Dúvidas">
      {posts.map((p) => (
        <a class="ig-destaque" href={`#post-${p.id}`} data-ig-ir={p.id}>
          <span class="ig-destaque-ring" data-ig-ring={p.id}>
            <span class="ig-destaque-ico"><iconify-icon icon={p.icone} aria-hidden="true"></iconify-icon></span>
          </span>
          <span class="ig-destaque-txt">{p.destaque}</span>
        </a>
      ))}
    </nav>

    <div class="ig-feed">
      {posts.map((p) => (
        <article class="ig-post" id={`post-${p.id}`} data-ig-post={p.id}>
          <header class="ig-post-head">
            <span class="ig-avatar ig-avatar--sm">
              <img src="/assets/img/lp-iso-9001-mobile/dani-192.jpg" alt="" width="192" height="192" loading="lazy" />
            </span>
            <span class="ig-post-autor">
              <strong>Dani · Templum</strong>
              <small>Certificação {norma}</small>
            </span>
            <span class="ig-post-contador" data-ig-contador>1/{p.slides.length}</span>
          </header>

          <div class="ig-carrossel">
            <div class="ig-track" data-ig-track tabindex="0" aria-label={`Carrossel: ${p.destaque}`}>
              {p.slides.map((s, i) => (
                <div class={`ig-slide ig-slide--${s.tipo}`} data-ig-slide={i + 1} aria-roledescription="slide" aria-label={`${i + 1} de ${p.slides.length}`}>
                  {s.tipo === "depoimento" ? (
                    <div class="ig-dep">
                      <div class="ig-dep-topo">
                        <span class="ig-dep-inicial" style={`background:${s.cor}`} aria-hidden="true">{s.nome.charAt(0)}</span>
                        <p class="ig-dep-autor"><strong>{s.nome}</strong><span>{s.empresa}</span></p>
                      </div>
                      <p class="ig-dep-nota"><span class="ig-dep-estrelas" aria-label="5 de 5 estrelas">★★★★★</span><span class="ig-dep-google"><iconify-icon icon="logos:google-icon" aria-hidden="true"></iconify-icon>Avaliação no Google</span></p>
                      <p class="ig-dep-texto">{s.texto}</p>
                    </div>
                  ) : s.tipo === "logos" ? (
                    <div class="ig-logos">
                      <p class="ig-titulo ig-titulo--sm">{s.titulo}</p>
                      <div class="ig-logos-grid">
                        {logos.map((src) => <img src={src} alt="" width="800" height="800" loading="lazy" decoding="async" />)}
                      </div>
                    </div>
                  ) : (
                    <div class="ig-slide-in">
                      {s.kicker && <p class="ig-kicker">{s.kicker}</p>}
                      {s.numero && <span class="ig-numero">{s.numero}</span>}
                      {s.antes && <p class="ig-antes">{s.antes}</p>}
                      {s.destaque && <p class="ig-destaque-num">{s.destaque}</p>}
                      {s.titulo && <p class="ig-titulo" set:html={s.titulo} />}
                      {s.texto && <p class="ig-texto" set:html={s.texto} />}
                      {s.lista && (
                        <ul class="ig-lista">
                          {s.lista.map((item) => <li><iconify-icon icon="solar:check-circle-bold" aria-hidden="true"></iconify-icon>{item}</li>)}
                        </ul>
                      )}
                      {s.etapas && (
                        <ol class="ig-etapas">
                          {s.etapas.map((item, n) => <li><span>{n + 1}</span>{item}</li>)}
                        </ol>
                      )}
                      {s.cta && (
                        <button
                          class="ig-slide-cta"
                          type="button"
                          data-ig-lead={p.id}
                          data-linha={p.linha}
                          data-abre-form
                          data-cta-pos="meio"
                        ><iconify-icon icon="ic:baseline-whatsapp" aria-hidden="true"></iconify-icon>{s.cta}</button>
                      )}
                    </div>
                  )}
                  <span class="ig-coracao" aria-hidden="true"><iconify-icon icon="solar:heart-bold"></iconify-icon></span>
                </div>
              ))}
            </div>
            <button class="ig-seta ig-seta--prev" type="button" data-ig-prev aria-label="Slide anterior" hidden><iconify-icon icon="solar:alt-arrow-left-linear"></iconify-icon></button>
            <button class="ig-seta ig-seta--next" type="button" data-ig-next aria-label="Próximo slide"><iconify-icon icon="solar:alt-arrow-right-linear"></iconify-icon></button>
          </div>

          <div class="ig-post-barra">
            <button class="ig-icone" type="button" data-ig-like aria-pressed="false" aria-label="Curtir"><iconify-icon icon="solar:heart-linear"></iconify-icon></button>
            <button
              class="ig-icone"
              type="button"
              data-ig-lead={p.id}
              data-linha={p.linha}
              data-abre-form
              data-cta-pos="meio"
              aria-label="Enviar mensagem no WhatsApp"
            ><iconify-icon icon="solar:plain-2-linear"></iconify-icon></button>
            <span class="ig-dots" data-ig-dots>
              {p.slides.map((_, i) => <i class={i === 0 ? "is-on" : ""}></i>)}
            </span>
          </div>
          <p class="ig-legenda"><strong>Dani · Templum</strong> {p.legenda}</p>
        </article>
      ))}

      <section class="ig-fim">
        <span class="ig-avatar ig-avatar--xl">
          <img src="/assets/img/lp-iso-9001-mobile/dani-240.jpg" alt="Daniela, sócia da Templum" width="240" height="240" loading="lazy" />
        </span>
        <h2>Ficou alguma dúvida?</h2>
        <p>Me chama no WhatsApp. Em uma conversa rápida você sai com o valor e o prazo para a sua empresa.</p>
        <button
          class="ig-btn ig-btn--primario ig-btn--grande"
          type="button"
          data-ig-lead="fim"
          data-linha={linhaGeral}
          data-abre-form
          data-cta-pos="final"
        ><iconify-icon icon="ic:baseline-whatsapp" aria-hidden="true"></iconify-icon>Falar no WhatsApp</button>
        <p class="ig-fino">A garantia de 200% vale se a empresa concluir todas as etapas do método e, ainda assim, não certificar. A taxa do organismo certificador não está inclusa.</p>
      </section>
    </div>

    <footer class="ig-rodape">
      <img src="/assets/logo/templum.png" alt="Templum Consultoria" width="389" height="129" />
      <p>Certificação ISO com garantia de 200%</p>
      <p><a href="https://templum.com.br">templum.com.br</a> · <a href="https://templum.com.br/politica-de-privacidade">Política de privacidade</a></p>
    </footer>

    <div class="ig-sheet" data-ig-sheet hidden>
      <div class="ig-sheet-fundo" data-ig-fechar></div>
      <div class="ig-sheet-painel" role="dialog" aria-modal="true" aria-labelledby="ig-sheet-titulo">
        <span class="ig-sheet-alca" aria-hidden="true"></span>
        <button class="ig-sheet-x" type="button" data-ig-fechar aria-label="Fechar"><iconify-icon icon="solar:close-circle-linear"></iconify-icon></button>
        <div class="ig-sheet-topo">
          <span class="ig-avatar ig-avatar--sm">
            <img src="/assets/img/lp-iso-9001-mobile/dani-192.jpg" alt="" width="192" height="192" loading="lazy" />
          </span>
          <div>
            <p class="ig-sheet-titulo" id="ig-sheet-titulo">Antes de abrir o WhatsApp</p>
            <p class="ig-sheet-sub">Deixa seus dados para a gente já te atender com a proposta certa.</p>
          </div>
        </div>
        <form class="ig-form" data-trk-event="lead" data-obrigado="/lp/iso-9001-mobile-obrigado/" novalidate>
          <input type="hidden" name="norma" value={norma} />
          <input type="hidden" name="mensagem" value="" data-ig-mensagem />
          <div class="field">
            <label for="ig-nome">Nome</label>
            <input class="input" id="ig-nome" name="nome" autocomplete="name" placeholder="Seu nome" required />
          </div>
          <div class="field">
            <label for="ig-email">E-mail</label>
            <input class="input" id="ig-email" type="email" name="email" autocomplete="email" placeholder="voce@empresa.com" required />
          </div>
          <div class="field">
            <label for="ig-empresa">Empresa</label>
            <input class="input" id="ig-empresa" name="empresa" autocomplete="organization" placeholder="Nome da empresa" required />
          </div>
          <div class="field">
            <label for="ig-cargo">Cargo</label>
            <select class="select" id="ig-cargo" name="cargo" required>
              <option value="">Selecione</option>
              {cargos.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="ig-tel">Telefone / WhatsApp</label>
            <input class="input" id="ig-tel" type="tel" inputmode="numeric" name="telefone" autocomplete="tel" placeholder="(00) 00000-0000" required />
          </div>
          <button type="submit" class="ig-btn ig-btn--primario ig-btn--grande ig-form-enviar"><iconify-icon icon="ic:baseline-whatsapp" aria-hidden="true"></iconify-icon>Abrir o WhatsApp</button>
          <p class="ig-form-priv">Usaremos seus dados para responder à sua solicitação. Consulte nossa <a href="/politica-de-privacidade/">Política de Privacidade</a>.</p>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.querySelector(".ig");
      if (!root) return;

      function evento(nome, dados) {
        try { if (typeof window.gtag === "function") window.gtag("event", nome, dados); } catch (_) {}
        try { (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: nome }, dados)); } catch (_) {}
      }
      function clarityTag(chave, valor) {
        try { if (typeof window.clarity === "function") window.clarity("set", chave, String(valor)); } catch (_) {}
      }

      // Carrosséis: contador, bolinhas, setas e o slide mais longe que a pessoa chegou.
      root.querySelectorAll("[data-ig-post]").forEach(function (post) {
        var id = post.getAttribute("data-ig-post");
        var track = post.querySelector("[data-ig-track]");
        var slides = track.querySelectorAll("[data-ig-slide]");
        var total = slides.length;
        var dots = post.querySelectorAll("[data-ig-dots] i");
        var contador = post.querySelector("[data-ig-contador]");
        var prev = post.querySelector("[data-ig-prev]");
        var next = post.querySelector("[data-ig-next]");
        var ring = root.querySelector('[data-ig-ring="' + id + '"]');
        var atual = 0;
        var maximo = 0;

        function indice() {
          var w = track.clientWidth || 1;
          return Math.max(0, Math.min(total - 1, Math.round(track.scrollLeft / w)));
        }
        function atualizar() {
          var i = indice();
          atual = i;
          contador.textContent = (i + 1) + "/" + total;
          dots.forEach(function (d, n) { d.classList.toggle("is-on", n === i); });
          if (prev) prev.hidden = i === 0;
          if (next) next.hidden = i === total - 1;
          if (i > maximo) {
            maximo = i;
            evento("carrossel_slide", { carrossel: id, slide: i + 1, total: total });
            clarityTag("carrossel_" + id, i + 1);
            if (i === total - 1) {
