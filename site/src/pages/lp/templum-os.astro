<style>
  /* ---------- HERO ---------- */
  .ol-hero { position: relative; background: var(--navy); color: var(--cream); overflow: hidden; padding: clamp(44px, 5.5vw, 76px) 0; }
  .ol-hero-bg { position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(720px 460px at 10% 0%, rgba(255,89,37,0.28), transparent 60%),
                radial-gradient(560px 380px at 100% 100%, rgba(255,89,37,0.14), transparent 60%); }
  /* Áreas, e não ordem de DOM: no desktop a foto entra embaixo do texto e o formulário
     ocupa a coluna inteira; no mobile a sequência vira texto → FORMULÁRIO → foto, porque
     campo abaixo da dobra em LP de tráfego pago é lead perdido. */
  .ol-hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr 0.95fr;
    grid-template-areas: "texto form" "olivia form"; gap: clamp(22px, 3vw, 34px) clamp(30px, 4vw, 58px); align-items: start; }
  .ol-hero-text { grid-area: texto; }
  .ol-hero-olivia { grid-area: olivia; }
  .ol-hero-form { grid-area: form; }
  .ol-hero-text { max-width: 620px; }
  .ol-hero .tag-pill { margin-bottom: 18px; }
  /* O H1 desta versão é mais longo que o anterior (duas frases, uma delas com número):
     o tamanho máximo baixou de 52px para 46px para não estourar quatro linhas no desktop. */
  .ol-hero-title { font-size: clamp(29px, 3.7vw, 46px); font-weight: 800; line-height: 1.08; letter-spacing: -0.03em; color: var(--cream); }
  .ol-hero-sub { font-size: 17px; line-height: 1.6; color: rgba(255,244,221,0.82); margin-top: 18px; max-width: 540px; }
  .ol-hero-sub strong { color: var(--cream); }
  .ol-hero-chips { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(255,244,221,0.14); }
  .ol-chip { display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: rgba(255,244,221,0.82); }
  .ol-chip iconify-icon { color: color-mix(in srgb, var(--orange) 58%, #ffffff); font-size: 18px; }

  /* Foto da Olívia: a mesma da /solucoes-de-ia, recortada na altura para não empurrar o
     formulário para fora da dobra. A fala ao lado existe para a foto não ser decoração —
     ela mostra, em uma linha, o que o produto faz. */
  .ol-hero-olivia { display: flex; align-items: flex-end; gap: 18px; }
  .ol-hero-olivia img { width: 168px; height: 210px; object-fit: cover; object-position: 50% 12%; border-radius: 20px; border: 2px solid rgba(255,89,37,0.55); flex: none; }
  .ol-hero-quote { background: rgba(255,244,221,0.07); border: 1px solid rgba(255,244,221,0.14); border-radius: 16px; padding: 14px 16px; }
  .ol-hero-quote-n { display: block; font-size: 11.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--orange); margin-bottom: 6px; }
  .ol-hero-quote p { font-size: 14.5px; line-height: 1.5; color: rgba(255,244,221,0.9); margin: 0; }
  .ol-hero-form { align-self: start; position: sticky; top: 20px; }
  @media (max-width: 980px) {
    .ol-hero-grid { grid-template-columns: 1fr; grid-template-areas: "texto" "form" "olivia"; }
    .ol-hero-form { position: static; }
    .ol-hero-olivia img { width: 132px; height: 165px; }
  }
  /* Celular: cada pixel do hero antes do formulário é um pixel que o lead precisa rolar.
     Medido em 390x844 — subtítulo e chips ocupavam 312px sozinhos e empurravam o campo
     para fora da dobra. Aqui eles encolhem (sem cortar texto) e o cartão do formulário
     sobe ~110px, entrando na primeira tela junto do título dele. */
  @media (max-width: 600px) {
    .ol-hero { padding-top: 26px; }
    .ol-hero-title { font-size: clamp(26px, 7.2vw, 32px); }
    .ol-hero-sub { font-size: 15.5px; line-height: 1.5; margin-top: 14px; }
    .ol-hero-chips { gap: 8px 16px; margin-top: 16px; padding-top: 14px; }
    .ol-chip { font-size: 12.5px; }
    .ol-chip iconify-icon { font-size: 16px; }
  }

  /* ---------- A FATURA (tabela) ----------
     Tabela larga precisa rolar dentro do próprio contêiner: sem o wrapper com
     overflow-x, o body da página ganha rolagem horizontal no celular. */
  .ol-tab-wrap { margin-top: 42px; overflow-x: auto; -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border); border-radius: var(--r-20); background: var(--surface); }
  .ol-tab { width: 100%; min-width: 780px; border-collapse: collapse; font-size: 14.5px; }
  .ol-tab th { text-align: left; font-size: 11.5px; font-weight: 800; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--text-soft); padding: 16px 18px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .ol-tab td { padding: 16px 18px; border-bottom: 1px solid var(--border); color: var(--text-mid); vertical-align: top; line-height: 1.45; }
  .ol-tab tbody tr:last-child td { border-bottom: 1px solid var(--border); }
  /* Logo no lugar do nome: são as marcas dos próprios fornecedores, em 128px de
     origem renderizados a 34px para ficarem nítidos em tela retina. O nome vive no
     alt e no title — some da tela, não da acessibilidade nem do que o leitor de
     tela e o buscador leem. */
  .ol-tab-logo { display: block; width: 34px; height: 34px; object-fit: contain; border-radius: 7px; }
  .ol-tab-sis { display: block; font-size: 15.5px; font-weight: 800; color: var(--text); letter-spacing: -0.01em; }
  .ol-tab-off { display: inline-flex; align-items: center; gap: 5px; margin-top: 8px; font-size: 11px;
    font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: #c2410c; white-space: nowrap; }
  .ol-tab-off iconify-icon { font-size: 14px; }
  .ol-tab-base { font-size: 13px; color: var(--text-soft); }
  .ol-tab-agora { font-size: 13.5px; }
  .ol-tab-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 700; color: var(--text); }
  .ol-tab-tot td { font-weight: 800; color: var(--text); background: rgba(34,40,49,0.04); font-size: 15px; }
  .ol-tab-nos td { font-weight: 800; font-size: 15.5px; color: #fff; background: var(--orange); border-bottom: 0; }
  .ol-tab-nos .ol-tab-num { color: #fff; }

  /* Bloco da economia: o número que o visitante vai lembrar depois de fechar a aba. */
  .ol-econ { display: flex; align-items: center; gap: clamp(18px, 3vw, 34px); flex-wrap: wrap;
    margin-top: 26px; padding: 26px 28px; border-radius: var(--r-20);
    background: var(--surface); border: 1px solid var(--border); }
  .ol-econ-big { flex: none; }
  .ol-econ-lab { display: block; font-size: 11.5px; font-weight: 800; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--text-soft); margin-bottom: 4px; }
  .ol-econ-big strong { font-size: clamp(30px, 4.4vw, 44px); font-weight: 800; letter-spacing: -0.03em; color: var(--orange); line-height: 1; }
  .ol-econ-txt { flex: 1 1 280px; margin: 0; font-size: 15px; line-height: 1.55; color: var(--text-mid); }
  .ol-econ-txt strong { color: var(--text); }
  .ol-econ .btn { flex: none; }

  .ol-nota { display: flex; gap: 10px; margin: 18px 0 0; font-size: 13px; line-height: 1.55; color: var(--text-soft); }
  .ol-nota iconify-icon { flex: none; font-size: 17px; color: var(--orange); margin-top: 1px; }
  .ol-nota strong { color: var(--text-mid); }

  /* ---------- CALCULADORA ---------- */
  .ol-calc { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: clamp(20px, 3vw, 34px); margin-top: 42px; align-items: start; }
  .ol-calc-rows { display: flex; flex-direction: column; gap: 8px; }
  .ol-calc-row { position: relative; display: grid; grid-template-columns: 26px 1fr auto; align-items: center; gap: 14px;
    padding: 13px 16px; border-radius: var(--r-16); cursor: pointer;
    background: rgba(255,244,221,0.05); border: 1px solid rgba(255,244,221,0.14);
    transition: border-color 0.2s, background 0.2s; }
  .ol-calc-row:hover { border-color: rgba(255,89,37,0.45); }
  /* O checkbox real fica escondido mas focável — o quadrado visível é o irmão seguinte. */
  .ol-calc-row > input[type="checkbox"] { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .ol-calc-box { width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center;
    font-size: 16px; color: transparent; background: rgba(255,244,221,0.08);
    border: 1px solid rgba(255,244,221,0.26); transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .ol-calc-row > input:checked ~ .ol-calc-box { background: var(--orange); border-color: var(--orange); color: #fff; }
  .ol-calc-row > input:focus-visible ~ .ol-calc-box { outline: 2px solid var(--orange); outline-offset: 3px; }
  .ol-calc-nome { font-size: 15px; font-weight: 700; color: var(--cream); line-height: 1.3; }
  .ol-calc-nome em { display: block; font-size: 12.5px; font-weight: 500; font-style: normal; color: rgba(255,244,221,0.5); margin-top: 3px; }
  .ol-calc-inp { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; color: rgba(255,244,221,0.6); }
  .ol-calc-inp input { width: 84px; padding: 8px 10px; border-radius: 10px; font: inherit; font-size: 14.5px;
    font-weight: 700; text-align: right; color: var(--cream); background: rgba(0,0,0,0.22);
    border: 1px solid rgba(255,244,221,0.22); -moz-appearance: textfield; }
  .ol-calc-inp input:focus { outline: 2px solid var(--orange); outline-offset: 1px; }
  .ol-calc-row > input:not(:checked) ~ .ol-calc-inp { opacity: 0.4; }

  .ol-calc-out { position: sticky; top: 20px; padding: 26px 24px; border-radius: var(--r-20);
    background: rgba(255,244,221,0.06); border: 1px solid rgba(255,89,37,0.4); }
  .ol-calc-line { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px solid rgba(255,244,221,0.12); }
  .ol-calc-line span { font-size: 13.5px; color: rgba(255,244,221,0.7); }
  .ol-calc-line strong { font-size: 20px; font-weight: 800; color: var(--cream); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ol-calc-line strong em { font-size: 13px; font-weight: 600; font-style: normal; color: rgba(255,244,221,0.6); }
  .ol-calc-line--sm { padding-bottom: 12px; }
  .ol-calc-line--sm strong { font-size: 15px; color: rgba(255,244,221,0.75); }
  .ol-calc-eco { display: flex; flex-direction: column; gap: 3px; padding: 16px 0 4px; }
  .ol-calc-eco span { font-size: 11.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,244,221,0.6); }
  .ol-calc-eco strong { font-size: clamp(28px, 3.6vw, 38px); font-weight: 800; letter-spacing: -0.03em; color: var(--orange); line-height: 1.05; font-variant-numeric: tabular-nums; }
  .ol-calc-mult { min-height: 20px; margin: 4px 0 16px; font-size: 13px; line-height: 1.5; color: rgba(255,244,221,0.72); }
  .ol-calc-fine { margin: 12px 0 0; font-size: 12px; line-height: 1.45; color: rgba(255,244,221,0.5); }
  @media (max-width: 900px) {
    .ol-calc { grid-template-columns: 1fr; }
    .ol-calc-out { position: static; }
  }
  @media (max-width: 520px) {
    .ol-calc-row { grid-template-columns: 24px 1fr; row-gap: 10px; }
    .ol-calc-inp { grid-column: 2; justify-content: flex-start; }
  }

  /* ---------- O QUE VOCÊ DESLIGA ---------- */
  .ol-agentes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 42px; }
  .ol-agente { display: flex; gap: 14px; align-items: center; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-16); padding: 18px 20px; }
  .ol-agente-ico { width: 44px; height: 44px; flex: none; border-radius: 12px; display: grid; place-items: center; font-size: 22px; color: var(--orange); background: rgba(255,89,37,0.10); }
  .ol-agente-nome { display: block; font-size: 15.5px; font-weight: 800; letter-spacing: -0.01em; line-height: 1.25; }
  .ol-agente-subs { font-size: 13px; line-height: 1.45; color: var(--text-soft); margin: 5px 0 0; }
  .ol-agente-subs em { font-style: normal; font-weight: 700; color: var(--text-mid); }
  @media (max-width: 980px) { .ol-agentes { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .ol-agentes { grid-template-columns: 1fr; } }

  /* ---------- CHAT DA OLÍVIA ---------- */
  .ol-chat-grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(30px, 4vw, 56px); align-items: center; }
  .ol-chat-text h2 { color: var(--cream); }
  .ol-chat-text .paragraph { color: rgba(255,244,221,0.82); }
  .ol-chat { min-width: 0; background: rgba(255,244,221,0.05); border: 1px solid rgba(255,244,221,0.14); border-radius: var(--r-24); padding: 22px; }
  .ol-chat-head { display: flex; align-items: center; gap: 12px; padding-bottom: 16px; margin-bottom: 18px; border-bottom: 1px solid rgba(255,244,221,0.12); }
  .ol-chat-head img { width: 46px; height: 46px; border-radius: 50%; object-fit: cover; object-position: 50% 22%; border: 2px solid var(--orange); }
  .ol-chat-head strong { display: block; font-size: 15px; color: var(--cream); }
  .ol-chat-head span { font-size: 12px; color: rgba(255,244,221,0.55); }
  /* Carrossel de papéis. O track é flex: todos os slides herdam a altura do mais alto,
     então trocar de card não muda a altura do painel (o do CEO tem duas trocas). O
     align-items:center distribui a sobra dos cards de uma troca só em cima e embaixo,
     senão ela virava um vão morto no pé do card. */
  /* min-width:0 é obrigatório aqui: item de grid/flex nasce com min-width:auto, e o
     min-width:100% dos slides inflava a coluna até o card vazar a tela no mobile. */
  .ol-deck, .ol-deck-vp { min-width: 0; }
  .ol-deck-vp { overflow: hidden; }
  .ol-deck-track { display: flex; align-items: center;
    transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1); }
  .ol-slide { flex: 0 0 100%; min-width: 100%; }
  .ol-troca + .ol-troca { margin-top: 14px; }
  .ol-deck-nav { display: flex; align-items: center; justify-content: space-between; gap: 12px;
    margin-top: 18px; padding-top: 15px; border-top: 1px solid rgba(255,244,221,0.12); }
  .ol-arrow { width: 38px; height: 38px; flex: 0 0 38px; border-radius: 50%; display: grid;
    place-items: center; font-size: 18px; cursor: pointer; color: var(--cream);
    background: rgba(255,244,221,0.10); border: 1px solid rgba(255,244,221,0.18);
    transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .ol-arrow:hover { background: var(--orange); border-color: var(--orange); color: #fff; }
  .ol-arrow:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
  .ol-dots { display: flex; align-items: center; gap: 9px; }
  .ol-dot { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 50%; cursor: pointer;
    background: rgba(255,244,221,0.28); transition: background 0.2s, transform 0.2s; }
  .ol-dot[aria-selected="true"] { background: var(--orange); transform: scale(1.3); }
  .ol-dot:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .ol-deck-track { transition: none; } }
  /* Rótulo de quem está perguntando: é ele que transforma a demo em prova de que a
     plataforma serve à empresa inteira, e não a um cargo só. */
  .ol-quem { display: flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 800;
    letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,244,221,0.45);
    margin-bottom: 10px; }
  .ol-quem iconify-icon { font-size: 15px; color: var(--orange); }
  .ol-bolha { font-size: 14px; line-height: 1.5; border-radius: 16px; padding: 11px 14px; margin: 0 0 7px; max-width: 94%; }
  .ol-bolha--eu { background: rgba(255,244,221,0.12); color: var(--cream); margin-left: auto; border-bottom-right-radius: 5px; }
  .ol-bolha--ia { background: var(--orange); color: #fff; border-bottom-left-radius: 5px; }
  .ol-chat .btn { margin-top: 6px; }
  @media (max-width: 980px) { .ol-chat-grid { grid-template-columns: 1fr; } }

  /* ---------- POR QUE CABE NESSE PREÇO ---------- */
  .ol-tres { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 42px; }
  .ol-tres-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-20); padding: 26px 24px; }
  .ol-tres-n { display: inline-block; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; color: var(--orange); margin-bottom: 12px; }
  .ol-tres-card h3 { font-size: 18.5px; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 10px; }
  .ol-tres-card p { font-size: 14.5px; line-height: 1.6; color: var(--text-mid); margin: 0; }
  @media (max-width: 880px) { .ol-tres { grid-template-columns: 1fr; } }

  /* ---------- ANTES / DEPOIS ---------- */
  .ol-vs { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; }
  .ol-vs-col { border-radius: var(--r-20); padding: 26px 24px; border: 1px solid rgba(255,244,221,0.14); background: rgba(255,244,221,0.04); }
  .ol-vs-col h3 { display: flex; align-items: center; gap: 9px; font-size: 17px; font-weight: 800; color: var(--cream); margin-bottom: 16px; }
  .ol-vs-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 11px; }
  .ol-vs-col li { display: flex; gap: 9px; align-items: flex-start; font-size: 14.5px; line-height: 1.5; color: rgba(255,244,221,0.82); }
  .ol-vs-col li iconify-icon { flex: none; font-size: 17px; margin-top: 1px; }
  .ol-vs-bad h3 iconify-icon, .ol-vs-bad li iconify-icon { color: #ff8a6b; }
  .ol-vs-good { border-color: rgba(255,89,37,0.4); }
  .ol-vs-good h3 iconify-icon, .ol-vs-good li iconify-icon { color: color-mix(in srgb, var(--orange) 62%, #ffffff); }
  @media (max-width: 880px) { .ol-vs { grid-template-columns: 1fr; } }

  /* ---------- OBJEÇÕES ---------- */
  .ol-objs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 42px; }
  .ol-obj { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-20); padding: 26px 24px; }
  .ol-obj-ico { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font-size: 22px; color: var(--orange); background: rgba(255,89,37,0.10); margin-bottom: 14px; }
  .ol-obj h3 { font-size: 18px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.3; margin-bottom: 10px; }
  .ol-obj p { font-size: 14.5px; line-height: 1.6; color: var(--text-mid); margin: 0; }
  @media (max-width: 880px) { .ol-objs { grid-template-columns: 1fr; } }

  /* ---------- PREÇO ---------- */
  .ol-preco { margin-top: 40px; padding: clamp(28px, 4vw, 40px); border-radius: var(--r-24);
    background: rgba(255,244,221,0.06); border: 1px solid rgba(255,89,37,0.4); text-align: center; }
  .ol-preco-val { display: flex; align-items: flex-start; justify-content: center; gap: 6px; color: var(--cream); }
  .ol-preco-cifra { font-size: 22px; font-weight: 800; margin-top: 10px; color: var(--orange); }
  .ol-preco-val strong { font-size: clamp(52px, 8vw, 82px); font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .ol-preco-mes { font-size: 18px; font-weight: 700; align-self: flex-end; margin-bottom: 8px; color: rgba(255,244,221,0.7); }
  .ol-preco-lim { margin: 10px 0 26px; font-size: 14.5px; color: rgba(255,244,221,0.72); }
  .ol-preco .check-list { text-align: left; max-width: 520px; margin: 0 auto 26px; }
  .ol-preco .check-item { color: rgba(255,244,221,0.86); }
  .ol-preco-bonus { display: flex; gap: 12px; text-align: left; max-width: 620px; margin: 0 auto 28px;
    padding: 18px 20px; border-radius: var(--r-16); background: rgba(0,0,0,0.18);
    border: 1px solid rgba(255,244,221,0.12); font-size: 14px; line-height: 1.6; color: rgba(255,244,221,0.78); }
  .ol-preco-bonus iconify-icon { flex: none; font-size: 22px; color: var(--orange); }
  .ol-preco-bonus strong { color: var(--cream); }

  /* ---------- PASSOS ----------
     A seção de passos migrou de fundo navy para creme nesta versão (o navy foi para o
     preço, que fecha a página). O modificador --claro troca só as cores. */
  .ol-passos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 42px; }
  .ol-passo { background: rgba(255,244,221,0.05); border: 1px solid rgba(255,244,221,0.14); border-radius: var(--r-20); padding: 26px 24px; }
  .ol-passo-n { display: inline-block; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; color: var(--orange); margin-bottom: 12px; }
  .ol-passo h3 { font-size: 18px; font-weight: 800; color: var(--cream); margin-bottom: 8px; letter-spacing: -0.01em; }
  .ol-passo p { font-size: 14.5px; line-height: 1.55; color: rgba(255,244,221,0.78); margin: 0; }
  .ol-passos--claro .ol-passo { background: var(--surface); border-color: var(--border); }
  .ol-passos--claro .ol-passo h3 { color: var(--text); }
  .ol-passos--claro .ol-passo p { color: var(--text-mid); }
  @media (max-width: 880px) { .ol-passos { grid-template-columns: 1fr; } }

  /* ---------- FAQ EM FUNDO ESCURO ----------
     O global.css estiliza .faq-* para seção clara (.faq-question usa var(--text)), então
     em section--navy o texto sai escuro sobre escuro — ilegível. A LP de financiamento
     resolve com estes mesmos overrides, mas o style do Astro é escopado por componente:
     cada página precisa dos seus. */
  .section--navy .faq-item { border-color: rgba(255,244,221,0.12); }
  .section--navy .faq-question { color: var(--cream); }
  .section--navy .faq-question:hover { color: var(--orange); }
  .section--navy .faq-question .faq-arrow { color: var(--orange); }
  .section--navy .faq-answer { color: rgba(255,244,221,0.72); }

  /* ---------- FORMULÁRIO ---------- */
  .ol-form { padding: clamp(48px, 6vw, 84px) 0; }
  .ol-form-grid { display: grid; grid-template-columns: 1fr 0.9fr; gap: clamp(30px, 4vw, 56px); align-items: center; }
  .ol-form-pitch h2 { color: var(--cream); }
  .ol-form-pitch .paragraph { color: rgba(255,244,221,0.82); margin-bottom: 22px; }
  @media (max-width: 980px) { .ol-form-grid { grid-template-columns: 1fr; } }
</style>

<script define:vars={{ PRECO_MES, PRECO_ANO }}>
  // ---------------------------------------------------------------------------
  // CALCULADORA DE STACK
  // O resultado não fica só na tela: ele é escrito no campo `mensagem` dos
  // formulários da página. O worker leva `mensagem` para o Supabase, para a nota do
  // lead no CRM e para o merge field MENSAGEM do Mailchimp (worker.js:219, 344, 574),
  // então o closer abre a call já sabendo o tamanho da conta — sem precisar de campo
  // novo no CRM nem de mudança no payload do /api/lead.
  // ---------------------------------------------------------------------------
  (function () {
    const calc = document.querySelector(".ol-calc");
    if (!calc) return;

    const rows = Array.from(calc.querySelectorAll(".ol-calc-row"));
    const outMes = calc.querySelector("[data-ol-mes]");
    const outAno = calc.querySelector("[data-ol-ano]");
    const outEco = calc.querySelector("[data-ol-econ]");
    const outMult = calc.querySelector("[data-ol-mult]");
    const btn = calc.querySelector("[data-ol-levar]");

    const brl = (n) => "R$ " + Math.round(n).toLocaleString("pt-BR");

    // O texto do lead é montado aqui e injetado como input hidden `mensagem` em todos
    // os formulários da página (o LeadForm não tem prop para isso, e não precisa ter).
    function gravarNoLead(texto) {
      document.querySelectorAll("form[data-trk-event]").forEach((form) => {
        let campo = form.querySelector('input[name="mensagem"]');
        if (!campo) {
          campo = document.createElement("input");
          campo.type = "hidden";
          campo.name = "mensagem";
          form.appendChild(campo);
        }
        campo.value = texto;
      });
    }

    function recalcular() {
      let mes = 0;
      const itens = [];
      rows.forEach((row) => {
        const on = row.querySelector("[data-ol-on]");
        const val = row.querySelector("[data-ol-val]");
        const nome = row.querySelector(".ol-calc-nome");
        if (!on || !val || !on.checked) return;
        const v = Math.max(0, Number(val.value) || 0);
        mes += v;
        // childNodes[0] é o rótulo; o <em> com os exemplos fica de fora do texto do lead.
        itens.push((nome.childNodes[0].textContent || "").trim() + " R$ " + Math.round(v).toLocaleString("pt-BR"));
      });

      const ano = mes * 12;
      const eco = ano - PRECO_ANO;
      outMes.textContent = brl(mes);
      outAno.textContent = brl(ano);
      outEco.textContent = eco > 0 ? brl(eco) : "—";

      if (mes <= 0) {
        outMult.textContent = "Marque o que você assina hoje para ver a conta.";
      } else if (eco <= 0) {
        outMult.textContent = "Nesse cenário a economia não é o argumento — o ganho aqui é ter tudo na mesma base, com a Olívia em cima. Vale a auditoria mesmo assim.";
      } else {
        const vezes = mes / PRECO_MES;
        outMult.textContent = "Você paga hoje " + vezes.toLocaleString("pt-BR", { maximumFractionDigits: 1 }) +
          "× o valor do Templum OS — e nenhum desses sistemas conversa com o outro.";
      }

      gravarNoLead(
        mes > 0
          ? "STACK INFORMADO NA CALCULADORA: " + itens.join(" · ") +
            " · TOTAL R$ " + Math.round(mes).toLocaleString("pt-BR") + "/mês (R$ " +
            Math.round(ano).toLocaleString("pt-BR") + "/ano)" +
            (eco > 0 ? " · economia estimada R$ " + Math.round(eco).toLocaleString("pt-BR") + "/ano" : "")
          : ""
      );
    }

    calc.addEventListener("change", recalcular);
    calc.addEventListener("input", recalcular);
    if (btn) {
      btn.addEventListener("click", () => {
        recalcular();
        const alvo = document.querySelector("#demonstracao") || document.querySelector("#form");
        if (alvo) {
          alvo.scrollIntoView({ behavior: "smooth", block: "center" });
          const primeiro = alvo.querySelector('input[name="nome"]');
          if (primeiro) setTimeout(() => primeiro.focus({ preventScroll: true }), 520);
        }
      });
    }
    recalcular();
  })();

  // Carrossel de papéis da seção "A Olívia por dentro". Sem autoplay de propósito:
  // é bloco de argumento, quem lê controla o ritmo — e um card que troca sozinho no
  // meio da leitura custa a conversão em vez de ajudar.
  document.querySelectorAll("[data-ol-deck]").forEach((deck) => {
    const track = deck.querySelector("[data-ol-track]");
    const slides = Array.from(deck.querySelectorAll("[data-ol-slide]"));
    const dots = Array.from(deck.querySelectorAll("[data-ol-dot]"));
    if (!track || slides.length < 2) return;

    let i = 0;
    const go = (n) => {
      i = (n + slides.length) % slides.length;
      track.style.transform = "translateX(-" + i * 100 + "%)";
      slides.forEach((s, k) => s.setAttribute("aria-hidden", String(k !== i)));
      dots.forEach((d, k) => d.setAttribute("aria-selected", String(k === i)));
    };

    const prev = deck.querySelector("[data-ol-prev]");
    const next = deck.querySelector("[data-ol-next]");
    if (prev) prev.addEventListener("click", () => go(i - 1));
    if (next) next.addEventListener("click", () => go(i + 1));
    dots.forEach((d, k) => d.addEventListener("click", () => go(k)));

    // Setas do teclado só valem com o foco dentro do carrossel — senão sequestrariam
    // a navegação da página inteira.
    deck.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); go(i - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); go(i + 1); }
    });

    // Arraste no mobile. Só troca se o gesto for claramente horizontal, senão briga
    // com o scroll vertical da página.
    let x0 = null, y0 = null;
    track.addEventListener("touchstart", (e) => {
      x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
    }, { passive: true });
    track.addEventListener("touchend", (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? i + 1 : i - 1);
      x0 = null; y0 = null;
    }, { passive: true });

    go(0);
  });
</script>
