<script>
  // Carrossel de papéis da seção "A Olívia por dentro". Sem autoplay de propósito:
  // é bloco de argumento, quem lê controla o ritmo — e um card que troca sozinho no
  // meio da leitura custa a conversão em vez de ajudar.
  document.querySelectorAll("[data-ol-deck]").forEach((deck) => {
    const track = deck.querySelector("[data-ol-track]");
    const slides = Array.from(deck.querySelectorAll("[data-ol-slide]"));
    const dots = Array.from(deck.querySelectorAll("[data-ol-dot]"));
    if (!track || slides.length < 2) return;

    let i = 0;
    const go = (n) => {
      i = (n + slides.length) % slides.length;
      track.style.transform = "translateX(-" + i * 100 + "%)";
      slides.forEach((s, k) => s.setAttribute("aria-hidden", String(k !== i)));
      dots.forEach((d, k) => d.setAttribute("aria-selected", String(k === i)));
    };

    const prev = deck.querySelector("[data-ol-prev]");
    const next = deck.querySelector("[data-ol-next]");
    if (prev) prev.addEventListener("click", () => go(i - 1));
    if (next) next.addEventListener("click", () => go(i + 1));
    dots.forEach((d, k) => d.addEventListener("click", () => go(k)));

    // Setas do teclado só valem com o foco dentro do carrossel — senão sequestrariam
    // a navegação da página inteira.
    deck.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); go(i - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); go(i + 1); }
    });

    // Arraste no mobile. Só troca se o gesto for claramente horizontal, senão briga
    // com o scroll vertical da página.
    let x0 = null, y0 = null;
    track.addEventListener("touchstart", (e) => {
      x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
    }, { passive: true });
    track.addEventListener("touchend", (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? i + 1 : i - 1);
      x0 = null; y0 = null;
    }, { passive: true });

    go(0);
  });
</script>
