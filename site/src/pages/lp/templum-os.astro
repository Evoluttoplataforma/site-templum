---
// /lp/templum-os — LP de aquisição do Templum OS. Tráfego PAGO (Meta + Google).
//
// ⚠️ REPOSICIONAMENTO — 25/08/2026. A versão anterior desta página vendia
// "sua empresa roda sem depender de você". Promessa não falseável, sem urgência e
// sustentada por três números sem metodologia (40%/85%/65% — o próprio
// PROJETO-AQUISICAO-TEMPLUM-OS.md, §4.3, marca isso como risco CDC/CONAR e de
// reprovação no Meta). Em mercado parado, dor crônica de organização não fecha
// assinatura: dói há dez anos e pode doer dez mais.
//
// A tese desta versão é econômica e datada: a IA não chegou para vender o sétimo
// sistema, chegou para desligar seis. A Templum desligou Pipedrive, RD Station,
// Mailchimp, ClickUp, Sólides e Omie — uma conta de R$ 127.632/ano a preço de
// tabela para 50 pessoas — e ficou com a
// plataforma que ela mesma construiu. Corte de custo se vende em 1 call porque o
// ROI é aritmética, não convencimento; isso ataca de lado o risco R11 do doc
// (venda humana pesada não cabe em ticket de assinatura).
//
// A dor de organização NÃO saiu — foi rebaixada. Custo é a porta de entrada;
// "a empresa roda sem você" é o que aparece depois e é o que sustenta a retenção.
// Vender só preço traz churn de caçador de desconto.
//
// ⚠️ O QUE NÃO PROMETER AQUI: a garantia de 200% é da consultoria de certificação —
// não existe "resultado acordado" em assinatura mensal (doc, seção 3, risco 3). A
// reversão de risco desta página é "cancele quando quiser" + teste gratuito.
import LpBase from "../../layouts/LpBase.astro";
import LeadForm from "../../components/LeadForm.astro";
import ClientLogos from "../../components/ClientLogos.astro";
import DepoimentosTexto from "../../components/DepoimentosTexto.astro";

// ⚠️ cf_produto do CRM é SELECT. Em 24/08/2026 a lista de opções ainda NÃO tem
// "Templum OS" (só "Mini Orbit") — falta criar em CRM → Campos Personalizados →
// Produto. Enquanto não existir, o CRM recusa este valor e o lead entra sem o campo
// Produto preenchido. O resto (cargo, faixa de funcionários, página de conversão e
// UTM) sobrevive: o saveToOrbit passou a ter um fallback que descarta só o cf_produto
// antes de recorrer a descartar todos os campos personalizados (worker.js,
// "Fallback 1"). Sem esse fallback, um valor fora da lista cegava o UTM da campanha.
// O nome casa com o funil do CRM, que já se chama TEMPLUM OS.
const CRM_PRODUTO = "Templum OS";

// ---------------------------------------------------------------------------
// PREÇO E MEMÓRIA DE CÁLCULO — o número é o produto desta página, então ele fica
// em constante única e é reusado em copy, tabela, calculadora e schema. Mudou o
// preço? Muda aqui.
// ---------------------------------------------------------------------------
const PRECO_MES = 1998;              // R$/mês, fixo até 50 usuários
const PRECO_ANO = PRECO_MES * 12;    // R$ 23.976
const LIMITE_USUARIOS = 50;

// A fatura de referência. ⚠️ LEIA ANTES DE PUBLICAR:
// - O desligamento dos seis é REAL. O número da manchete é o TOTAL DESTA TABELA
//   (faturaAno), não a nota fiscal da Templum — decisão de 25/08/2026: manchete e
//   tabela têm de bater, senão o leitor pergunta de onde saiu o número.
// - Os valores linha a linha NÃO são a nota fiscal da Templum: são preço público de
//   tabela dos fornecedores, dimensionado para uma empresa de 50 pessoas (o mesmo
//   corte do preço fixo do Templum OS, para a comparação ficar maçã com maçã).
//   Isso está dito na página, em letra visível, de propósito — número de custo sem
//   memória de cálculo é o tipo de coisa que o lead confere na call.
// - Câmbio usado: R$ 5,50/US$. Fontes (ago/2026): Pipedrive Professional US$ 49/
//   usuário/mês anual; ClickUp Business US$ 12/usuário/mês anual; RD Station
//   Marketing Pro a partir de R$ 1.499/mês; Mailchimp Standard ~US$ 135/mês em 10 mil
//   contatos; Omie Avançado R$ 295/mês (5 usuários) + módulos; Sólides sob consulta
//   (faixa de mercado por colaborador).
// - Rodrigo: confira cada linha contra a fatura real antes do deploy. Se alguma
//   estourar ou faltar, o ajuste é só aqui.
const fatura = [
  { sistema: "Pipedrive",            logo: "pipedrive", cat: "CRM e funil de vendas",   base: "US$ 49 por usuário/mês · 10 comerciais", mes: 2695, agora: "CRM, funil, atividades e coaching comercial" },
  { sistema: "ClickUp",              logo: "clickup",   cat: "Tarefas, projetos e prazos", base: "US$ 12 por usuário/mês · 50 usuários",  mes: 3300, agora: "Projetos, fases, tarefas, checklists e automações" },
  { sistema: "RD Station Marketing", logo: "rdstation", cat: "Automação de marketing",  base: "Plano Pro, a partir de R$ 1.499/mês",    mes: 1499, agora: "Landing pages, réguas de relacionamento e WhatsApp" },
  { sistema: "Mailchimp",            logo: "mailchimp", cat: "E-mail marketing",        base: "Standard · base de 10 mil contatos",     mes: 742,  agora: "Disparo e sequência de e-mail na mesma base do CRM" },
  { sistema: "Sólides",              logo: "solides",   cat: "RH e gestão de pessoas",  base: "Sob consulta · faixa por colaborador",   mes: 1500, agora: "Cargos, avaliação, PDI, teste comportamental e recrutamento" },
  { sistema: "Omie",                 logo: "omie",      cat: "ERP e financeiro",        base: "Avançado R$ 295/mês + módulos",          mes: 900,  agora: "Contas a pagar e receber, DRE, fluxo de caixa, NF-e e NFS-e" },
];
const faturaMes = fatura.reduce((s, f) => s + f.mes, 0);   // R$ 10.636
const faturaAno = faturaMes * 12;                          // R$ 127.632
const economiaAno = faturaAno - PRECO_ANO;                 // R$ 103.656
const porPessoa = PRECO_MES / LIMITE_USUARIOS;             // R$ 39,96
const brl = (n) => n.toLocaleString("pt-BR", { maximumFractionDigits: 0 });

// O que a plataforma cobre, escrito na chave "o que sai da sua conta". Substituiu a
// lista de agentes na dor: com a tese de consolidação, o leitor não quer saber o nome
// do agente, quer saber qual assinatura ele cancela. NÃO cravar número de agentes nem
// de módulos em copy: a plataforma ganha função nova quase toda semana.
const desliga = [
  { icon: "mdi:handshake-outline",              modulo: "CRM e vendas",                 subs: "Pipedrive, RD Station CRM, HubSpot" },
  { icon: "solar:checklist-minimalistic-bold",  modulo: "Tarefas, projetos e prazos",   subs: "ClickUp, Asana, Monday, Trello" },
  { icon: "solar:wallet-money-bold",            modulo: "Financeiro, DRE, NF-e e NFS-e", subs: "Omie, Conta Azul, Bling" },
  { icon: "solar:letter-opened-bold",           modulo: "E-mail, landing page e régua", subs: "RD Station, Mailchimp" },
  { icon: "solar:users-group-rounded-bold",     modulo: "RH, avaliação, PDI e vaga",    subs: "Sólides, Gupy" },
  { icon: "solar:square-academic-cap-bold",     modulo: "Treinamento e trilha (LMS)",   subs: "plataforma de EAD avulsa" },
  { icon: "solar:videocamera-record-bold",      modulo: "Reunião, transcrição e ata",   subs: "Zoom + Fireflies / Otter" },
  { icon: "solar:document-add-bold",            modulo: "Documento e assinatura eletrônica", subs: "Drive solto + DocuSign / Clicksign" },
  { icon: "solar:chart-2-bold",                 modulo: "Indicadores e painel",         subs: "Power BI + planilha" },
  { icon: "solar:shield-check-bold",            modulo: "Processos, riscos e auditoria", subs: "software de SGI + planilha" },
  { icon: "solar:chat-round-dots-bold",         modulo: "Chat interno da equipe",       subs: "Slack" },
  { icon: "solar:cart-large-2-bold",            modulo: "Compras, cotação e fornecedor", subs: "planilha + caixa de e-mail" },
  { icon: "solar:health-bold",                  modulo: "SESMT: ASO, EPI, CIPA, acidente", subs: "sistema de SST avulso" },
  { icon: "solar:headphones-round-bold",        modulo: "Chamado interno e suporte",    subs: "Zendesk, Movidesk" },
];

// Linhas da calculadora. Mesmos valores da fatura de referência — o visitante edita
// o que for diferente na realidade dele. O resultado vai para o campo `mensagem` do
// lead (worker.js: `mensagem` → Supabase + nota no CRM + MENSAGEM no Mailchimp), ou
// seja: o closer abre a call já sabendo o tamanho da conta.
const calc = [
  { id: "crm",  nome: "CRM / funil de vendas",        exemplo: "Pipedrive, HubSpot, RD CRM", val: 2695 },
  { id: "task", nome: "Gestão de tarefas e projetos", exemplo: "ClickUp, Monday, Asana",     val: 3300 },
  { id: "mkt",  nome: "Automação de marketing",       exemplo: "RD Station, HubSpot",        val: 1499 },
  { id: "mail", nome: "E-mail marketing",             exemplo: "Mailchimp, ActiveCampaign",  val: 742 },
  { id: "rh",   nome: "RH e gestão de pessoas",       exemplo: "Sólides, Gupy",              val: 1500 },
  { id: "erp",  nome: "ERP / financeiro",             exemplo: "Omie, Conta Azul, Bling",    val: 900 },
  { id: "doc",  nome: "Assinatura eletrônica e GED",  exemplo: "DocuSign, Clicksign",        val: 350 },
  { id: "bi",   nome: "BI / painel de indicadores",   exemplo: "Power BI, Looker",           val: 400 },
];

// Demonstração do que a Olívia responde. Cinco interações, uma por PAPEL — e o papel
// aparece na tela de propósito: a objeção silenciosa de quem chega do anúncio é "isso é
// ferramenta de dono" ou "isso é coisa da qualidade". Mostrar o operador perguntando pelo
// WhatsApp e o gerente cobrando pendência é o que faz o leitor entender que a plataforma
// atende a empresa inteira, não um cargo.
// A interação da análise crítica foi demonstrada ao vivo na live de 19/08/2026.
// Carrossel de papéis: um card por vez, trocado por seta. Empilhar cinco diálogos
// fazia o visitante rolar tudo sem nenhum ganhar destaque; separado por cargo, ele
// reconhece o próprio papel. CEO/Proprietário leva duas trocas porque a pergunta do
// dono e a do diretor ("o que um auditor encontraria") são o mesmo cargo na prática.
const conversa = [
  {
    papel: "CEO / Proprietário",
    canal: "pelo painel",
    icon: "solar:crown-bold",
    trocas: [
      {
        p: "Quais indicadores fecharam fora da meta neste trimestre?",
        r: "Três: prazo de entrega (‑8%), retrabalho na produção (+12%) e satisfação do cliente (‑4 pts). O de retrabalho vem piorando há 4 meses — abri a análise de causa raiz e sugeri 2 ações.",
      },
      {
        p: "Por que o retrabalho subiu se a produção não mudou?",
        r: "O treinamento do novo procedimento está com 3 de 11 operadores concluídos, e as duas ocorrências desta semana são do turno com menor conclusão. Nenhum dos seus sistemas antigos cruzava esses dois dados.",
      },
    ],
  },
  {
    papel: "Gerente de área",
    canal: "pelo painel",
    icon: "solar:clipboard-check-bold",
    trocas: [
      {
        p: "O que ficou pendente da reunião da minha área?",
        r: "Quatro ações: duas concluídas, uma vence hoje (revisar o fluxo de compras, com o Marcelo) e uma atrasada há 9 dias (treinar o time no novo procedimento). Quer que eu cobre os responsáveis agora?",
      },
    ],
  },
  {
    papel: "Funcionário",
    canal: "pelo WhatsApp",
    icon: "mdi:account-hard-hat",
    trocas: [
      {
        p: "Como faço a troca de setup da linha 2? Não achei o procedimento.",
        r: "É a instrução IT‑014, revisão 3. São 6 passos; o crítico é o terceiro (travar o fuso antes de soltar o mandril). Te manda em áudio ou por escrito? Ah — a versão que está na sua pasta é a antiga, use esta.",
      },
    ],
  },
  {
    papel: "Financeiro",
    canal: "pelo painel",
    icon: "solar:wallet-money-bold",
    trocas: [
      {
        p: "Fecha o caixa da semana e me diz o que vence até sexta.",
        r: "Entrou R$ 184 mil, saiu R$ 122 mil. Até sexta vencem 9 contas (R$ 41 mil) e 3 recebimentos estão atrasados há mais de 15 dias — dois deles do mesmo cliente, que também tem um negócio aberto no funil de vendas.",
      },
    ],
  },
  {
    papel: "Qualidade",
    canal: "pelo painel",
    icon: "solar:verified-check-bold",
    trocas: [
      {
        p: "Prepare a análise crítica pela direção deste semestre.",
        r: "Levantei os 12 insumos do requisito 9.3: tenho 9 completos, 3 com lacuna de dado. Trouxe a tendência de cada indicador e uma saída sugerida por item — em vez de só o número do mês.",
      },
    ],
  },
];

const semOlivia = [
  "Seis assinaturas, seis logins, seis faturas",
  "Cada sistema cobra por cabeça — cresceu o time, subiu a conta",
  "A IA vem como add-on, cobrada por usuário e por token",
  "Nenhum dos seis sabe o que acontece no outro",
  "Relatório é exportar planilha de cada um e cruzar à mão",
  "Renovação chega com reajuste e você descobre em fevereiro",
];
const comOlivia = [
  "Uma assinatura, um login, uma fatura",
  `R$ ${brl(PRECO_MES)} por mês fixo até ${LIMITE_USUARIOS} usuários`,
  "IA inclusa: sem cobrança por agente e sem cobrança por token",
  "Um banco de dados só — o dado de vendas conversa com o de produção",
  "A Olívia responde a pergunta em vez de você montar o relatório",
  "Sem fidelidade: você cancela quando quiser",
];

const objecoes = [
  {
    icon: "solar:database-bold",
    q: "“Vou perder o histórico do meu CRM.”",
    a: "Não. Cliente, contato, negócio e conta a receber entram por importação, e o histórico antigo é anexado ao registro. Na prática o sistema velho continua ligado em paralelo até você conferir que está tudo aqui — só então cancela.",
  },
  {
    icon: "solar:users-group-two-rounded-bold",
    q: "“Meu time acabou de aprender o sistema atual.”",
    a: "Trocar ferramenta só compensa se o ganho for grande, e é por isso que a adoção aqui não depende de treinar 50 pessoas num painel novo: quem não gosta de abrir sistema pergunta e responde pelo WhatsApp, com a Olívia do outro lado.",
  },
  {
    icon: "solar:layers-bold",
    q: "“Um sistema só não é pior que seis especialistas?”",
    a: "Em recurso de ponta, às vezes é. Em decisão, não: nenhum dos seis sabia que o retrabalho subiu porque o treinamento não foi aplicado. Se a sua empresa usa 100% de um CRM avançado, você não é nosso cliente — e a gente diz isso na auditoria.",
  },
  {
    icon: "solar:calendar-mark-bold",
    q: "“Preciso desligar tudo de uma vez?”",
    a: "Não, e não recomendamos. Começa pelos dois sistemas mais caros, roda 30 dias em paralelo e desliga. O resto sai ao longo de 90 dias, na ordem que a auditoria mostrar que dá mais economia com menos risco.",
  },
];

const passos = [
  { n: "01", t: "Auditoria do seu stack (30 min)", d: "Você manda a lista do que paga hoje — sistema, plano e valor. A gente devolve, na tela, o que sai da sua conta, o que fica de fora e quanto sobra por ano. Sem proposta nessa conversa." },
  { n: "02", t: "A Olívia rodando no seu cenário", d: "O especialista cria a sua organização na plataforma e roda os agentes com o contexto da SUA empresa: processos, indicadores, funil, financeiro. Não é conta de demonstração." },
  { n: "03", t: "Teste com o seu time e plano de desligamento", d: "Você usa com a equipe antes de decidir e sai com o cronograma de 90 dias: o que desliga primeiro, o que roda em paralelo, o que migra. Se não fizer sentido, encerra." },
];

const faqs = [
  { q: "Quanto custa, exatamente?", a: `R$ ${brl(PRECO_MES)} por mês, fixo para até ${LIMITE_USUARIOS} usuários — não cobramos por assento, então entrar com 12 ou com ${LIMITE_USUARIOS} pessoas custa o mesmo. Não há cobrança por token de IA nem por agente: todos estão inclusos. Não há fidelidade — você cancela quando quiser. Acima de ${LIMITE_USUARIOS} usuários existe faixa por porte, e o especialista confirma a sua na auditoria.` },
  { q: "O que exatamente eu consigo desligar?", a: "Depende do que você paga hoje. Na prática a plataforma cobre CRM e funil, tarefas e projetos, financeiro com emissão de NF-e e NFS-e, e-mail e landing page, RH com avaliação e recrutamento, treinamento, reunião com transcrição, documento com assinatura eletrônica, indicadores, processos e riscos, compras, SESMT, chamado interno e chat da equipe. A auditoria existe justamente para separar o que sai da sua conta do que não sai — e a gente diz o que não sai." },
  { q: "Vou perder o histórico dos sistemas que eu cancelar?", a: "Não. Clientes, contatos, negócios, contas a pagar e a receber entram por importação, e o histórico antigo fica anexado ao registro. O sistema atual continua ligado em paralelo enquanto você confere; só depois disso o cancelamento acontece. Ninguém desliga nada no dia da assinatura." },
  { q: "Um sistema só não é pior que seis especialistas?", a: "Em recurso de ponta, às vezes é — e a gente fala isso abertamente. Mas o ganho aqui não é a função isolada, é o dado no mesmo lugar: nenhum dos seis sistemas que a Templum pagava sabia que o retrabalho subiu porque o treinamento não tinha sido aplicado. Se a sua operação usa a fundo um sistema muito específico, esse é o caso de manter só ele e desligar os outros." },
  { q: "A Templum realmente desligou esses sistemas?", a: `Sim — Pipedrive, RD Station, Mailchimp, ClickUp, Sólides e Omie saíram da nossa operação. A conta desses seis, a preço público de tabela para uma empresa de ${LIMITE_USUARIOS} pessoas, é de R$ ${brl(faturaAno)} por ano. A plataforma que você vai ver na demonstração é a mesma que roda a Templum todos os dias, e hoje ela está em mais de 200 empresas.` },
  { q: "Quem é a Olívia, exatamente?", a: "É a IA central do Templum OS. Ela coordena os agentes, conhece todo o seu sistema de gestão (processos, indicadores, documentos, tarefas, funil, financeiro) e responde por chat na plataforma e pelo WhatsApp. Na prática é o segundo cérebro da empresa — e é a parte que nenhum conjunto de sistemas separados entrega, porque ela só funciona com tudo no mesmo banco de dados." },
  { q: "Preciso querer certificação ISO para usar o Templum OS?", a: "Não. A plataforma nasceu do método que a Templum usa em certificação há mais de 30 anos, mas ela existe para organizar a gestão. O efeito colateral é útil: se um dia um cliente exigir ISO 9001 no contrato, o caminho já está quase todo andado — em vez de começar da estaca zero com prazo em cima." },
  { q: "Minha equipe é pequena e nada é documentado. Dá para começar assim?", a: "É o cenário mais comum. Você não precisa chegar organizado: os agentes geram a primeira versão do planejamento, do mapa de processos, das instruções de trabalho e dos indicadores a partir do contexto da sua empresa — e você edita o que não fizer sentido. Começar do zero aqui é mais rápido do que partir de planilhas antigas." },
  { q: "Quanto tempo leva para estar rodando?", a: "A primeira estrutura (planejamento, departamentos, processos e indicadores) sai na própria demonstração, em minutos. O que leva tempo é a adoção pelo time — e é por isso que o teste acontece com a sua equipe dentro, não só com você." },
  { q: "Meus dados ficam seguros?", a: "Sim. A plataforma é da própria Templum, com controle de acesso por usuário e organização, e o tratamento de dados segue a LGPD. Cada organização é isolada: o que você cria não é visível para nenhum outro cliente." },
  { q: "Serve para mais de uma empresa ou unidade?", a: "Serve. A plataforma é multiorganização: grupos, filiais e unidades podem ter cada um o seu ambiente, e quem administra transita entre eles. Consultores usam exatamente esse recurso para atender vários clientes." },
];

const schemaSoftware = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Templum OS",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Plataforma de gestão com agentes de inteligência artificial coordenados pela Olívia. Reúne CRM, tarefas e projetos, financeiro, marketing, RH, treinamento, documentos, indicadores, processos e riscos em uma assinatura só, substituindo o conjunto de sistemas avulsos da empresa.",
  offers: { "@type": "Offer", price: String(PRECO_MES) + ".00", priceCurrency: "BRL", availability: "https://schema.org/InStock" },
  provider: { "@type": "Organization", name: "Templum Consultoria", url: "https://templum.com.br" },
  audience: { "@type": "Audience", audienceType: "Donos de empresa, diretores, financeiro e profissionais da qualidade" },
};

const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<LpBase
  title={`Templum OS — troque 6 sistemas por 1 e corte mais de R$ 100 mil por ano | Templum`}
  description={`A Templum desligou Pipedrive, RD Station, Mailchimp, ClickUp, Sólides e Omie — uma conta de R$ ${brl(faturaAno)} por ano. No lugar ficou o Templum OS: gestão com agentes de IA por R$ ${brl(PRECO_MES)}/mês, fixo até ${LIMITE_USUARIOS} usuários.`}
  formAnchor="#demonstracao"
  headerCta="Auditoria do meu stack"
  schemas={[schemaSoftware, schemaFaq]}
>
  <!-- HERO — a fatura na primeira dobra, form à direita no desktop -->
  <section class="ol-hero">
    <div class="ol-hero-bg" aria-hidden="true"></div>
    <div class="container xl ol-hero-grid">
      <div class="ol-hero-text">
        <span class="tag-pill tag-pill--glow"><iconify-icon icon="solar:cpu-bolt-bold"></iconify-icon> Templum OS · Olívia</span>
        <h1 class="ol-hero-title"><em class="accent">R$ {brl(faturaAno)} por ano</em> em seis sistemas. Ou R$ {brl(PRECO_MES)} por mês em um só.</h1>
        <p class="ol-hero-sub">
          Pipedrive, RD Station, Mailchimp, ClickUp, Sólides e Omie saíram da nossa conta — todos
          <strong>desligados</strong>. No lugar ficou o <strong>Templum OS</strong>: a plataforma de gestão com
          agentes de inteligência artificial que a Templum construiu para si mesma e que hoje roda em
          <strong>mais de 200 empresas</strong>.
        </p>
        <div class="ol-hero-chips">
          <span class="ol-chip"><iconify-icon icon="solar:check-circle-bold"></iconify-icon> Preço fixo até {LIMITE_USUARIOS} usuários</span>
          <span class="ol-chip"><iconify-icon icon="solar:check-circle-bold"></iconify-icon> IA inclusa, sem cobrança por token</span>
          <span class="ol-chip"><iconify-icon icon="solar:check-circle-bold"></iconify-icon> Sem fidelidade</span>
        </div>
      </div>

      <div class="ol-hero-olivia">
