---
import CampanhaIsolada from "../layouts/CampanhaIsolada.astro";

const WPP =
  "https://wa.me/551926603087?text=Quero%20confirmar%20minha%20inscri%C3%A7%C3%A3o%20no%20M%C3%AAs%20da%20Qualidade%20da%20Templum%20Consultoria";
---

<CampanhaIsolada
  title="Falta um passo para garantir sua vaga | Mês da Qualidade Templum 2026"
  description="Confirme sua inscrição pelo WhatsApp. É por lá que você recebe o link de cada encontro da Imersão."
>
  <div class="lp-nova">
    <header class="header">
      <div class="header-inner">
        <a href="/mes-da-qualidade-2026-v2/" aria-label="Voltar para a página do Mês da Qualidade">
          <img class="logo-templum" src="/assets/logo/templum.png" alt="Templum" width="389" height="129" />
        </a>
      </div>
    </header>

    <main class="ob-main">
      <article class="ob-card">
        <div class="ob-check" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12.5l4.2 4.2L19 7"/></svg>
        </div>
        <p class="kicker">Mês da Qualidade 2026 · Imersão prática</p>
        <h1 id="ob-title">Falta um passo para garantir sua vaga.</h1>
        <p class="lede">Confirme sua inscrição pelo WhatsApp. É por lá que você recebe o link de cada encontro da Imersão.</p>
        <div class="ob-progress" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100" aria-label="Inscrição 80% concluída">
          <div class="ob-progress__track"><div class="ob-progress__fill"></div></div>
          <p class="ob-progress__label">80%</p>
        </div>
        <ul class="ob-facts">
          <li><strong>3 a 5 de novembro, às 16h (horário de Brasília)</strong></li>
          <li>Online e gratuito</li>
        </ul>
        <div class="ob-cta">
          <a
            id="ob-wpp"
            class="btn-wpp"
            data-wpp-fixo="1"
            data-trk-cta="confirmacao_whatsapp"
            href={WPP}
            target="_blank"
            rel="noopener"
