---
import CampanhaIsolada from "../layouts/CampanhaIsolada.astro";

const WPP =
  "https://wa.me/551926603087?text=Quero%20confirmar%20minha%20inscri%C3%A7%C3%A3o%20no%20M%C3%AAs%20da%20Qualidade%20(MQ26)";
---

<CampanhaIsolada
  title="Falta um passo para garantir sua vaga | Mês da Qualidade Templum 2026"
  description="Confirme sua inscrição pelo WhatsApp. É por lá que você recebe o link de cada encontro da Imersão."
