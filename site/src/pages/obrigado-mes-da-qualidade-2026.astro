            <figcaption>Está no computador? Aponte a câmera do celular.</figcaption>
          </figure>
        </div>
        <p class="ob-hint">As instruções também chegam por e-mail.</p>
        <p><a class="ob-back" href="/mes-da-qualidade-2026-v2/">Voltar para a página</a></p>
      </article>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <img class="logo-templum" src="/assets/logo/templum.png" alt="Templum" width="389" height="129" />
        <p>© 2026 Templum Consultoria Digital LTDA. · CNPJ 00.198.308/0001-93</p>
      </div>
    </footer>
  </div>

  <script is:inline>
    (function () {
      var raw = null;
      try { raw = sessionStorage.getItem("tpl_lead_pending"); } catch (_) {}
      var d = {};
      if (raw) {
        try { sessionStorage.removeItem("tpl_lead_pending"); } catch (_) {}
        try { d = JSON.parse(raw) || {}; } catch (_) {}
        var primeiro = String(d.name || "").trim().split(/\s+/)[0].replace(/[.,;:]+$/g, "");
        if (primeiro) {
          var h = document.getElementById("ob-title");
          if (h) h.textContent = "Falta um passo, " + primeiro + ".";
        }
      }
      var btn = document.getElementById("ob-wpp");
      if (btn) {
        btn.addEventListener("click", function () {
          try {
            if (typeof window.gtag === "function") {
              window.gtag("event", "confirmacao_whatsapp", {
                event_category: "engagement",
                event_label: "mq26_whatsapp"
              });
            }
          } catch (_) {}
          try {
            if (window.trk && typeof window.trk.track === "function") {
              window.trk.track("CTAClick", { cta: "confirmacao_whatsapp", href: btn.href });
            }
          } catch (_) {}
        });
      }
      if (!raw) return;
      var done = false;
      function fire() {
        if (done) return; done = true;
        try { if (window.trk && typeof window.trk.lead === "function") window.trk.lead({ email: d.email, phone: d.phone, name: d.name }); } catch (_) {}
      }
      var n = 0, t = setInterval(function () {
        n++;
        var ready = window.trk && typeof window.trk.lead === "function";
        if (ready || n > 60) { clearInterval(t); fire(); }
      }, 250);
    })();
  </script>

<style is:global>
  .lp-nova {
    --ink: #fff4dd;
    --muted: rgba(255, 244, 221, 0.72);
    --line: rgba(255, 244, 221, 0.14);
    --orange: #ff5925;
    --orange-ink: #b23c0c;
    --navy: #222831;
    min-height: 100vh;
    color: var(--ink);
    font-family: Barlow, "Segoe UI", sans-serif;
    background: var(--navy);
    line-height: 1.5;
  }
  .lp-nova *,
  .lp-nova *::before,
  .lp-nova *::after { box-sizing: border-box; }
  .lp-nova img { max-width: 100%; height: auto; display: block; }
  .lp-nova a { color: inherit; text-decoration: none; }
  .lp-nova h1 { margin: 0; letter-spacing: -0.03em; line-height: 1.08; }
  .lp-nova p { margin: 0; }
  .wrap { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(34, 40, 49, 0.94);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    min-height: 72px;
    display: flex;
    align-items: center;
  }
  .logo-templum { width: 132px; height: auto; filter: brightness(0) invert(1); }
  .kicker {
    display: inline-flex;
    margin-bottom: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff4dd;
    color: var(--orange-ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .ob-main { padding: 48px 0 72px; background: var(--navy); min-height: 70vh; }
  .ob-card {
    width: min(680px, calc(100% - 40px));
    margin: 0 auto;
    padding: 32px 24px;
    background: #fff;
    color: #18191b;
    border-radius: 28px;
    text-align: center;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
  }
  .ob-check {
    width: 56px;
    height: 56px;
    margin: 0 auto 14px;
    border-radius: 50%;
    background: var(--orange);
    color: #fff;
    display: grid;
    place-items: center;
  }
  .ob-check svg { width: 28px; height: 28px; }
  .ob-card h1 { font-size: clamp(34px, 5vw, 48px); }
  .ob-card .lede { margin: 14px auto 0; color: #3f424b; }
  .ob-facts { margin: 22px 0 0; padding: 0; list-style: none; color: #18191b; }
  .ob-facts li + li { margin-top: 6px; }
  .ob-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-top: 22px;
  }
  .btn-wpp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    background: #128c7e;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .btn-wpp:hover { background: #0e7468; }
  .ob-qr { display: none; margin: 0; }
  .ob-qr svg { width: 132px; height: 132px; background: #fff; border-radius: 12px; }
  .ob-qr figcaption { max-width: 148px; margin-top: 8px; color: #3f424b; font-size: 13px; line-height: 1.35; }
  @media (min-width: 960px) {
    .ob-cta { flex-direction: row; justify-content: center; align-items: center; gap: 28px; }
    .ob-qr { display: block; }
  }
  .ob-hint { margin-top: 14px; color: #3f424b; font-size: 15px; }
  .ob-back { display: inline-block; margin-top: 14px; color: var(--orange-ink); font-weight: 700; }
  .footer { padding: 28px 0 36px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  .footer-inner { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; }
  .footer .logo-templum { width: 110px; }
</style>
</CampanhaIsolada>
