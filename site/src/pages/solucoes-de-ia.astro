<script>
  // Toggle mensal/anual. Os valores já vêm renderizados em data-* no HTML (fonte:
  // src/data/planos-os.js), então o script só troca texto — nenhuma conta é feita
  // no cliente e não existe preço digitado em dois lugares.
  const btnMensal = document.getElementById("plMensal");
  const btnAnual = document.getElementById("plAnual");
  const grid = document.getElementById("plGrid");

  if (btnMensal && btnAnual && grid) {
    const aplicar = (anual) => {
      btnMensal.setAttribute("aria-pressed", String(!anual));
      btnAnual.setAttribute("aria-pressed", String(anual));

      grid.querySelectorAll(".pl-card").forEach((card) => {
        const de = card.querySelector(".pl-de");
        const num = card.querySelector(".pl-num");
        const ciclo = card.querySelector(".pl-ciclo");
        const equiv = card.querySelector(".pl-equiv");
        const pp = card.querySelector(".pl-seat-pp");

        de.textContent = anual ? de.dataset.deAnual : "";
        equiv.textContent = anual ? equiv.dataset.equivAnual : "";
        num.textContent = anual ? num.dataset.anual : num.dataset.mensal;
        ciclo.textContent = anual ? ciclo.dataset.cicloAnual : ciclo.dataset.cicloMensal;
        pp.textContent = anual ? pp.dataset.ppAnual : pp.dataset.ppMensal;
      });
    };

    btnMensal.addEventListener("click", () => aplicar(false));
    btnAnual.addEventListener("click", () => aplicar(true));
  }
</script>
