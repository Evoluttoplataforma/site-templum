---
// /solucoes-de-ia — PÁGINA DE PLANOS E PREÇOS do Templum OS.
//
// ⚠️ REPOSICIONAMENTO — 27/08/2026. A versão anterior desta URL era institucional
// ("Uma certificação ISO guiada por tecnologia" + hub dos agentes) e terminava em
// "agendar demonstração". Era uma página de ISO com o nome de Templum OS, e o
// PROJETO-AQUISICAO-TEMPLUM-OS.md (§2.1) aponta isso como o buraco do vertical:
// não existia nenhum ativo que vendesse o Templum OS como produto.
//
// Agora esta URL é a página de PREÇO, no padrão de SaaS (RD Station, Pipedrive,
// Omie): o preço aparece na tela, sem formulário no meio do caminho. É ela que o
// comercial manda para quem pede orçamento, e é o destino do item "Templum OS" no
// menu. Quem quiser testar entra sozinho em app.templum.com.br/register.
//
// DIVISÃO DE PAPEL COM A /lp/templum-os:
//   /lp/templum-os   → tráfego PAGO, tese de corte de custo, captura em formulário.
//   /solucoes-de-ia  → quem JÁ quer comprar: planos, o que cada um inclui, teste.
// Preço e stack vêm dos MESMOS arquivos de dados nas duas, de propósito.
//
// ⚠️ O QUE NÃO PROMETER AQUI: garantia de 200% (é da consultoria de certificação,
// não existe em assinatura) e número fixo de agentes de IA (a lista cresce).
import Base from "../layouts/Base.astro";
import ClientLogos from "../components/ClientLogos.astro";
import { planosCalc, brl, brl2, APP_REGISTER } from "../data/planos-os.js";
import { fatura, faturaMes, faturaAno } from "../data/stack-os.js";

const essencial = planosCalc[0];
// A comparação com o stack usa o preço MENSAL do Essencial (decisão de 27/08/2026):
// o cliente compara com a fatura mensal que ele já paga, e comparar mensal com mensal
// dispensa nota de rodapé. O desconto anual continua aparecendo nos cards, onde ele é
// uma escolha — não embutido no número de manchete.
const economiaStackMes = faturaMes - essencial.mes;
const economiaStackAno = faturaAno - essencial.anoCheio;
const vezesMaisCaro = Math.floor(faturaMes / essencial.mes);

// O que a assinatura cobre, escrito na chave "qual assinatura eu cancelo". Mesma
// lista da /lp/templum-os: é o que o comprador reconhece como linha de custo.
const modulos = [
  { icon: "mdi:handshake-outline",             modulo: "CRM, funil e coaching de vendas",     lugar: "Pipedrive, RD Station CRM, HubSpot" },
  { icon: "solar:checklist-minimalistic-bold", modulo: "Tarefas, projetos e prazos",          lugar: "ClickUp, Asana, Monday, Trello" },
  { icon: "solar:wallet-money-bold",           modulo: "Financeiro, DRE, NF-e e NFS-e",       lugar: "Omie, Conta Azul, Bling" },
  { icon: "solar:letter-opened-bold",          modulo: "Landing page, régua e WhatsApp",      lugar: "RD Station Marketing" },
  { icon: "solar:users-group-rounded-bold",    modulo: "RH, avaliação, PDI e recrutamento",   lugar: "Sólides, Gupy" },
  { icon: "solar:square-academic-cap-bold",    modulo: "Treinamento e trilha de aprendizagem", lugar: "plataforma de EAD avulsa" },
  { icon: "solar:videocamera-record-bold",     modulo: "Reunião, transcrição e ata",          lugar: "Zoom + Fireflies / Otter" },
  { icon: "solar:document-add-bold",           modulo: "Documento e assinatura eletrônica",   lugar: "Drive solto + DocuSign / Clicksign" },
  { icon: "solar:chart-2-bold",                modulo: "Indicadores, metas e painel",         lugar: "Power BI + planilha" },
  { icon: "solar:shield-check-bold",           modulo: "Processos, riscos e auditoria",       lugar: "software de SGI + planilha" },
  { icon: "solar:compass-bold",                modulo: "Planejamento estratégico, SWOT e OKR", lugar: "uma apresentação que ninguém revisa" },
  { icon: "solar:cart-large-2-bold",           modulo: "Compras, cotação e fornecedor",       lugar: "planilha + caixa de e-mail" },
  { icon: "solar:health-bold",                 modulo: "SESMT: ASO, EPI, CIPA e acidente",    lugar: "sistema de SST avulso" },
  { icon: "solar:headphones-round-bold",       modulo: "Chamado interno e chat da equipe",    lugar: "Zendesk, Movidesk, Slack" },
];

// Comparativo. A verdade comercial desta linha de produto é que os três planos
// entregam O MESMO produto — muda a faixa de usuários e a prioridade no suporte.
// Inventar trava de funcionalidade por plano aqui seria mentira que morre na demo.
const comparativo = [
  { rec: "Usuários incluídos",                            vals: ["Até 50", "Até 100", "Até 300"] },
  { rec: "Todos os módulos de gestão",                    vals: [true, true, true] },
  { rec: "Olívia e os agentes de IA",                     vals: [true, true, true] },
  { rec: "Olívia no WhatsApp, para quem não abre sistema", vals: [true, true, true] },
  { rec: "IA sem cobrança por token e sem cobrança por agente", vals: [true, true, true] },
  { rec: "Importação dos dados dos sistemas atuais",      vals: [true, true, true] },
  { rec: "Multiorganização (grupos, filiais e unidades)", vals: [true, true, true] },
  { rec: "Módulos e funções novas durante o contrato",    vals: [true, true, true] },
  { rec: "Suporte",                                       vals: ["Horário comercial", "Prioritário", "Prioritário"] },
  { rec: "Custo por pessoa/mês (plano anual)",            vals: planosCalc.map((p) => "R$ " + brl2(p.porPessoaAno)) },
];

const passos = [
  { n: "01", t: "Crie a conta e entre", d: "O cadastro é seu, direto na plataforma. Ninguém precisa te liberar acesso, agendar reunião ou mandar proposta antes." },
  { n: "02", t: "Rode com o contexto da sua empresa", d: "Os agentes montam a primeira versão do planejamento, do mapa de processos, dos indicadores e das instruções a partir do que a sua empresa faz. Você edita o que não fizer sentido." },
  { n: "03", t: "Chame o time antes de decidir", d: "Adoção é o que decide se a assinatura se paga. Coloque as pessoas que vão usar de verdade, e só então escolha o plano." },
];

const faqs = [
  { q: "Quanto custa, exatamente?",
    a: `Essencial R$ ${brl(essencial.mes)}/mês para até ${essencial.usuarios} usuários, Performance R$ ${brl(planosCalc[1].mes)}/mês para até ${planosCalc[1].usuarios} e Enterprise R$ ${brl(planosCalc[2].mes)}/mês para até ${planosCalc[2].usuarios}. No plano anual, 20% a menos: R$ ${brl(essencial.anoMes)}, R$ ${brl(planosCalc[1].anoMes)} e R$ ${brl(planosCalc[2].anoMes)} por mês. Não há cobrança por token de IA nem por agente — todos estão inclusos.` },
  { q: "É cobrado por usuário?",
    a: `Não. O preço é fixo por faixa: entrar com 12 ou com ${essencial.usuarios} pessoas no Essencial custa o mesmo. O "custo por pessoa" que aparece na página é uma conta derivada, para você comparar com CRM, gestor de tarefas e RH — esses sim cobram por cabeça, e a conta deles sobe toda vez que você contrata alguém.` },
  { q: "Como funciona o teste?",
    a: "Você cria a conta em app.templum.com.br/register e usa a plataforma. Sem passar por vendedor, sem proposta antes. Se fizer sentido, escolhe o plano; se não fizer, você não paga nada." },
  { q: "Tem fidelidade?",
    a: "No plano mensal, não: você cancela quando quiser. O plano anual é o que tem compromisso de 12 meses — é exatamente por isso que ele custa 20% menos. A escolha entre os dois é sua, e dá para começar no mensal e migrar depois." },
  { q: "Posso trocar de plano depois?",
    a: "Pode, a qualquer momento. Cresceu o time e passou da faixa, você sobe de plano e a diferença é ajustada na cobrança seguinte. O caminho contrário também existe." },
  { q: "E se a minha empresa tiver mais de 300 usuários?",
    a: "Aí existe faixa acima do Enterprise, e ela é definida pelo porte da operação, não por assento. Fale com o time comercial que a faixa sai na mesma conversa." },
  { q: "Vou perder o histórico dos sistemas que eu cancelar?",
    a: "Não. Clientes, contatos, negócios, contas a pagar e a receber entram por importação, e o histórico antigo fica anexado ao registro. O recomendado é rodar 30 dias em paralelo com o sistema atual e só cancelar depois de conferir que está tudo aqui." },
  { q: "Preciso de equipe de TI para implantar?",
    a: "Não. A plataforma é web, sem instalação e sem servidor da sua parte. O que a implantação pede da sua empresa é decisão de gestão — quem responde por cada processo — não configuração técnica." },
  { q: "Preciso querer certificação ISO para usar?",
    a: "Não. A plataforma nasceu do método que a Templum usa em certificação há mais de 30 anos, mas ela existe para organizar a gestão. O efeito colateral é útil: se um cliente exigir ISO 9001 no contrato, o caminho já está quase todo andado. A certificação em si depende de auditoria de organismo certificador e é contratada à parte." },
  { q: "Meus dados ficam seguros?",
    a: "Sim. A plataforma é da própria Templum, com controle de acesso por usuário e por organização, e o tratamento de dados segue a LGPD. Cada organização é isolada: o que você cria não é visível para nenhum outro cliente." },
];

// --- Schema.org: preço na tela vira preço no resultado de busca e nas respostas de IA
const schemaSoftware = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Templum OS",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Plataforma de gestão com agentes de inteligência artificial coordenados pela Olívia. Reúne CRM, tarefas e projetos, financeiro, marketing, RH, treinamento, documentos, indicadores, processos e riscos em uma assinatura só.",
  provider: { "@type": "Organization", name: "Templum Consultoria", url: "https://templum.com.br" },
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "BRL",
    lowPrice: String(essencial.mes),
    highPrice: String(planosCalc[2].mes),
    offerCount: planosCalc.length,
    offers: planosCalc.map((p) => ({
      "@type": "Offer",
      name: `Templum OS ${p.nome}`,
      price: String(p.mes) + ".00",
      priceCurrency: "BRL",
      availability: "https://schema.org/InStock",
      url: "https://templum.com.br/solucoes-de-ia/",
      eligibleQuantity: { "@type": "QuantitativeValue", maxValue: p.usuarios, unitText: "usuários" },
    })),
  },
};
const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Base
  title={`Templum OS — planos e preços a partir de R$ ${brl(essencial.mes)}/mês | Templum`}
  description={`Toda a gestão da empresa em uma assinatura: CRM, projetos, financeiro, RH, treinamento, documentos e indicadores com agentes de IA inclusos. Três planos, de R$ ${brl(essencial.mes)} a R$ ${brl(planosCalc[2].mes)} por mês, com 20% de desconto no anual. Teste sem falar com vendedor.`}
  schemas={[schemaSoftware, schemaFaq]}
  noBanner={true}
>

  <!-- ============ HERO ============ -->
  <section class="pl-hero">
    <div class="pl-hero-bg" aria-hidden="true"></div>
    <div class="container xl pl-hero-grid">
      <div class="pl-hero-text">
        <span class="tag-pill tag-pill--glow"><iconify-icon icon="solar:cpu-bolt-bold"></iconify-icon> Templum OS · Olívia</span>
        <h1 class="pl-hero-title">
          Toda a gestão da empresa em <em class="accent">uma assinatura</em> — a partir de R$&nbsp;{brl(essencial.mes)} por mês
        </h1>
        <p class="pl-hero-sub">
          CRM, projetos, financeiro, RH, treinamento, documentos, processos e indicadores no mesmo
          banco de dados — com a <strong>Olívia e os agentes de IA inclusos</strong>, sem cobrança por
          token. É a plataforma que a Templum construiu para rodar a própria operação.
        </p>
        <div class="pl-hero-cta">
          <a href={APP_REGISTER} class="btn btn--primary btn--lg" data-cta="teste-gratis">
            Testar gratuitamente <iconify-icon icon="solar:arrow-right-linear"></iconify-icon>
          </a>
          <a href="#planos" class="btn btn--onDark btn--lg">Ver os planos</a>
        </div>
        <div class="pl-hero-chips">
          <span class="pl-chip"><iconify-icon icon="solar:check-circle-bold"></iconify-icon> Você entra sozinho, sem falar com vendedor</span>
          <span class="pl-chip"><iconify-icon icon="solar:check-circle-bold"></iconify-icon> IA inclusa, sem cobrança por token</span>
          <span class="pl-chip"><iconify-icon icon="solar:check-circle-bold"></iconify-icon> No mensal, sem fidelidade</span>
        </div>
      </div>

      <div class="pl-hero-provas">
        <div class="pl-prova"><strong>+3.000</strong><span>empresas rodando a plataforma</span></div>
        <div class="pl-prova"><strong>+20 mil</strong><span>usuários ativos</span></div>
        <div class="pl-prova"><strong>+30 anos</strong><span>organizando a gestão de empresas</span></div>
        <div class="pl-prova"><strong>2 países</strong><span>Brasil e Estados Unidos</span></div>
      </div>
    </div>
  </section>

  <ClientLogos dark={true} titulo="Algumas das empresas atendidas pela Templum ao longo de mais de 30 anos" />

  <!-- ============ PLANOS ============ -->
  <section class="section section--cream" id="planos">
    <div class="container xl">
      <div class="section-header">
        <span class="tag-pill">Planos e preços</span>
        <h2>Os três planos entregam <em class="accent">o mesmo produto</em></h2>
        <p>
          Nenhuma função fica atrás de um plano mais caro. O que muda é quantas pessoas cabem dentro
          da plataforma e a prioridade no suporte. Escolha pela sua faixa de usuários.
        </p>
      </div>

      <div class="pl-switch">
        <div class="pl-switch-inner" role="group" aria-label="Ciclo de cobrança">
          <button type="button" id="plMensal" class="pl-sw-btn" aria-pressed="true">Mensal</button>
          <button type="button" id="plAnual" class="pl-sw-btn" aria-pressed="false">Anual <span class="pl-off">-20%</span></button>
        </div>
      </div>

      <div class="pl-grid" id="plGrid">
        {planosCalc.map((p) => (
          <article class={p.recomendado ? "pl-card pl-card--rec" : "pl-card"}>
            {p.recomendado && <span class="pl-rec">Melhor escolha</span>}
            <span class="pl-nome">{p.nome}</span>
            <h3 class="pl-produto">Templum OS</h3>
            <p class="pl-resumo">{p.resumo}</p>

            <div class="pl-preco">
              <span class="pl-de" data-de-anual={`R$ ${brl(p.anoCheio)}/ano`}></span>
              <span class="pl-valor">
                <span class="pl-num" data-mensal={`R$ ${brl(p.mes)}`} data-anual={`R$ ${brl(p.anoTotal)}`}>R$ {brl(p.mes)}</span>
                <span class="pl-ciclo" data-ciclo-mensal="/por mês" data-ciclo-anual="/por ano">/por mês</span>
              </span>
              <span class="pl-equiv" data-equiv-anual={`Equivalente a R$ ${brl(p.anoMes)}/mês · economia de R$ ${brl(p.economiaAno)} no ano`}></span>
            </div>

            <div class="pl-seat">
              <span class="pl-seat-users"><iconify-icon icon="solar:users-group-rounded-bold"></iconify-icon> Até {p.usuarios} usuários</span>
              <span class="pl-seat-pp" data-pp-mensal={`R$ ${brl2(p.porPessoaMes)} por pessoa`} data-pp-anual={`R$ ${brl2(p.porPessoaAno)} por pessoa`}>R$ {brl2(p.porPessoaMes)} por pessoa</span>
            </div>

            <a href={APP_REGISTER} class={p.recomendado ? "btn btn--primary btn--block" : "btn btn--ghost btn--block"} data-cta="teste-gratis">
              Testar gratuitamente
            </a>

            <ul class="pl-lista">
              {p.destaques.map((d) => (
                <li><iconify-icon icon="solar:check-circle-bold"></iconify-icon> {d}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <p class="pl-nota">
        Preços por organização, sem cobrança por assento. Acima de {planosCalc[2].usuarios} usuários existe
        faixa por porte — <a href="/form/">fale com o time comercial</a> que ela sai na mesma conversa.
        No plano mensal você cancela quando quiser; o anual é o que tem compromisso de 12 meses, e é por
        isso que ele custa 20% menos.
      </p>
    </div>
  </section>

  <!-- ============ COMPARATIVO ============ -->
  <section class="section section--navy">
    <div class="container lg">
      <div class="section-header">
        <span class="tag-pill tag-pill--glow">Comparativo</span>
        <h2>O que vem em cada plano</h2>
        <p>A tabela é curta de propósito: quase tudo está nos três.</p>
      </div>

      <div class="pl-tab-wrap">
        <table class="pl-tab">
          <thead>
            <tr>
              <th scope="col">Recurso</th>
              {planosCalc.map((p) => <th scope="col" class="pl-tab-c">{p.nome}</th>)}
            </tr>
          </thead>
          <tbody>
            {comparativo.map((linha) => (
              <tr>
                <th scope="row">{linha.rec}</th>
                {linha.vals.map((v, i) => (
                  <td class="pl-tab-c" data-l={planosCalc[i].nome}>
                    {v === true
                      ? <iconify-icon class="pl-ok" icon="solar:check-circle-bold" aria-label="Incluso"></iconify-icon>
                      : <span>{v}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="pl-tab-cta">
        <a href={APP_REGISTER} class="btn btn--primary btn--lg" data-cta="teste-gratis">
          Criar minha conta <iconify-icon icon="solar:arrow-right-linear"></iconify-icon>
        </a>
        <a href="/form/" class="btn btn--onDark btn--lg">Falar com um especialista</a>
      </div>
    </div>
  </section>

  <!-- ============ MÓDULOS ============ -->
  <section class="section section--cream">
    <div class="container xl">
      <div class="section-header">
        <span class="tag-pill">Incluso nos três planos</span>
        <h2>Cada linha aqui é <em class="accent">uma assinatura que você cancela</em></h2>
        <p>
          A plataforma não é mais um sistema ao lado dos que você já paga. Ela é o lugar para onde essas
          funções mudam — com o dado de vendas conversando com o de produção, no mesmo banco.
        </p>
      </div>

      <div class="pl-mods">
        {modulos.map((m) => (
          <div class="pl-mod">
            <span class="pl-mod-ico"><iconify-icon icon={m.icon}></iconify-icon></span>
            <div>
              <h3>{m.modulo}</h3>
              <p>No lugar de {m.lugar}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ A CONTA ============ -->
  <section class="section section--navy">
    <div class="container lg">
      <div class="section-header">
        <span class="tag-pill tag-pill--glow">Cenário: empresa de {essencial.usuarios} pessoas</span>
        <h2>A conta de sistemas antes de <em class="accent">qualquer resultado</em></h2>
        <p>
          Um CRM, um gestor de tarefas, uma automação de marketing, um RH, um ERP e uma assinatura
          eletrônica. Seis contratos, seis logins, seis reajustes por ano — e nenhum deles sabe o que
          acontece dentro do outro. Abaixo, a preço público de tabela, dimensionado para
          {essencial.usuarios} usuários: o mesmo corte do plano Essencial, para a comparação ficar maçã
          com maçã.
        </p>
      </div>

      <div class="pl-conta">
        <ul class="pl-conta-lista">
          {fatura.map((f) => (
            <li>
              <img class="pl-conta-logo" src={`/assets/img/stack/${f.logo}.png`} alt="" width="128" height="128" loading="lazy" decoding="async" />
              <span class="pl-conta-nome"><strong>{f.sistema}</strong><small>{f.cat}</small></span>
              <span class="pl-conta-val">R$ {brl(f.mes)}</span>
            </li>
          ))}
          <li class="pl-conta-tot">
            <span class="pl-conta-nome"><strong>Total do conjunto</strong><small>por mês</small></span>
            <span class="pl-conta-val">R$ {brl(faturaMes)}</span>
          </li>
          <li class="pl-conta-nos">
            <span class="pl-conta-nome"><strong>Templum OS Essencial</strong><small>tudo isso, em uma assinatura só</small></span>
            <span class="pl-conta-val">R$ {brl(essencial.mes)}</span>
          </li>
        </ul>

        <div class="pl-conta-econ">
          <span class="pl-econ-lab">Sobra nessa troca</span>
          <strong class="pl-econ-num">R$ {brl(economiaStackAno)}</strong>
          <span class="pl-econ-sub">por ano — R$ {brl(economiaStackMes)} por mês</span>
          <p class="pl-econ-txt">
            O conjunto custava mais de {vezesMaisCaro} vezes o preço da assinatura, com a IA cobrada por fora em vez de inclusa.
            E como o preço não é por assento, contratar mais gente não sobe a fatura dentro da faixa.
          </p>
          <a href="/lp/templum-os#calculadora" class="btn btn--onDark">Fazer a conta da minha empresa</a>
        </div>
      </div>

      <p class="pl-memoria">
        <iconify-icon icon="solar:info-circle-bold"></iconify-icon>
        <span>
          <strong>Memória de cálculo.</strong> Os valores linha a linha são
          <strong>preço público de tabela dos fornecedores</strong> (ago/2026), dimensionados para
          {essencial.usuarios} usuários e câmbio de R$ 5,50 — é a conta que você confere no site de cada
          um. O cenário é <strong>ilustrativo</strong>: a sua empresa provavelmente não usa exatamente
          esses seis, e o seu número real depende dos planos que você assina hoje.
          <strong>E o que a assinatura não substitui:</strong> disparo de e-mail marketing em massa
          continua sendo ferramenta à parte — régua de relacionamento e landing page estão inclusas,
          a base de disparo não.
        </span>
      </p>
    </div>
  </section>

  <!-- ============ COMO COMEÇA ============ -->
  <section class="section section--cream">
    <div class="container lg">
      <div class="section-header">
        <span class="tag-pill">Como começa</span>
        <h2>Sem proposta, sem reunião de descoberta, <em class="accent">sem esperar retorno</em></h2>
        <p>Você entra na plataforma hoje e decide depois. O time comercial existe para quem prefere ser guiado — não como pedágio.</p>
      </div>

