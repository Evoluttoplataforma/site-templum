---
import LpBase from "../../layouts/LpBase.astro";

// Orbit público NÃO tem redirect após envio (tela "Resposta enviada" é fixa).
// Replay: https://templum.com.br/planejamento-estrategico-2027/replay/
const SURVEY_SRC = "https://app.templum.com.br/s/survey_1789086074989_ry5zj0u4w";
const REPLAY = "/planejamento-estrategico-2027/replay/";
---

<LpBase
  title="Pesquisa — Planejamento Estratégico 2027 | Templum"
  description="Responda a pesquisa do workshop Planejamento Estratégico 2027 e acesse o replay e o material de apoio."
  noindex={true}
  formAnchor={REPLAY}
  headerCta="Replay e material"
>

  <section class="ps-page">
    <div class="ps-intro">
      <div class="container md">
        <span class="badge badge--orange-solid">Pós-evento</span>
        <h1>Conta pra gente como foi</h1>
        <p>
          A pesquisa está aqui embaixo. Ao terminar, use
          <strong>Replay e material</strong> no topo — ou o botão após enviar —
          para o vídeo e o PDF.
        </p>
      </div>
    </div>

    <div class="ps-frame-wrap" id="pesquisa">
      <iframe
        id="pe-survey"
        src={SURVEY_SRC}
        title="Pesquisa — Planejamento Estratégico 2027"
        class="ps-frame"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="clipboard-write"
      ></iframe>
    </div>

    <div class="ps-after">
      <a href={REPLAY} class="btn btn--primary btn--lg">
        Já enviei — ir para o replay
        <iconify-icon icon="solar:arrow-right-linear"></iconify-icon>
      </a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var REPLAY = "/planejamento-estrategico-2027/replay/";
      function goReplay() {
        try { window.top.location.href = REPLAY; }
        catch (e) { window.location.href = REPLAY; }
      }
      window.addEventListener("message", function (e) {
        var origin = e.origin || "";
        if (origin.indexOf("app.templum.com.br") === -1 && origin.indexOf("templum.com.br") === -1) return;
        var d = e.data;
        var s = typeof d === "string" ? d : (d && (d.type || d.event || d.status) || "");
        s = String(s).toLowerCase();
        if (/submit|complete|thank|success|enviad|replay/.test(s)) goReplay();
      });
    })();
  </script>

</LpBase>

<style>
  .ps-page { background: var(--navy); }
  .ps-intro {
    padding: 28px 0 20px;
    text-align: center;
  }
  .ps-intro h1 {
    font-size: clamp(24px, 3.4vw, 36px);
    font-weight: 800;
    color: var(--cream);
    letter-spacing: -0.03em;
    margin: 14px 0 10px;
  }
  .ps-intro p {
    font-size: 15px;
    color: rgba(255,244,221,0.72);
    line-height: 1.6;
    max-width: 560px;
    margin: 0 auto;
  }
  .ps-intro strong { color: var(--cream); }

  .ps-frame-wrap {
    width: min(960px, calc(100% - 32px));
    margin: 0 auto;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255,244,221,0.12);
    min-height: min(1100px, calc(100dvh - 160px));
  }
  .ps-frame {
    display: block;
    width: 100%;
    height: min(1100px, calc(100dvh - 160px));
    min-height: 900px;
    border: 0;
    background: #fff;
  }

  .ps-after {
    display: flex;
    justify-content: center;
    padding: 28px 16px 48px;
  }
  .ps-after .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
</style>
