---
import LpBase from "../../layouts/LpBase.astro";

const FORM_SRC =
  "https://app.templum.com.br/p/crm-form/V22Vs_RW8VbRffHsZ4DKPQ1I?embed=1";
---

<LpBase
  title="Pesquisa — Planejamento Estratégico 2027 | Templum"
  description="O workshop acabou. O trabalho mais importante começa agora: executar o plano. Preencha o formulário para acessar a gravação e o material de apoio."
  noindex={true}
  formAnchor="#pesquisa"
  headerCta="Preencher formulário"
>

  <section class="ps-hero">
    <div class="container xl">
      <div class="ps-hero-grid">

        <div class="ps-copy">
          <div class="ps-badges">
            <span class="badge badge--orange-solid">Pós-evento</span>
            <span class="badge badge--cream">Planejamento Estratégico 2027</span>
          </div>

          <h1>
            O workshop acabou.<br />
            <em>O trabalho mais importante começa agora.</em>
          </h1>

          <p class="ps-desc">
            O valor do que construímos no workshop não está apenas no plano.
            Está no que sua equipe vai conseguir tirar do papel a partir dele.
          </p>
          <p class="ps-desc">
            Por isso, preparamos a gravação e o material de apoio do encontro
            para ajudar vocês a revisarem as decisões, distribuírem as
            responsabilidades e avançarem na execução.
          </p>
          <p class="ps-desc">
            Antes de liberar o acesso, queremos entender como foi sua
            experiência no workshop.
          </p>
          <p class="ps-cta-line">
            Preencha o formulário. É bem rápido, não leva nem 1 minuto.
          </p>

          <div class="ps-speakers-strip">
            <img src="/assets/img/socios/igor.jpg" alt="Igor Furniel" class="ps-speaker-photo" />
            <div>
              <div class="ps-speaker-name">Igor Furniel</div>
              <div class="ps-speaker-role">Sócio-fundador · Templum Consultoria</div>
            </div>
          </div>
        </div>

        <div class="ps-form-col" id="pesquisa">
          <div class="ps-form-card">
            <span class="badge badge--orange">Pesquisa rápida</span>
            <iframe
              id="pe-survey"
              src={FORM_SRC}
              title="Pesquisa — Planejamento Estratégico 2027"
              width="100%"
              height="1280"
              frameborder="0"
              loading="eager"
              style="border: none; width: 100%; height: 1280px; background: #f7f8fc; display: block;"
            ></iframe>
          </div>
        </div>

      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var iframe = document.getElementById("pe-survey");
      if (!iframe) return;
      window.addEventListener("message", function (e) {
        if (!e.origin || e.origin.indexOf("app.templum.com.br") === -1) return;
        var d = e.data;
        var h = 0;
        if (typeof d === "number") h = d;
        else if (d && typeof d === "object") {
          h = Number(d.height || d.iframeHeight || (d.data && d.data.height) || 0);
        }
        if (h >= 400 && h <= 2400) {
          iframe.style.height = h + "px";
          iframe.setAttribute("height", String(h));
        }
      });
    })();
  </script>

</LpBase>

<style>
  .ps-hero {
    background: var(--navy);
    padding: clamp(48px, 7vw, 88px) 0 clamp(56px, 8vw, 80px);
    position: relative;
    overflow: hidden;
  }
  .ps-hero::before {
    content: "";
    position: absolute;
    top: -200px;
    right: -200px;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(255, 89, 37, 0.10) 0%, transparent 65%);
    pointer-events: none;
  }
  .ps-hero-grid {
    display: grid;
    grid-template-columns: 1fr minmax(560px, 680px);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
    position: relative;
    z-index: 1;
  }

  .ps-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }
  .ps-copy h1 {
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 800;
    color: var(--cream);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }
  .ps-copy h1 em {
    font-style: italic;
    color: var(--orange);
  }
  .ps-desc {
    font-size: 16px;
    color: rgba(255, 244, 221, 0.72);
    line-height: 1.75;
    margin-bottom: 16px;
    max-width: 540px;
  }
  .ps-cta-line {
    font-size: 16px;
    font-weight: 700;
    color: var(--cream);
    line-height: 1.6;
    margin: 4px 0 28px;
    max-width: 540px;
  }

  .ps-speakers-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    border: 1px solid rgba(255, 244, 221, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    width: fit-content;
  }
  .ps-speaker-photo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--orange);
    flex-shrink: 0;
  }
  .ps-speaker-name {
    font-size: 14px;
    font-weight: 800;
    color: var(--cream);
  }
  .ps-speaker-role {
    font-size: 12px;
    color: rgba(255, 244, 221, 0.55);
    margin-top: 2px;
  }

  .ps-form-col { align-self: start; }
  .ps-form-card {
    background: #fff;
    border-radius: 20px;
    padding: 20px 20px 8px;
    text-align: left;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35), 0 4px 16px rgba(0, 0, 0, 0.2);
    overflow: hidden;
  }
  .ps-form-card .badge { margin-bottom: 8px; }

  @media (max-width: 1020px) {
    .ps-hero-grid { grid-template-columns: 1fr; }
    .ps-desc,
    .ps-cta-line { max-width: 100%; }
    .ps-form-card { max-width: 680px; margin: 0 auto; }
  }
</style>
