---
import LpBase from "../../layouts/LpBase.astro";

const FORM_SRC =
  "https://app.templum.com.br/p/crm-form/V22Vs_RW8VbRffHsZ4DKPQ1I?embed=1";
const REPLAY = "/planejamento-estrategico-2027/replay/";
---

<LpBase
  title="Pesquisa — Planejamento Estratégico 2027 | Templum"
  description="Responda a pesquisa do workshop Planejamento Estratégico 2027 e acesse o replay e o material de apoio."
  noindex={true}
  formAnchor="#pesquisa"
  headerCta="Ir para a pesquisa"
>

  <section class="ps-page">
    <div class="ps-intro">
      <div class="container md">
        <span class="badge badge--orange-solid">Pós-evento</span>
        <h1>Conta pra gente como foi</h1>
        <p>Preencha o formulário aqui nesta página. Leva poucos minutos.</p>
      </div>
    </div>

    <div class="ps-card" id="pesquisa">
      <iframe
        src={FORM_SRC}
        title="Pesquisa — Planejamento Estratégico 2027"
        width="100%"
        height="720"
        frameborder="0"
        loading="eager"
        style="border: none; width: 100%; max-width: 500px; height: 720px; background: #fff;"
      ></iframe>
    </div>

    <div class="ps-after">
      <a href={REPLAY} class="btn btn--primary btn--lg">
        Já enviei — ir para o replay
        <iconify-icon icon="solar:arrow-right-linear"></iconify-icon>
      </a>
    </div>
  </section>

</LpBase>

<style>
  .ps-page {
    background: var(--cream, #fff4dd);
    padding-bottom: 48px;
  }
  .ps-intro {
    padding: 28px 0 20px;
    text-align: center;
  }
  .ps-intro h1 {
    font-size: clamp(24px, 3.4vw, 36px);
    font-weight: 800;
    color: var(--navy);
    letter-spacing: -0.03em;
    margin: 14px 0 10px;
  }
  .ps-intro p {
    font-size: 15px;
    color: var(--text-2, #3F424B);
    line-height: 1.6;
    max-width: 560px;
    margin: 0 auto;
  }

  .ps-card {
    width: min(560px, calc(100% - 32px));
    margin: 0 auto;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(24, 25, 27, 0.1);
    display: flex;
    justify-content: center;
  }

  .ps-after {
    display: flex;
    justify-content: center;
    padding: 28px 16px 0;
  }
  .ps-after .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
</style>
