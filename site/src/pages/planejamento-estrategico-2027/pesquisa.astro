---
import LpBase from "../../layouts/LpBase.astro";

// Orbit: após enviar, redirecionar para
// https://templum.com.br/planejamento-estrategico-2027/replay/
const SURVEY_SRC = "https://app.templum.com.br/s/survey_1789086074989_ry5zj0u4w";
const REPLAY = "/planejamento-estrategico-2027/replay/";
---

<LpBase
  title="Pesquisa — Planejamento Estratégico 2027 | Templum"
  description="Responda a pesquisa do workshop Planejamento Estratégico 2027 e acesse o replay e o material de apoio."
  noindex={true}
  formAnchor="#pesquisa"
  headerCta="Responder pesquisa"
>

  <section class="ps-hero">
    <div class="ps-glow"></div>
    <div class="container md ps-inner">
      <div class="ps-badges">
        <span class="badge badge--orange-solid">Pós-evento</span>
        <span class="badge badge--cream">Planejamento Estratégico 2027</span>
      </div>

      <h1>
        Conta pra gente como foi.<br />
        <em>O replay está na sequência.</em>
      </h1>

      <p class="ps-lead">
        Leva poucos minutos. Ao terminar, você vai para o
        <strong>replay do workshop</strong> com Igor Furniel e o material de apoio.
      </p>

      <div class="ps-fallback" id="pesquisa">
        <a href={SURVEY_SRC} class="btn btn--primary btn--lg" target="_blank" rel="noopener noreferrer">
          <iconify-icon icon="solar:clipboard-check-bold"></iconify-icon>
          Abrir pesquisa
        </a>
        <p class="ps-hint">
          Se o formulário não aparecer abaixo, use o botão.
          Depois da resposta, vá para o
          <a href={REPLAY}>replay e o material</a>.
        </p>
      </div>

      <div class="ps-frame-wrap">
        <iframe
          src={SURVEY_SRC}
          title="Pesquisa — Planejamento Estratégico 2027"
          class="ps-frame"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="clipboard-write"
        ></iframe>
      </div>
    </div>
  </section>

</LpBase>

<style>
  .ps-hero {
    background: var(--navy);
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 6vw, 72px) 0 clamp(48px, 7vw, 88px);
    text-align: center;
  }
  .ps-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center top, rgba(255,89,37,0.14) 0%, transparent 58%);
    pointer-events: none;
  }
  .ps-inner { position: relative; z-index: 1; }
  .ps-badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .ps-inner h1 {
    font-size: clamp(28px, 4.2vw, 48px);
    font-weight: 800;
    color: var(--cream);
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin-bottom: 18px;
  }
  .ps-inner h1 em {
    font-style: italic;
    color: var(--orange);
  }
  .ps-lead {
    font-size: 17px;
    color: rgba(255,244,221,0.75);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 28px;
  }
  .ps-lead strong { color: var(--cream); }

  .ps-fallback { margin-bottom: 24px; }
  .ps-fallback .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .ps-hint {
    font-size: 13px;
    color: rgba(255,244,221,0.4);
    margin-top: 14px;
  }
  .ps-hint a {
    color: var(--orange);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ps-frame-wrap {
    width: 100%;
    background: var(--cream);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255,244,221,0.12);
    box-shadow: 0 24px 64px rgba(0,0,0,0.4);
    min-height: 920px;
  }
  .ps-frame {
    display: block;
    width: 100%;
    height: 920px;
    border: 0;
    background: #fff;
  }

  @media (min-width: 768px) {
    .ps-frame-wrap,
    .ps-frame { height: 1080px; min-height: 1080px; }
  }
</style>
