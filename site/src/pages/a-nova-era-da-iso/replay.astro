---
import CampanhaIsolada from "../../layouts/CampanhaIsolada.astro";
import "../../styles/nova-era-iso.css";

const EVENTO = "nova-era-certificacao-iso-replay";
const DIAGNOSTICO = "https://app.templum.com.br/p/crm-form/oq_IXzYtJtM-VvaucAFrs0ju";
const MATERIAL = "/assets/nova-era-iso/material-de-apoio-nova-era.html";
const VIMEO = "https://player.vimeo.com/video/1238003425?h=da95e026af&title=0&byline=0&portrait=0&dnt=1";
---

<CampanhaIsolada
  title="Replay liberado | A Nova Era da Certificação ISO"
  description="O replay de A Nova Era da Certificação ISO está liberado, com a gravação completa e o material de apoio."
>
  <div class="lp-nova">
    <header class="header">
      <div class="header-inner">
        <a href="/a-nova-era-da-iso/" aria-label="Página do evento">
          <img class="logo-templum" src="/assets/logo/templum.png" alt="Templum" width="389" height="129" />
        </a>
      </div>
    </header>

    <main>
      <section class="hero replay-hero" id="replay-gate">
        <div class="wrap hero-grid">
          <div>
            <p class="kicker">Replay liberado + material de apoio</p>
            <h1>Replay: A Nova Era da Certificação ISO está liberado!</h1>
            <p class="lede">A sala lotou e algumas pessoas ficaram de fora. Por isso, decidimos abrir uma exceção e disponibilizar a gravação completa com Igor Furniel, além do material de apoio.</p>
            <p class="replay-access">Cadastre-se para acessar:</p>
            <ul class="replay-gains">
              <li>Replay completo da live</li>
              <li>Material de apoio do encontro</li>
              <li>Oportunidade de avaliar os desafios da sua empresa com nossos especialistas</li>
            </ul>
          </div>
          <div class="form-card">
            <p class="kicker">Acesso gratuito</p>
            <p class="price-note">Preencha para liberar o replay e o material nesta página.</p>
            <form id="replay-form" novalidate>
              <input type="hidden" name="evento" value={EVENTO} />
              <input type="hidden" name="mensagem" value="Replay | A Nova Era da Certificação ISO | 20/10/2026" />
              <div class="field">
                <label for="nome">Nome completo</label>
                <input class="input" id="nome" name="nome" type="text" autocomplete="name" required minlength="2" placeholder="Seu nome completo" />
              </div>
              <div class="field">
                <label for="email">E-mail</label>
                <input class="input" id="email" name="email" type="email" autocomplete="email" required placeholder="voce@empresa.com" />
              </div>
              <div class="field">
                <label for="empresa">Empresa</label>
                <input class="input" id="empresa" name="empresa" type="text" autocomplete="organization" placeholder="Nome da empresa" />
              </div>
              <div class="field">
                <label for="telefone">WhatsApp</label>
                <input
                  class="input"
                  id="telefone"
                  name="telefone"
                  type="tel"
                  inputmode="numeric"
                  autocomplete="tel-national"
                  required
                  maxlength="15"
                  minlength="15"
                  pattern={"^\\([1-9][0-9]\\) 9[0-9]{4}-[0-9]{4}$"}
                  title="WhatsApp com DDD, 11 dígitos. Ex.: (19) 99999-0000"
                  placeholder="(00) 00000-0000"
                  aria-describedby="telefone-erro"
                />
                <p class="error-msg" id="telefone-erro" data-tel-error aria-live="polite"></p>
              </div>
              <button type="submit" class="btn-reserve btn-block">Liberar o replay</button>
              <p class="form-error" id="replay-erro" role="alert"></p>
            </form>
            <p class="legal">Usamos estes dados para liberar o replay e o material.</p>
          </div>
        </div>
      </section>

      <section class="hero" id="replay-liberado" hidden>
        <div class="wrap-narrow">
          <p class="kicker">Replay liberado</p>
          <h1>Agora é só dar o play!</h1>
          <p class="lede">Assista ao replay completo de A Nova Era da Certificação ISO, com Igor Furniel.</p>
          <div class="replay-frame">
            <iframe
              id="replay-frame"
              title="Replay: A Nova Era da Certificação ISO"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <div class="replay-actions">
            <a class="btn" id="replay-material" href={MATERIAL} download="Material-de-apoio-Nova-Era.html">Baixar o material de apoio</a>
            <div class="replay-diag">
              <h2>Agora a escolha é sua: continuar na velha era da certificação ISO ou avançar para a nova?</h2>
              <p>De um lado, uma certificação focada em documentos, auditorias e cumprimento de requisitos.</p>
              <p>Do outro, <strong>um Sistema de Gestão Integrado, com estratégia, processos, indicadores e pessoas conectados</strong>, ajudando sua empresa a melhorar a performance e gerar resultados de verdade.</p>
              <p><strong>O primeiro passo para essa mudança pode começar com um diagnóstico individual da sua empresa.</strong></p>
              <a class="btn btn-white" href={DIAGNOSTICO} target="_blank" rel="noopener noreferrer">Solicitar meu diagnóstico</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <img class="logo-templum" src="/assets/logo/templum.png" alt="Templum" width="389" height="129" />
        <p>© 2026 Templum Consultoria Digital LTDA. · CNPJ 00.198.308/0001-93</p>
      </div>
    </footer>
  </div>

  <script is:inline define:vars={{ EVENTO, VIMEO }}>
    (function () {
      var KEY = "tpl_ne_replay_v1";
      var gate = document.getElementById("replay-gate");
      var panel = document.getElementById("replay-liberado");
      var form = document.getElementById("replay-form");
      var erro = document.getElementById("replay-erro");
      var frame = document.getElementById("replay-frame");

      function show() {
        if (frame && !frame.getAttribute("src")) frame.setAttribute("src", VIMEO);
        if (gate) gate.hidden = true;
        if (panel) panel.hidden = false;
      }

      try {
        if (localStorage.getItem(KEY) === "1") show();
      } catch (_) {}

      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var tel = form.querySelector('input[name="telefone"]');
        if (tel) tel.dispatchEvent(new FocusEvent("blur", { bubbles: true }));
        if (form.checkValidity && !form.checkValidity()) {
          form.reportValidity();
          return;
        }
        if (form.dataset.leadSubmitted === "1") return;
        form.dataset.leadSubmitted = "1";
        var btn = form.querySelector('[type="submit"]');
        if (btn) btn.disabled = true;
        if (erro) erro.textContent = "";

        var d = {};
        new FormData(form).forEach(function (v, k) { d[k] = v; });
        var tokenPromise = window.tplTurnstileToken ? window.tplTurnstileToken() : Promise.reject();
        tokenPromise.then(function (token) {
          return fetch("/api/lead", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              nome: d.nome || "",
              email: d.email || "",
              telefone: d.telefone || "",
              empresa: d.empresa || "",
              mensagem: d.mensagem || "",
              evento: EVENTO,
              pagina: location.pathname,
              turnstile_token: token,
            }),
          }).then(function (r) {
            return r.json().catch(function () { return {}; }).then(function (body) {
              return { httpOk: r.ok, body: body };
            });
          });
        }).then(function (res) {
          if (window.tplTurnstileReset) window.tplTurnstileReset();
          var saved = res.httpOk && res.body && res.body.ok === true && res.body.supabase && res.body.supabase.ok === true;
          if (!saved) {
            form.dataset.leadSubmitted = "";
            if (btn) btn.disabled = false;
            if (erro) {
              erro.textContent = res.body && res.body.error === "invalid_phone"
                ? "WhatsApp inválido. Use DDD brasileiro e o 9 na frente. Ex.: (19) 99999-0000"
                : "Não conseguimos gravar agora. Tente de novo em instantes.";
            }
            return;
          }
          try { localStorage.setItem(KEY, "1"); } catch (_) {}
          show();
        }).catch(function () {
          if (window.tplTurnstileReset) window.tplTurnstileReset();
          form.dataset.leadSubmitted = "";
          if (btn) btn.disabled = false;
          if (erro) erro.textContent = "Não conseguimos confirmar o envio. Tente de novo.";
        });
      });
    })();
  </script>
</CampanhaIsolada>
