---
import WebinarLp from "../layouts/WebinarLp.astro";

const topicos = [
  {
    icon: "solar:chat-line-bold",
    t: "Comunicação com o cliente (8.2.1)",
    d: "Canais, informação de produto e serviço, pedidos, alterações e tratamento de propriedade do cliente: o que registrar para provar que a empresa ouviu antes de executar.",
  },
  {
    icon: "solar:clipboard-check-bold",
    t: "Determinação e revisão de requisitos (8.2.2 e 8.2.3)",
    d: "Requisitos declarados, implícitos e legais; capacidade de atender; diferença entre orçamento, pedido e contrato. Checklist de revisão antes de liberar produção ou prestação.",
  },
  {
    icon: "solar:document-add-bold",
    t: "Mudança de requisito e registro",
    d: "Quando o cliente muda escopo, prazo ou especificação: como comunicar impacto interno, atualizar documentos e evitar retrabalho por requisito mal entendido.",
  },
  {
    icon: "solar:shield-warning-bold",
    t: "Erros clássicos em auditoria no 8.2",
    d: "Promessa comercial que a operação não viu, requisito legal ignorado, revisão de contrato inexistente e evidência só no e-mail perdido na caixa de entrada.",
  },
];

const sinais = [
  "Vendas promete prazo ou escopo que a produção descobre depois.",
  "Pedido entra direto na fila sem ninguém confirmar se a empresa consegue atender.",
  "Requisito legal ou normativo do setor não entra na revisão do contrato.",
  "Mudança de cliente por WhatsApp nunca vira registro formal.",
  "Reclamação pós-entrega mostra que o requisito nunca foi entendido igual.",
  "Auditor pede evidência de revisão de requisitos e só aparece e-mail solto.",
];
---

<WebinarLp
  slug="webinar-requisitos-produtos-servicos-iso9001"
  metaTitle="Webinar Gratuito — Requisitos para Produtos e Serviços (8.2) | ISO 9001:2026 | Templum"
  metaDescription="Comunicação com o cliente, revisão de requisitos e registro antes de produzir: requisito 8.2 da ISO 9001:2026. Quarta, 14 de outubro às 16h, com Daniela Albuquerque."
  eventName="Requisito 8.2 — Requisitos para Produtos e Serviços | ISO 9001:2026 — Templum Consultoria"
  requisito="Requisito 8.2"
  h1Destaque="Requisitos para Produtos"
  h1Resto="e Serviços"
  h1Sub="Comunicação, revisão de requisitos e registro antes de produzir — ISO 9001:2026."
  dataFull="Quarta, 14 de Outubro de 2026"
  dataCurta="14 Out 2026"
  dataBarra="Quarta, 14 de Outubro"
  startIso="2026-10-14T16:00:00-03:00"
  endIso="2026-10-14T17:00:00-03:00"
  desc="A maior parte do retrabalho nas empresas nasce de requisito mal captado ou mal revisado. Neste webinar prático você vai montar a lógica do requisito 8.2 da ISO 9001:2026, da conversa com o cliente até a liberação para executar, com evidência que sustenta auditoria."
  evento="webinar-requisitos-produtos-servicos-1410"
  obrigado="/obrigado-webinar-requisitos-produtos-servicos"
  topicosIntro="Um webinar 100% prático sobre requisitos de produtos e serviços — com quem certifica e audita há mais de 15 anos."
  topicos={topicos}
  sinaisTitulo="Você confirma requisitos antes de produzir ou"
  sinaisTituloEm="descobre o erro na entrega?"
  sinais={sinais}
  bio="Com mais de 15 anos dedicados à implementação e auditoria de normas ISO, Daniela já conduziu centenas de empresas à certificação em todo o Brasil. Sócia Diretora da Templum, ela já viu contrato mal revisado virar não conformidade grave e mostra como evitar isso sem travar o comercial."
  ctaTexto="Gratuito. Ao vivo no YouTube. Dia 14 de outubro às 16h. Basta se inscrever."
/>
