---
// Popup de saída nas LPs de Google Ads.
// Desktop: mouse sai pelo topo. Celular: botão voltar (não existe mouse).
// Não abre se a pessoa já começou a preencher o cadastro ou se já respondeu.
interface Props {
  norma?: string;
}
const { norma = "" } = Astro.props;
---

<div class="sx" data-sx data-norma={norma} hidden>
  <div class="sx-overlay" data-sx-overlay>
    <div class="sx-card" data-sx-card role="dialog" aria-modal="true" aria-labelledby="sx-title">
      <button type="button" class="sx-x" data-sx-close aria-label="Fechar">
        <span aria-hidden="true">×</span>
      </button>
      <p class="sx-kicker" data-sx-kicker></p>
      <div class="sx-dots" data-sx-dots aria-hidden="true"><span></span><span></span></div>
      <h2 id="sx-title" class="sx-title" data-sx-title></h2>
      <p class="sx-sub" data-sx-sub></p>
      <div class="sx-options" data-sx-options></div>
      <div class="sx-free" data-sx-free hidden>
        <label class="sx-label" for="sx-comentario">Seu motivo</label>
        <textarea id="sx-comentario" data-sx-comentario maxlength="400" rows="3" placeholder="Uma frase já basta."></textarea>
        <button type="button" class="sx-send" data-sx-send>Enviar o motivo</button>
      </div>
      <a class="sx-cta" data-sx-cta href="#form" hidden>Pedir o diagnóstico</a>
      <button type="button" class="sx-later" data-sx-later>Agora não</button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  if (window.__tplSaida) return;
  window.__tplSaida = 1;
  var root = document.querySelector("[data-sx]");
  if (!root) return;

  var MOTIVOS = {
    pesquisando: {
      label: "Ainda estou só pesquisando",
      pergunta: "O que ainda falta para você decidir?",
      fecho: "Quando a prioridade apertar, o diagnóstico mostra o caminho. Sem compromisso nessa conversa.",
      cta: false,
      detalhes: [
        ["comparar", "Quero comparar com outras consultorias"],
        ["prazo", "Quero entender o prazo até certificar"],
        ["porte", "Quero ver se serve para o porte da empresa"],
        ["estudando", "Só estou estudando a norma"]
      ]
    },
    preco: {
      label: "Queria o preço antes de cadastrar",
      pergunta: "O que você precisava ver sobre o preço?",
      fecho: "O diagnóstico não tem custo. O valor do projeto só entra na proposta, depois da conversa.",
      cta: true,
      detalhes: [
        ["faixa", "Queria uma faixa de investimento antes de falar com alguém"],
        ["caro", "Achei que ia ser caro demais"],
        ["diretoria", "Preciso levar um número para a diretoria"],
        ["outro_preco", "Preço não era o problema"]
      ]
    },
    depois: {
      label: "Não ficou claro o que acontece depois",
      pergunta: "O que ficou confuso?",
      fecho: "Quem pede o diagnóstico recebe uma conversa com um especialista. Sem contrato nessa etapa.",
      cta: true,
      detalhes: [
        ["ligacao", "Não quero que alguém me ligue agora"],
        ["tempo", "Não entendi quanto tempo leva o diagnóstico"],
        ["compromisso", "Não ficou claro se tem custo ou compromisso"],
        ["diferenca", "Não entendi o que a Templum faz de diferente"]
      ]
    },
    momento: {
      label: "Não é o momento da minha empresa",
      pergunta: "O que te fez deixar para depois?",
      fecho: "Tudo bem adiar. Quando fizer sentido, o diagnóstico continua no topo da página.",
      cta: false,
      detalhes: [
        ["prioridade", "A certificação ainda não é prioridade"],
        ["contrato", "Estou esperando um contrato ou uma licitação"],
        ["equipe", "Falta gente na equipe para tocar isso"],
        ["norma", "Queria só entender a norma, sem consultoria"]
      ]
    },
    confianca: {
      label: "Faltou confiança para deixar meus dados",
      pergunta: "O que faltou para você confiar?",
      fecho: "A garantia está em contrato: se a empresa cumprir as etapas e não certificar, devolvemos 200% do valor.",
      cta: true,
      detalhes: [
        ["cases", "Queria ver cases do meu setor"],
        ["marca", "Não conhecia a Templum"],
        ["garantia", "A garantia não ficou clara"],
        ["generico", "A página pareceu genérica demais"]
      ]
    },
    formulario: {
      label: "O formulário pediu coisa demais",
      pergunta: "O que pesou na hora de preencher?",
      fecho: "Se o formulário pesou, a gente vai enxugar. O cadastro existe para um especialista te responder.",
      cta: true,
      detalhes: [
        ["telefone", "Pediu telefone cedo demais"],
        ["campos", "Eram muitos campos"],
        ["abordagem", "Não quero ser abordado agora"],
        ["whatsapp", "Prefiro chamar no WhatsApp"]
      ]
    },
    outro: {
      label: "Outro motivo",
      pergunta: "Conta em uma frase o que te fez sair.",
      fecho: "Obrigado por escrever. Isso entra no ajuste da página.",
      cta: false,
      detalhes: []
    }
  };

  var kicker = root.querySelector("[data-sx-kicker]");
  var dots = root.querySelectorAll("[data-sx-dots] span");
  var title = root.querySelector("[data-sx-title]");
  var sub = root.querySelector("[data-sx-sub]");
  var options = root.querySelector("[data-sx-options]");
  var free = root.querySelector("[data-sx-free]");
  var comentario = root.querySelector("[data-sx-comentario]");
  var sendBtn = root.querySelector("[data-sx-send]");
  var cta = root.querySelector("[data-sx-cta]");
  var later = root.querySelector("[data-sx-later]");
  var card = root.querySelector("[data-sx-card]");
  var norma = root.getAttribute("data-norma") || "esta certificação";

  var LOCK = "tpl_saida_ate";
  var CID = "tpl_saida_cid";
  var SESSAO = "tpl_saida_viu";
  var force = /(?:\?|&)saida=1(?:&|$)/.test(location.search);
  var start = Date.now();
  var maxScroll = 0;
  var formStarted = false;
  var shown = false;
  var answered = false;
  var semMouse = window.matchMedia("(hover: none)").matches || window.matchMedia("(max-width: 820px)").matches;
  var state = { motivo: "", detalhe: "", comentario: "", gatilho: "" };

  function uuid() {
    if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
      var r = Math.random() * 16 | 0;
      return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16);
    });
  }
  function cid() {
    var id = "";
    try { id = localStorage.getItem(CID) || ""; } catch (_) {}
    if (!id) {
      id = uuid();
      try { localStorage.setItem(CID, id); } catch (_) {}
    }
    return id;
  }
  function locked() {
    if (force) return false;
    try {
      var ate = parseInt(localStorage.getItem(LOCK) || "0", 10);
      if (ate && Date.now() < ate) return true;
      if (ate && Date.now() >= ate) {
        localStorage.removeItem(LOCK);
        localStorage.removeItem(CID);
      }
      if (sessionStorage.getItem(SESSAO) === "1") return true;
    } catch (_) {}
    return false;
  }
  function lockSession() {
    try { sessionStorage.setItem(SESSAO, "1"); } catch (_) {}
  }
  function lockLong() {
    try { localStorage.setItem(LOCK, String(Date.now() + 60 * 24 * 60 * 60 * 1000)); } catch (_) {}
    lockSession();
  }
  function formDirty() {
    var nodes = document.querySelectorAll("form[data-trk-event='lead'] input, form[data-trk-event='lead'] select, form[data-trk-event='lead'] textarea");
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      if (!el.name || el.type === "hidden" || el.name === "norma") continue;
      if ((el.value || "").trim()) return true;
    }
    return false;
  }
  function leadEnviado() {
    try { if (sessionStorage.getItem("tpl_lead_pending")) return true; } catch (_) {}
    var forms = document.querySelectorAll("form[data-trk-event='lead']");
    for (var i = 0; i < forms.length; i++) {
      if (forms[i].dataset.leadSubmitted === "1") return true;
    }
    return false;
  }
  function track(name, params) {
    if (typeof window.gtag !== "function") return;
    try { window.gtag("event", name, params || {}); } catch (_) {}
  }
  function salvar() {
    var attrib = (window.__tplAttrib && window.__tplAttrib()) || {};
    var body = {
      client_id: cid(),
      pagina: location.pathname,
      norma: norma,
      motivo: state.motivo,
      detalhe: state.detalhe || "",
      comentario: (state.comentario || "").slice(0, 400),
      gatilho: state.gatilho,
      dispositivo: semMouse ? "mobile" : "desktop",
      tempo_s: Math.max(0, Math.round((Date.now() - start) / 1000)),
      rolagem_pct: maxScroll,
      form_iniciado: formStarted,
      utm_source: attrib.utm_source || "",
      utm_medium: attrib.utm_medium || "",
      utm_campaign: attrib.utm_campaign || "",
      utm_content: attrib.utm_content || "",
      utm_term: attrib.utm_term || "",
      gclid: attrib.gclid || ""
    };
    try {
      fetch("/api/saida", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        keepalive: true,
        body: JSON.stringify(body)
      }).catch(function () {});
    } catch (_) {}
  }
  function setDots(step) {
    dots.forEach(function (dot, i) {
      dot.classList.toggle("is-on", step === 2 || i < step);
    });
    root.querySelector("[data-sx-dots]").hidden = step === 0;
  }
  function clearOptions() {
    options.innerHTML = "";
    options.hidden = false;
    free.hidden = true;
  }
  function addOption(id, label, onClick) {
    var btn = document.createElement("button");
    btn.type = "button";
    btn.className = "sx-opt";
    btn.textContent = label;
    btn.addEventListener("click", function () { onClick(id, label); });
    options.appendChild(btn);
  }
  function showStep1() {
    setDots(1);
    kicker.textContent = norma;
    title.textContent = "Por que você não se cadastrou?";
    sub.textContent = "Você ia sair sem pedir o diagnóstico. Qual frase é a sua?";
    cta.hidden = true;
    later.hidden = false;
    later.textContent = "Agora não";
    clearOptions();
    Object.keys(MOTIVOS).forEach(function (id) {
      addOption(id, MOTIVOS[id].label, function () {
        state.motivo = id;
        answered = true;
        if (state.gatilho !== "preview") lockLong();
        else lockSession();
        salvar();
        track("saida_motivo", { motivo: id, page: location.pathname });
        showStep2();
      });
    });
  }
  function showThanks() {
    var item = MOTIVOS[state.motivo] || MOTIVOS.outro;
    setDots(0);
    kicker.textContent = "Anotado";
    title.textContent = "Obrigado por falar direto.";
    sub.textContent = item.fecho;
    options.hidden = true;
    free.hidden = true;
    later.hidden = false;
    later.textContent = "Fechar";
    if (item.cta) {
      cta.hidden = false;
      cta.textContent = "Pedir o diagnóstico";
      cta.classList.add("sx-cta--btn");
    } else {
      cta.hidden = false;
      cta.textContent = "Se mudar de ideia, o diagnóstico está no topo da página";
      cta.classList.remove("sx-cta--btn");
    }
  }
  function showStep2() {
    var item = MOTIVOS[state.motivo];
    if (!item) return;
    setDots(2);
    kicker.textContent = "Mais uma, e acabou";
    title.textContent = item.pergunta;
    sub.textContent = item.detalhes.length ? "Escolhe a mais próxima." : "Pode ser curto.";
    cta.hidden = true;
    later.hidden = false;
    later.textContent = "Agora não";
    clearOptions();
    if (!item.detalhes.length) {
      options.hidden = true;
      free.hidden = false;
      comentario.value = "";
      comentario.focus();
      return;
    }
    item.detalhes.forEach(function (pair) {
      addOption(pair[0], pair[1], function (id) {
        state.detalhe = id;
        salvar();
        track("saida_detalhe", { motivo: state.motivo, detalhe: id, page: location.pathname });
        showThanks();
      });
    });
  }
  function open(gatilho) {
    if (shown || locked() || formDirty() || leadEnviado()) return;
    shown = true;
    state.gatilho = gatilho;
    root.hidden = false;
    document.documentElement.style.overflow = "hidden";
    showStep1();
    track("saida_vista", { gatilho: gatilho, page: location.pathname, dispositivo: semMouse ? "mobile" : "desktop" });
    var first = options.querySelector("button");
    if (first) first.focus();
  }
  function close(motivoFecho) {
    if (root.hidden) return;
    root.hidden = true;
    document.documentElement.style.overflow = "";
    lockSession();
    if (!answered) track("saida_fechou", { etapa: "sem_resposta", page: location.pathname });
    else if (motivoFecho) track("saida_fechou", { etapa: motivoFecho, page: location.pathname });
  }

  root.querySelector("[data-sx-overlay]").addEventListener("click", function (e) {
    if (e.target === e.currentTarget) close("overlay");
  });
  root.querySelector("[data-sx-close]").addEventListener("click", function () { close("x"); });
  later.addEventListener("click", function () { close("agora_nao"); });
  sendBtn.addEventListener("click", function () {
    state.comentario = (comentario.value || "").trim();
    salvar();
    track("saida_detalhe", { motivo: state.motivo, detalhe: "texto", page: location.pathname });
    showThanks();
  });
  cta.addEventListener("click", function (e) {
    e.preventDefault();
    track("saida_volta_form", { motivo: state.motivo, page: location.pathname });
    close("cta");
    var el = document.getElementById("form") || document.getElementById("contato");
    if (el && el.scrollIntoView) el.scrollIntoView({ behavior: "smooth", block: "center" });
    var input = document.querySelector("form[data-trk-event='lead'] input[name='nome']");
    if (input) setTimeout(function () { input.focus(); }, 400);
  });
  document.addEventListener("keydown", function (e) {
    if (root.hidden) return;
    if (e.key === "Escape") { close("esc"); return; }
    if (e.key !== "Tab") return;
    var nodes = card.querySelectorAll("button, textarea, a");
    var list = [];
    for (var i = 0; i < nodes.length; i++) {
      if (nodes[i].closest("[hidden]")) continue;
      list.push(nodes[i]);
    }
    if (!list.length) return;
    var first = list[0];
    var last = list[list.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  document.addEventListener("focusin", function (e) {
    var t = e.target;
    if (t && t.closest && t.closest("form[data-trk-event='lead']")) formStarted = true;
  });
  window.addEventListener("scroll", function () {
    var h = document.documentElement.scrollHeight - window.innerHeight;
    if (h <= 0) return;
    var pct = Math.round((window.scrollY / h) * 100);
    if (pct > maxScroll) maxScroll = Math.min(100, pct);
  }, { passive: true });

  if (force) {
    setTimeout(function () { open("preview"); }, 700);
  } else if (!semMouse) {
    setTimeout(function () {
      document.documentElement.addEventListener("mouseleave", function (e) {
        if (e.clientY > 0) return;
        open("mouse");
      });
    }, 3000);
  } else if (!locked()) {
    var backArm = false;
    setTimeout(function () { backArm = true; }, 1500);
    try { history.pushState({ tplSaida: 1 }, "", location.href); } catch (_) {}
    window.addEventListener("popstate", function () {
      if (shown || locked() || formDirty() || leadEnviado() || !backArm) return;
      try { history.pushState({ tplSaida: 1 }, "", location.href); } catch (_) {}
      open("voltar");
    });
  }
})();
</script>

<style is:global>
  .sx[hidden] { display: none !important; }
  .sx-overlay {
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: rgba(24, 25, 27, 0.62);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .sx-card {
    position: relative;
    width: min(480px, 100%);
    max-height: min(92vh, 760px);
    overflow: auto;
    background: #fff;
    color: var(--text, #18191b);
    border-radius: 28px;
    padding: 28px 24px 20px;
    box-shadow: 0 28px 56px -16px rgba(24, 25, 27, 0.28);
    font-family: var(--font-sans, Montserrat, sans-serif);
  }
  .sx-x {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: var(--cream, #fff4dd);
    color: var(--navy, #222831);
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
  }
  .sx-x:hover { background: #ffe7c2; }
  .sx-kicker {
    margin: 0 36px 8px 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--orange-ink, #b23c0c);
  }
  .sx-dots { display: flex; gap: 6px; margin-bottom: 12px; }
  .sx-dots[hidden] { display: none; }
  .sx-dots span {
    width: 22px;
    height: 4px;
    border-radius: 99px;
    background: rgba(24, 25, 27, 0.12);
  }
  .sx-dots span.is-on { background: var(--orange, #ff5925); }
  .sx-title {
    margin: 0 8px 8px 0;
    font-size: clamp(22px, 4vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 800;
    color: var(--navy, #222831);
  }
  .sx-sub {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--text-2, #3f424b);
  }
  .sx-options { display: flex; flex-direction: column; gap: 8px; }
  .sx-options[hidden] { display: none; }
  .sx-opt {
    width: 100%;
    text-align: left;
    border: 1.5px solid rgba(24, 25, 27, 0.12);
    background: #fff;
    color: var(--navy, #222831);
    border-radius: 14px;
    min-height: 48px;
    padding: 12px 14px;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    cursor: pointer;
  }
  .sx-opt:hover, .sx-opt:focus-visible {
    border-color: var(--orange, #ff5925);
    background: var(--cream, #fff4dd);
    outline: none;
  }
  .sx-free { display: flex; flex-direction: column; gap: 10px; }
  .sx-free[hidden] { display: none; }
  .sx-label { font-size: 13px; font-weight: 700; color: var(--navy, #222831); }
  .sx-free textarea {
    width: 100%;
    border: 1.5px solid rgba(24, 25, 27, 0.16);
    border-radius: 14px;
    padding: 12px 14px;
    font: inherit;
    font-size: 15px;
    resize: vertical;
    color: var(--navy, #222831);
  }
  .sx-free textarea:focus { outline: 2px solid var(--orange, #ff5925); border-color: transparent; }
  .sx-send, .sx-cta--btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 0;
    border-radius: 999px;
    background: var(--orange, #ff5925);
    color: #fff;
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    cursor: pointer;
    padding: 0 18px;
  }
  .sx-cta {
    display: inline-block;
    margin-top: 4px;
    color: var(--orange-ink, #b23c0c);
    font-weight: 700;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sx-cta[hidden] { display: none !important; }
  .sx-later {
    display: block;
    width: 100%;
    margin-top: 12px;
    border: 0;
    background: transparent;
    color: var(--text-mid, rgba(24, 25, 27, 0.62));
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    min-height: 40px;
  }
  .sx-later:hover { color: var(--navy, #222831); }
  @media (max-width: 720px) {
    .sx-overlay { align-items: flex-end; padding: 0; }
    .sx-card {
      width: 100%;
      border-radius: 24px 24px 0 0;
      padding: 22px 18px calc(16px + env(safe-area-inset-bottom));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sx-card { scroll-behavior: auto; }
  }
</style>
