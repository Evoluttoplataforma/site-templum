---
const { href = "" } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag href={href || undefined} class="gia-lockup">
  <img src="/assets/logo/templum.png" alt="Templum Consultoria" class="gia-logo-templum" width="389" height="129" />
  <span class="gia-plus" aria-hidden="true">+</span>
  <span class="gia-lsc-wrap">
    <img src="/assets/logo/lsc-one.png?v=2" alt="LSC One" class="gia-logo-lsc" width="320" height="96" />
  </span>
</Tag>
