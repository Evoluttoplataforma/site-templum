---
// Formulário de lead reutilizável (ilha clara — funciona em seção navy ou clara).
// - Passe `norma` (nome da norma) p/ páginas específicas → vai oculto no envio.
// - Sem `norma` → mostra o seletor de norma (ex.: home).
// Campos de qualificação (cargo, urgência, nº de funcionários) vão no webhook
// e no Mailchimp. O envio é tratado pelo handler global do Base.astro: dispara
// conversão (pixels + CAPI), grava no Mailchimp/webhook e redireciona p/ /obrigado.
import { normas } from "../data/normas.js";
import { WHATSAPP_LP_ENABLED, WHATSAPP_LP_NUMBER } from "../data/whatsapp-lp.js";
const {
  norma = "",
  titulo = "Fale com um especialista",
  sub = "Resposta em até 1 dia útil. Sem compromisso.",
  cta = "Quero meu diagnóstico gratuito",
  obrigado = "",   // ex: "/consultoria/iso-9001-obrigado" — sobrescreve o /obrigado padrão
  simples = false, // true → oculta nº funcionários, cargo e urgência
  faturamento = false, // true → mostra faturamento mensal (qualificação p/ PCI, mín. R$ 100 mil/mês)
  faturamentoObrigatorio = false, // true → torna o faturamento obrigatório (campanhas que otimizam por faixa)
  faixaMensal = false, // true → faixa de faturamento mensal visível e obrigatória, antes do toggle (não mistura com o seletor mensal padrão)
  labelEmpresa = "Empresa", // sobrescreve o rótulo do campo "empresa" (ex.: "Nome da Construtora")
  cargo = false, // true → mostra o campo "Seu cargo" mesmo com simples={true}
  funcionarios = false, // true → mostra "Nº de funcionários" mesmo com simples={true}
  colapsavel = false, // true → empresa, urgência e norma atrás do toggle
  qualificaAntes = false, // true → nº de funcionários e cargo visíveis e obrigatórios, antes do toggle
  whatsapp = false, // true → link abaixo do botão; no celular, também o botão fixo
  whatsappNorma = "", // nome gravado no rastreio; se vazio, usa `norma`
  whatsappLinha = "", // 1ª linha da mensagem; se vazio, monta com o nome da norma
  whatsappFixo = false, // true → um botão fixo no rodapé do celular (uma vez por página)
} = Astro.props;
const mostraWpp = Boolean(whatsapp) && WHATSAPP_LP_ENABLED && Boolean(WHATSAPP_LP_NUMBER);
const wppNorma = String(whatsappNorma || norma || "").replace(/\s+/g, " ").trim();
const wppLinha = String(whatsappLinha || "").replace(/\s+/g, " ").trim()
  || (wppNorma
    ? `Olá! Vim pelo site da Templum e quero saber sobre ${wppNorma}.`
    : "Olá! Vim pelo site da Templum.");
const wppHref = `https://wa.me/${WHATSAPP_LP_NUMBER}?text=${encodeURIComponent(wppLinha)}`;
const cargos = ["Proprietário", "Diretor / C-level", "Consultor", "Funcionário buscando informações", "Só estou curioso"];
const urgencias = ["Preciso certificar rápido", "Estou sem pressa para certificar", "Preciso para minha carreira", "Sou apenas estudante"];
// Com funcionários E faturamento juntos, a .form-row (1fr 1fr) ficaria com 3
// filhos e sobraria um buraco — nesse caso a empresa vai em linha própria.
const mostraFunc = (!simples || funcionarios) && !qualificaAntes;
const mostraFat = faturamento && !faixaMensal;
const parQualif = mostraFunc && mostraFat;
// Quantos campos a 2ª linha realmente rende: se sobrar só um, a grade de 2
// colunas deixaria metade da linha vazia — daí o modificador --solo.
const camposLinha2 = (parQualif ? 0 : 1) + (mostraFunc ? 1 : 0) + (mostraFat ? 1 : 0);
const mostraCargoPainel = (!simples || cargo) && !qualificaAntes;
const faixasFuncionarios = ["1 a 10", "11 a 50", "51 a 100", "101 a 250", "251 a 500", "Mais de 500"];
const faturamentos = ["Até R$ 50 mil", "R$ 50 mil a R$ 100 mil", "R$ 100 mil a R$ 300 mil", "R$ 300 mil a R$ 500 mil", "R$ 500 mil a R$ 1 milhão", "Acima de R$ 1 milhão"];
const faixasFaturamentoMensal = ["Até R$ 100 mil", "De R$ 100 mil a R$ 500 mil", "De R$ 500 mil a R$ 1 milhão", "De R$ 1 milhão a R$ 5 milhões", "Acima de R$ 5 milhões"];
const empresaPlaceholder = labelEmpresa === "Empresa" ? "Nome da empresa" : labelEmpresa;
---

<div class="lead-card" data-lead-colapsavel={colapsavel ? "1" : undefined}>
  <div class="lead-title">{titulo}</div>
  <p class="lead-sub">{sub}</p>
  <form class="form" data-trk-event="lead" novalidate data-obrigado={obrigado || undefined}>
    {norma && <input type="hidden" name="norma" value={norma} />}
    <div class="form-row">
      <div class="field"><label>Nome</label><input class="input" name="nome" placeholder="Seu nome" required /></div>
      <div class="field"><label>Telefone / WhatsApp</label><input class="input" type="tel" inputmode="numeric" name="telefone" placeholder="(00) 00000-0000" required /></div>
    </div>
    <div class="field"><label>E-mail</label><input class="input" type="email" name="email" placeholder="voce@empresa.com" required /></div>

    {qualificaAntes && (
      <div class="form-row">
        <div class="field">
          <label>Nº de funcionários</label>
          <select class="select" name="funcionarios" aria-label="Nº de funcionários" required>
            <option value="">Selecione</option>
            {faixasFuncionarios.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>
        <div class="field">
          <label>Seu cargo</label>
          <select class="select" name="cargo" aria-label="Seu cargo" required>
            <option value="">Selecione</option>
            {cargos.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
      </div>
    )}

    {faixaMensal && (
      <div class="field">
        <label>Qual é o faturamento mensal aproximado da sua empresa?</label>
        <select class="select" name="faturamento" aria-label="Qual é o faturamento mensal aproximado da sua empresa?" required>
          <option value="">Selecione</option>
          {faixasFaturamentoMensal.map((f) => <option value={f}>{f}</option>)}
        </select>
      </div>
    )}

    {colapsavel && (
      <button
        type="button"
        class="lead-more-toggle"
        aria-expanded="false"
        data-lead-more-toggle
      >
        <span class="lead-more-toggle__text">Quer adiantar o diagnóstico? Preencha os campos abaixo.</span>
        <iconify-icon icon="solar:alt-arrow-down-linear" class="lead-more-toggle__icon" aria-hidden="true"></iconify-icon>
      </button>
    )}

    <div class="lead-more" data-lead-more hidden={colapsavel || undefined}>
      {parQualif && (
        <div class="field"><label>{labelEmpresa}</label><input class="input" name="empresa" placeholder={empresaPlaceholder} /></div>
      )}
      <div class={camposLinha2 === 1 ? "form-row form-row--solo" : "form-row"}>
        {!parQualif && (
          <div class="field"><label>{labelEmpresa}</label><input class="input" name="empresa" placeholder={empresaPlaceholder} /></div>
        )}
        {mostraFunc && (
          <div class="field">
            <label>Nº de funcionários</label>
            <select class="select" name="funcionarios" aria-label="Nº de funcionários">
              <option value="">Selecione</option>
              {faixasFuncionarios.map((f) => <option value={f}>{f}</option>)}
            </select>
          </div>
        )}
        {mostraFat && (
          <div class="field">
            <label>Faturamento mensal</label>
            <select class="select" name="faturamento" aria-label="Faturamento mensal" required={faturamentoObrigatorio || undefined}>
              <option value="">Selecione</option>
              {faturamentos.map((f) => <option value={f}>{f}</option>)}
            </select>
          </div>
        )}
      </div>
      {(mostraCargoPainel || !simples) && (
        <div class={mostraCargoPainel && !simples ? "form-row" : "form-row form-row--solo"}>
          {mostraCargoPainel && (
            <div class="field">
              <label>Seu cargo</label>
              <select class="select" name="cargo" aria-label="Seu cargo">
                <option value="">Selecione</option>
                {cargos.map((c) => <option value={c}>{c}</option>)}
              </select>
            </div>
          )}
          {!simples && (
            <div class="field">
              <label>Qual sua urgência?</label>
              <select class="select" name="urgencia" aria-label="Qual sua urgência?">
                <option value="">Selecione</option>
                {urgencias.map((u) => <option value={u}>{u}</option>)}
              </select>
            </div>
          )}
        </div>
      )}
      {!norma && (
        <div class="field">
          <label>Qual norma você busca?</label>
          <select class="select" name="norma" aria-label="Qual norma você busca?">
            <option value="">Selecione (ou não sei ainda)</option>
            {normas.map((n) => <option value={n.nome}>{n.nome}: {n.categoria}</option>)}
            <option value="Outra / não sei ainda">Outra / não sei ainda</option>
          </select>
        </div>
      )}
    </div>

    <button type="submit" class="btn btn--primary btn--block btn--lg">{cta} <iconify-icon icon="solar:arrow-right-linear"></iconify-icon></button>
    {mostraWpp && (
      <a
        class="lead-wpp"
        href={wppHref}
        target="_blank"
        rel="noopener"
        data-wpp-ref="1"
        data-wpp-norma={wppNorma || undefined}
        data-wpp-linha={wppLinha}
      >Prefere conversar pelo WhatsApp?</a>
    )}
    <p class="lead-legal">Ao enviar, você concorda em ser contatado pela Templum. Seus dados estão protegidos conforme a LGPD.</p>
  </form>
</div>
{mostraWpp && whatsappFixo && (
  <a
    class="lead-wpp-fixo"
    href={wppHref}
    target="_blank"
    rel="noopener"
    data-wpp-ref="1"
    data-wpp-fixo="1"
    data-wpp-norma={wppNorma || undefined}
    data-wpp-linha={wppLinha}
  ><iconify-icon icon="ic:baseline-whatsapp" aria-hidden="true"></iconify-icon>Falar no WhatsApp</a>
)}

{colapsavel && (
  <script>
    document.querySelectorAll("[data-lead-colapsavel='1']").forEach(function (card) {
      if (card.dataset.leadMoreBound) return;
      card.dataset.leadMoreBound = "1";
      var toggle = card.querySelector("[data-lead-more-toggle]");
      var panel = card.querySelector("[data-lead-more]");
      if (!toggle || !panel) return;
      toggle.addEventListener("click", function () {
        var open = toggle.getAttribute("aria-expanded") === "true";
        var next = !open;
        toggle.setAttribute("aria-expanded", next ? "true" : "false");
        panel.hidden = !next;
        toggle.classList.toggle("is-open", next);
      });
    });
  </script>
)}

<style>
  /* cargo sozinho na linha (LPs com simples={true}): sem a urgência ao lado, a
     grade 1fr 1fr deixaria metade da linha vazia. */
  .form-row--solo { grid-template-columns: 1fr; }
  .lead-legal { font-size: 11.5px; color: var(--text-soft); line-height: 1.5; margin-top: 2px; }

  .lead-wpp {
    display: block;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-mid);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lead-wpp:hover { color: var(--text-2); }

  .lead-wpp-fixo {
    display: none;
  }
  @media (max-width: 767px) {
    .lead-wpp-fixo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(8px + env(safe-area-inset-bottom, 0px));
      z-index: 90;
      min-height: 48px;
      padding: 12px 16px;
      border-radius: 12px;
      background: #128C7E;
      color: #fff;
      font-size: 16px;
      font-weight: 700;
      line-height: 1.2;
      text-decoration: none;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
      transition: transform .25s ease, opacity .25s ease;
    }
    .lead-wpp-fixo iconify-icon { font-size: 22px; flex-shrink: 0; }
    .lead-wpp-fixo.is-clear {
      transform: translateY(140%);
      opacity: 0;
      pointer-events: none;
    }
    :global(body.tpl-wpp-on) {
      padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }
  }

  .lead-more {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .lead-more[hidden] { display: none; }

  .lead-more-toggle {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    color: var(--text-mid);
  }
  .lead-more-toggle__text {
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-2);
  }
  .lead-more-toggle__icon {
    flex-shrink: 0;
    font-size: 18px;
    color: var(--orange);
    margin-top: 1px;
    transition: transform .2s var(--ease-soft, ease);
  }
  .lead-more-toggle.is-open .lead-more-toggle__icon {
    transform: rotate(180deg);
  }
  .lead-more-toggle:hover .lead-more-toggle__text {
    color: var(--orange);
  }
  .lead-more-toggle:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
    border-radius: 6px;
  }
</style>

{mostraWpp && whatsappFixo && (
  <script is:inline>
    (function () {
      var barras = document.querySelectorAll("[data-wpp-fixo]");
      for (var i = 1; i < barras.length; i++) barras[i].remove();
      var bar = document.querySelector("[data-wpp-fixo]");
      if (!bar || bar.dataset.wppFixoBound) return;
      bar.dataset.wppFixoBound = "1";
      if (bar.parentElement !== document.body) document.body.appendChild(bar);

      var mq = window.matchMedia("(max-width: 767px)");
      var agendado = false;
      var inset = 0;

      function medirInset() {
        var probe = document.createElement("div");
        probe.style.cssText = "position:fixed;bottom:0;width:0;height:env(safe-area-inset-bottom,0px);pointer-events:none;visibility:hidden;";
        document.body.appendChild(probe);
        var n = probe.offsetHeight || 0;
        probe.remove();
        return n;
      }

      function zona() {
        var vv = window.visualViewport;
        var top = vv ? vv.offsetTop : 0;
        var bottom = top + (vv ? vv.height : window.innerHeight);
        var altura = bar.offsetHeight || 48;
        var barBottom = bottom - inset - 8;
        var barTop = barBottom - altura;
        return { top: top, bottom: bottom, barTop: barTop, barBottom: barBottom };
      }

      function cobreFormulario() {
        var ativo = document.activeElement;
        if (ativo && ativo.closest && ativo.closest(".lead-card")) return true;
        var z = zona();
        var cards = document.querySelectorAll(".lead-card");
        for (var c = 0; c < cards.length; c++) {
          var r = cards[c].getBoundingClientRect();
          if (r.top < z.barBottom && r.bottom > z.barTop) return true;
        }
        return false;
      }

      function atualizar() {
        var mobile = mq.matches;
        document.body.classList.toggle("tpl-wpp-on", mobile);
        if (!mobile) {
          bar.classList.remove("is-clear");
          bar.removeAttribute("aria-hidden");
          return;
        }
        var cobre = cobreFormulario();
        bar.classList.toggle("is-clear", cobre);
        if (cobre) bar.setAttribute("aria-hidden", "true");
        else bar.removeAttribute("aria-hidden");
      }

      function pedir() {
        if (agendado) return;
        agendado = true;
        requestAnimationFrame(function () {
          agendado = false;
          atualizar();
        });
      }

      inset = medirInset();
      atualizar();
      window.addEventListener("scroll", pedir, { passive: true });
      window.addEventListener("resize", function () { inset = medirInset(); pedir(); });
      document.addEventListener("focusin", pedir);
      document.addEventListener("focusout", pedir);
      if (window.visualViewport) {
        window.visualViewport.addEventListener("resize", function () { inset = medirInset(); pedir(); });
        window.visualViewport.addEventListener("scroll", pedir);
      }
      if (mq.addEventListener) mq.addEventListener("change", pedir);
      else if (mq.addListener) mq.addListener(pedir);
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", atualizar);
      }
    })();
  </script>
)}
