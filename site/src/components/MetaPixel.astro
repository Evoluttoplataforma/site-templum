---
// Código base OFICIAL do Meta Pixel — único lugar do projeto que faz
// fbq('init', ...) + fbq('track','PageView').
//
// O STUB e a FILA são síncronos (init + PageView entram na fila no momento do
// carregamento, preservando ordem e sessão); o que ficou adiado é só o DOWNLOAD do
// fbevents.js, disparado por __loadMetaPixel() no mesmo boot que já adia GA4/Ads/
// Clarity/tracking-kit (Base.astro e LpBase.astro). Motivo, medido em 10/09/2026:
// eram 265 KiB e 365 ms de thread principal no caminho crítico da home. A coleta não
// muda — quando o fbevents.js chega, ele drena a fila e envia init + PageView.
//
// As 2 contas Meta configuradas no projeto. Os MESMOS IDs são usados no
// disparo do Lead (Base.astro/LpBase.astro) — mantenha os dois em sincronia.
---
<script is:inline>
  // stub oficial, SEM o insertBefore do script — a fila (n.queue) já existe aqui
  !function(f,b,e,v,n,t,s){
    if (f.fbq) return;
    n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); };
    if (!f._fbq) f._fbq = n;
    n.push = n; n.loaded = true; n.version = "2.0"; n.queue = [];
  }(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
  fbq("init", "1265191353683807");
  fbq("init", "4177249519256900");
  fbq("track", "PageView");

  // Baixa o fbevents.js. Chamado pelo boot do layout (1º gesto do usuário ou ocioso
  // pós-load) e, como rede de segurança, no máximo 6 s depois do load — assim nenhuma
  // sessão fica sem PageView, nem a de quem não interage.
  window.__loadMetaPixel = function () {
    if (window.__metaPixelLoaded) return; window.__metaPixelLoaded = true;
    var t = document.createElement("script");
    t.async = true; t.src = "https://connect.facebook.net/en_US/fbevents.js";
    var s = document.getElementsByTagName("script")[0];
    if (s && s.parentNode) s.parentNode.insertBefore(t, s);
    else (document.head || document.documentElement).appendChild(t);
  };
  window.addEventListener("load", function () { setTimeout(window.__loadMetaPixel, 6000); }, { once: true });
</script>
